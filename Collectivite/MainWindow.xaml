                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Bénéficiaires" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button  Style="{StaticResource MenuButtonStyle}" Click="ACTEURS_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSupervisor" 
