<Window x:Class="Collectivite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Collectivite.Utils"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="800" 
        Width="1400"
        Unloaded="Window_Unloaded"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Converter pour les permissions -->
        <local:PermissionToVisibilityConverter x:Key="PermissionToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Style pour les boutons de menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les boutons de menu en mode réduit (icônes seulement) -->
        <Style x:Key="MenuButtonCollapsedStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les en-têtes de section du menu -->
        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="20,15,0,5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR FIXE AVEC ANIMATION -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"
                HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="280"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                        To="70" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" 
                                                        To="280" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <DockPanel>
                <!-- Header de la sidebar avec bouton toggle -->
                <Border DockPanel.Dock="Top" 
                       Background="{DynamicResource PrimaryHueMidBrush}"
                       Padding="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="180"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                    <Setter Property="Height" Value="70"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <Grid>
                        <!-- Bouton Toggle en haut -->
                        <Button Command="{Binding ToggleMenuCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="36" Height="36"
                                Foreground="#424242"
                                ToolTip="Réduire/Agrandir le menu">
                            <materialDesign:PackIcon Width="24" Height="24">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronLeft"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                                <Setter Property="Kind" Value="ChevronRight"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        
                        <!-- Contenu du header (visible en mode étendu) -->
                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}">
                            <materialDesign:PackIcon Kind="CityVariant" 
                                                   Width="50" 
                                                   Height="50"
                                                   Foreground="Green"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Gestion Budgetaire"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Foreground="Black"
                                     TextAlignment="Center"
                                     Margin="0,10,0,0"/>
                            <TextBlock Text="et Comptable"
                                     FontSize="12"
                                     Foreground="Black"
                                     TextAlignment="Center"
                                     Opacity="0.9"/>
                        </StackPanel>
                        
                        <!-- Icône seule (visible en mode réduit) -->
                        <materialDesign:PackIcon Kind="CityVariant" 
                                               Width="40" Height="40"
                                               Foreground="Green"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsMenuCollapsed, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Menu de navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,20">
                        <!-- Tableau de bord -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="DashboardButton_Click"
                               Tag="Dashboard"
                               ToolTip="Tableau de bord">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Tableau de bord" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.IsMenuExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Configuration -->
                        <!-- Expander visible en mode étendu -->
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                  HorizontalAlignment="Left"
                                  Width="250"
                                  Margin="10,10,0,10"
                                  Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Settings" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Paramétrage" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                         Click="CommuneButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarker" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Commune" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="NommenclatureButton_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Nommenclature" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                    Click="CompteComptable_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Plan comptables" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                    Click="ExerciceButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarRange" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Exercice" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </Expander>
                        
                        <!-- Bouton Paramétrage en mode réduit avec ContextMenu -->
                        <Button Style="{StaticResource MenuButtonCollapsedStyle}"
                                ToolTip="Paramétrage"
                                Visibility="{Binding IsMenuCollapsed, Converter={StaticResource BoolToVisibility}}"
                                Margin="10,5"
                                Click="OpenContextMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Commune" Click="CommuneButton_Click"/>
                                    <MenuItem Header="Nomenclature" Click="NommenclatureButton_Click"/>
                                    <MenuItem Header="Plan comptables" Click="CompteComptable_Click"/>
                                    <MenuItem Header="Exercice" Click="ExerciceButton_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <materialDesign:PackIcon Kind="Settings" Width="22" Height="22"/>
                        </Button>
                        <!-- Section Configuration FIN -->

                        <!-- Section Gestion Budgétaire -->
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                      HorizontalAlignment="Left"
                                      Width="250"
                                      Margin="10,10,0,10"
                                      Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashEdit" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,10,0"
                                           Foreground="Black"/>
                                    <TextBlock Text="Gestion Budgétaire" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                 <!-- Budge Preparatoire debut-->
                                <Expander Style="{StaticResource MaterialDesignExpander}" 
                                                  HorizontalAlignment="Left"
                                                  Width="230"
                                                  Margin="0,5,0,5">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashCheck" 
                                                   VerticalAlignment="Center"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,10,0"
                                                   Foreground="Black"/>
                                            <TextBlock Text="Budget Préparatoire" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Orientation="Vertical" Margin="18,0,0,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                                <Setter Property="Foreground" Value="#424242"/>
                                            </Style>
                                        </StackPanel.Resources>

                                        <Button x:Name="BtnSaisie" Style="{StaticResource MenuButtonStyle}" Click="BtnSaisie_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                   VerticalAlignment="Center"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,15,0"/>
                                                <TextBlock Text="Saisie" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button  Style="{StaticResource MenuButtonStyle}" Click="Sythese_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDocument" 
                                                    VerticalAlignment="Center"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="0,0,15,0"/>
                                                <TextBlock Text="Synthèse" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Expander>
                                <!-- Budge Preparatoire fin-->

                                <Button x:Name="BtnBudgetPrimitif" Style="{StaticResource MenuButtonStyle}"  Click="BtnBudgetPrimitif_Click"> 
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocument" 
                                                VerticalAlignment="Center"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,15,0"/>
                                        <TextBlock Text="Budget Primitif" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="RemaniementButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Budget Remanié" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                        Click="CompteAdministratif_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileChart" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte Administratif" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Expander>
                        
                        <!-- Bouton Gestion Budgétaire en mode réduit avec ContextMenu -->
                        <Button Style="{StaticResource MenuButtonCollapsedStyle}"
                                ToolTip="Gestion Budgétaire"
                                Visibility="{Binding IsMenuCollapsed, Converter={StaticResource BoolToVisibility}}"
                                Margin="10,5"
                                Click="OpenContextMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Saisie Prévisions" Click="BtnSaisie_Click"/>
                                    <MenuItem Header="Synthèse" Click="Sythese_Click"/>
                                    <MenuItem Header="Budget Primitif" Click="BtnBudgetPrimitif_Click"/>
                                    <MenuItem Header="Budget Remanié" Click="RemaniementButton_Click"/>
                                    <MenuItem Header="Compte Administratif" Click="CompteAdministratif_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <materialDesign:PackIcon Kind="CashEdit" Width="22" Height="22"/>
                        </Button>
                        <!-- Section Gestion Budgétaire Fin -->
                        
                        <!-- Section Gestion Compte Bancaire et Tiers -->
                        <TextBlock Text="Compte Bancaire et Tiers" Style="{StaticResource MenuHeaderStyle}"
                                   Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Click="TiersButton_Click" ToolTip="Gestion des Tiers">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" 
                                 VerticalAlignment="Center"
                                 Width="22"
                                 Height="22"
                                 Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Tiers" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.IsMenuExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>

                        <!-- <Button Style="{StaticResource MenuButtonStyle}" Click="CompteBancaireButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bank" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Compte Bancaire" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button> -->


                        <Button Style="{StaticResource MenuButtonStyle}" Click="RecensementButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Recensements" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Saisie des Pièces debut -->
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                              HorizontalAlignment="Left"
                                  Width="250"
                              Margin="10,10,0,10"
                              Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderEditOutline" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Saisie des Pièces" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="ExpressionBesoin_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Expression Besoin" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Style="{StaticResource MenuButtonStyle}" Click="BonCommande_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CartOutline" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Bon de Commande" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FactureButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Facture et Détails" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="Contrat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSign" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Contrat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FicheEngagement_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardCheckOutline" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Fiche d'Engagement" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                               <Button Style="{StaticResource MenuButtonStyle}" Click="Mandat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashCheck" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Mandat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="OrdreRecette_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashPlus" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Ordre de Recette" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Content="Validation"
                                    Command="{Binding NavigateToValidationCommand}" Click="Validation_Click"
                                    Visibility="{Binding Converter={StaticResource PermissionToVisibilityConverter}, ConverterParameter=Validation.Access}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckDecagram" Margin="0,0,8,0"/>
                                                <TextBlock Text="Validation"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                
                            </StackPanel>
                        </Expander>
                        
                        <!-- Bouton Saisie des Pièces en mode réduit avec ContextMenu -->
                        <Button Style="{StaticResource MenuButtonCollapsedStyle}"
                                ToolTip="Saisie des Pièces"
                                Visibility="{Binding IsMenuCollapsed, Converter={StaticResource BoolToVisibility}}"
                                Margin="10,5"
                                Click="OpenContextMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Expression Besoin" Click="ExpressionBesoin_Click"/>
                                    <MenuItem Header="Bon de Commande" Click="BonCommande_Click"/>
                                    <MenuItem Header="Facture et Détails" Click="FactureButton_Click"/>
                                    <MenuItem Header="Contrat" Click="Contrat_Click"/>
                                    <MenuItem Header="Fiche d'Engagement" Click="FicheEngagement_Click"/>
                                    <MenuItem Header="Mandat" Click="Mandat_Click"/>
                                    <MenuItem Header="Ordre de Recette" Click="OrdreRecette_Click"/>
                                    <MenuItem Header="Validation" Click="Validation_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <materialDesign:PackIcon Kind="FolderEditOutline" Width="22" Height="22"/>
                        </Button>
                        <!-- Section Saisie des Pièces Fin -->

                        <!-- Section Gestion Comptable debut-->

                        <StackPanel Visibility="{Binding Converter={StaticResource PermissionToVisibilityConverter}, ConverterParameter=GestionComptable.Access}">

                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                          HorizontalAlignment="Left"
                                          Width="250"
                                          Margin="10,10,0,10"
                                          Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" 
                                        VerticalAlignment="Center"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Foreground="Black"/>
                                    <TextBlock Text="Gestion Comptable" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="CompteGestion_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookAccount" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte de Gestion" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="LivreJournalButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="NotebookOutline" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Livre Journal" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="GrandLivreButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpenVariant" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Grand Livre" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                
                                
                                <!-- BALANCE debut-->
                                <Expander Style="{StaticResource MaterialDesignExpander}" 
                                          HorizontalAlignment="Left"
                                          Width="230"
                                          Margin="0,5,0,5">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ScaleBalance" 
                                           VerticalAlignment="Center"
