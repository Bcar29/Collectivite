<Window x:Class="Collectivite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Collectivite.Utils"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="800" 
        Width="1400"
        Unloaded="Window_Unloaded"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Converter pour les permissions -->
        <local:PermissionToVisibilityConverter x:Key="PermissionToVisibilityConverter"/>

        <!-- Style pour les boutons de menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les en-têtes de section du menu -->
        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="20,15,0,5"/>

        </Style>


        <!-- Style pour les Expander de section du menu -->


    </Window.Resources>

    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsMenuOpen}">
        <!-- Sidebar (Drawer gauche) -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="280" Background="White">
                <!-- Header de la sidebar -->
                <Border DockPanel.Dock="Top" 
                       Background="{DynamicResource PrimaryHueMidBrush}"
                       Height="180"
                       Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CityVariant" 
                                               Width="60" 
                                               Height="60"
                                               Foreground="Green"
                                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Plateforme de Gestion Budgetaire "
                                 FontSize="15"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Margin="0,15,0,0"/>
                        <TextBlock Text="et Comptable des Collectivités"
                                 FontSize="15"
                                   FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Opacity="0.9"
                                 Margin="0,5,0,0"/>
                        <TextBlock Text="Locales"
                                 FontSize="15"
                                   FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Opacity="0.9"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menu de navigation -->
                <ScrollViewer DockPanel.Dock="Top" 
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,20">
                        <!-- Tableau de bord -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="DashboardButton_Click"
                               Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Configuration -->
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                  HorizontalAlignment="Left"
                                  Width="250"
                                  Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Settings" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Paramétrage" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                         Click="CommuneButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarker" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Commune" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="NommenclatureButton_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Nommenclature" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                    Click="CompteComptable_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Plan comptables" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                    Click="ExerciceButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarRange" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Exercice" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </Expander>
                        <!-- Section Configuration FIN -->

                        <!-- Section Gestion Budgétaire -->

                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                      HorizontalAlignment="Left"
                                      Width="250"
                                      Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashEdit" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,10,0"
                                           Foreground="Black"/>
                                    <TextBlock Text="Gestion Budgétaire" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                 <!-- Budge Preparatoire debut-->
                                <Expander Style="{StaticResource MaterialDesignExpander}" 
                                                  HorizontalAlignment="Left"
                                                  Width="230"
                                                  Margin="0,5,0,5">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashCheck" 
                                                   VerticalAlignment="Center"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,10,0"
                                                   Foreground="Black"/>
                                            <TextBlock Text="Budget Préparatoire" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Orientation="Vertical" Margin="18,0,0,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                                <Setter Property="Foreground" Value="#424242"/>
                                            </Style>
                                        </StackPanel.Resources>

                                        <Button x:Name="BtnSaisie" Style="{StaticResource MenuButtonStyle}" Click="BtnSaisie_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                   VerticalAlignment="Center"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,15,0"/>
                                                <TextBlock Text="Saisie" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button  Style="{StaticResource MenuButtonStyle}" Click="Sythese_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDocument" 
                                                    VerticalAlignment="Center"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="0,0,15,0"/>
                                                <TextBlock Text="Synthèse" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Expander>
                                <!-- Budge Preparatoire fin-->

                                <Button x:Name="BtnBudgetPrimitif" Style="{StaticResource MenuButtonStyle}"  Click="BtnBudgetPrimitif_Click"> 
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocument" 
                                                VerticalAlignment="Center"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,15,0"/>
                                        <TextBlock Text="Budget Primitif" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="RemaniementButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Budget Remanié" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                        Click="CompteAdministratif_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileChart" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte Administratif" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Expander>
                        
                        <!-- Section Gestion Budgétaire Fin -->
                        <!-- Section Gestion Compte Bancaire et Tiers -->
                        <TextBlock Text="Compte Bancaire et Tiers" Style="{StaticResource MenuHeaderStyle}"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Click="TiersButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" 
                                 VerticalAlignment="Center"
                                 Width="22"
                                 Height="22"
                                 Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Tiers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- <Button Style="{StaticResource MenuButtonStyle}" Click="CompteBancaireButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bank" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Compte Bancaire" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button> -->


                        <Button Style="{StaticResource MenuButtonStyle}" Click="RecensementButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Recensements" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Saisie des Pièces debut -->



                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                              HorizontalAlignment="Left"
                                  Width="250"
                              Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Saisie des Pièces" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="ExpressionBesoin_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Expression Besoin" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Style="{StaticResource MenuButtonStyle}" Click="BonCommande_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Bon de Commande" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FactureButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardText" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Facture et Détails" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="Contrat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSign" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Contrat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FicheEngagement_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardText" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Fiche d'Engagement" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                               <Button Style="{StaticResource MenuButtonStyle}" Click="Mandat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashCheck" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Mandat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="OrdreRecette_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Receipt" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Ordre de Recette" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Content="Validation"
                                    Command="{Binding NavigateToValidationCommand}" Click="Validation_Click"
                                    Visibility="{Binding Converter={StaticResource PermissionToVisibilityConverter}, ConverterParameter=Validation.Access}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ShieldCheck" Margin="0,0,8,0"/>
                                                <TextBlock Text="Validation"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                
                            </StackPanel>
                        </Expander>
                        <!-- Section Saisie des Pièces Fin -->


                        <!-- Section Gestion Comptable debut-->

                        <StackPanel Visibility="{Binding Converter={StaticResource PermissionToVisibilityConverter}, ConverterParameter=GestionComptable.Access}">

                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                          HorizontalAlignment="Left"
                                          Width="250"
                                          Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" 
                                        VerticalAlignment="Center"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Foreground="Black"/>
                                    <TextBlock Text="Gestion Comptable" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="CompteGestion_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookAccount" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte de Gestion" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="LivreJournalButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="NotebookOutline" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Livre Journal" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="GrandLivreButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpenVariant" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Grand Livre" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                
                                
                                <!-- BALANCE debut-->
                                <Expander Style="{StaticResource MaterialDesignExpander}" 
                                          HorizontalAlignment="Left"
                                          Width="230"
                                          Margin="0,5,0,5">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ScaleBalance" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,10,0"
                                           Foreground="Black"/>
                                            <TextBlock Text="Balance" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Orientation="Vertical" Margin="18,0,0,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                                <Setter Property="Foreground" Value="#424242"/>
                                            </Style>
                                        </StackPanel.Resources>

                                        <Button x:Name="BtnBalanceMensuelle" Style="{StaticResource MenuButtonStyle}" Click="BalanceButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarMonth" 
                                                   VerticalAlignment="Center"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,15,0"/>
                                                <TextBlock Text="Balance mensuelle" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button  Style="{StaticResource MenuButtonStyle}" Click="BalanceAnnuelleButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarRange" 
                                                    VerticalAlignment="Center"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="0,0,15,0"/>
                                                <TextBlock Text="Balance Annuelle" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Expander>
                                <!-- Balance fin-->

                                <Button Style="{StaticResource MenuButtonStyle}" Click="MouvementButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentCheck" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Droits Constatés" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                

                                <Button Style="{StaticResource MenuButtonStyle}" Click="DroitsAuComptantButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashCheck" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Droit Au Comptant" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                

                                <Button Style="{StaticResource MenuButtonStyle}" Click="DebiteurCrediteur_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BankTransfer" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Dettes et Créances" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        <!-- Section Gestion Comptable Fin  -->
                        
                        <!-- Section PDL
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                   HorizontalAlignment="Left"
                                   Width="250"
                                   Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartTimelineVariant" 
                                        VerticalAlignment="Center"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Foreground="Black"/>
                                    <TextBlock Text="P-D-L" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button  Style="{StaticResource MenuButtonStyle}" Click="PDLPage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarMultiple" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="PDL" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button  Style="{StaticResource MenuButtonStyle}" Click="PROGRAMMES_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileTree" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Programmes" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button  Style="{StaticResource MenuButtonStyle}" Click="SECTEUR_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewGrid" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Secteurs" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button  Style="{StaticResource MenuButtonStyle}" Click="BENEFICIAIRE_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountGroup" 
