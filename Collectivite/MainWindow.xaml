<Window x:Class="Collectivite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Gestion Budgétaire et Comptable"
        Height="800" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Style pour les boutons de menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les en-têtes de section du menu -->
        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="20,15,0,5"/>

        </Style>
    </Window.Resources>

    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsMenuOpen}">
        <!-- Sidebar (Drawer gauche) -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="280" Background="White">
                <!-- Header de la sidebar -->
                <Border DockPanel.Dock="Top" 
                       Background="{DynamicResource PrimaryHueMidBrush}"
                       Height="180"
                       Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CityVariant" 
                                               Width="60" 
                                               Height="60"
                                               Foreground="Green"
                                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Plateforme de Gestion Budgetaire "
                                 FontSize="15"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Margin="0,15,0,0"/>
                        <TextBlock Text="et Comptable des Collectivités"
                                 FontSize="15"
                                   FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Opacity="0.9"
                                 Margin="0,5,0,0"/>
                        <TextBlock Text="Locales"
                                 FontSize="15"
                                   FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Opacity="0.9"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menu de navigation -->
                <ScrollViewer DockPanel.Dock="Top" 
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,20">
                        <!-- Tableau de bord -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="DashboardButton_Click"
                               Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Configuration -->
                        <TextBlock Text="Configuration" Style="{StaticResource MenuHeaderStyle}"/>
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                  HorizontalAlignment="Left"
                                  Width="250"
                                  Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Settings" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Paramétrage" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                         Click="CommuneButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarker" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Commune" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                          Click="ExerciceButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarRange" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Exercice" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="NommenclatureButton_Click" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                               VerticalAlignment="Center"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,15,0"/>
                                        <TextBlock Text="Nommenclature" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </Expander>
                        <!-- Section Configuration fin-->
                        
                        <Button Style="{StaticResource MenuButtonStyle}"
                            Click="CompteComptable_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                    VerticalAlignment="Center"
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,15,0"/>
                                <TextBlock Text="Compte comptables" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="BudgetPrimitifButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Budget Primitif" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Gestion Budgétaire -->
              
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                      HorizontalAlignment="Left"
                                      Width="250"
                                      Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CurrencyUsd" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,10,0"
                                           Foreground="Black"/>
                                    <TextBlock Text="Gestion Budgétaire" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}"
                                           Click="BudgetLineButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Ligne Budgetaire" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Style="{StaticResource MenuButtonStyle}" Click="RemaniementButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Budget Remanié" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileChart" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte Administratif" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Expander>
                        <!-- Section Gestion Budgétaire Fin -->
                        
                        <!-- Section Gestion Compte Bancaire et Tiers -->
                        <TextBlock Text="Compte Bancaire et Tiers" Style="{StaticResource MenuHeaderStyle}"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Click="TiersButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" 
                                 VerticalAlignment="Center"
                                 Width="22"
                                 Height="22"
                                 Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Tiers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- <Button Style="{StaticResource MenuButtonStyle}" Click="CompteBancaireButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bank" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Compte Bancaire" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button> -->


                        <Button Style="{StaticResource MenuButtonStyle}" Click="RecensementButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" 
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Margin="0,0,15,0"/>
                                <TextBlock Text="Gestion des Recensements" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Saisie des Pièces debut -->
                        


                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                              HorizontalAlignment="Left"
                                  Width="250"
                              Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                       VerticalAlignment="Center"
                                       Width="22"
                                       Height="22"
                                       Margin="0,0,10,0"
                                       Foreground="Black"/>
                                    <TextBlock Text="Saisie des Pièces" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="BonCommande_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Bon de Commande" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FactureButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardText" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Facture et Détails" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="Contrat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSign" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Contrat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="FicheEngagement_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardText" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Fiche d'Engagement" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="Mandat_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashCheck" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Mandat" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}" Click="OrdreRecette_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Receipt" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Ordre de Recette" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </Expander>
                        <!-- Section Saisie des Pièces Fin -->
                        
                        
                        <!-- Section Gestion Comptable debut-->
                        
                        <Expander Style="{StaticResource MaterialDesignExpander}" 
                                          HorizontalAlignment="Left"
                                          Width="250"
                                          Margin="10,10,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" 
                                        VerticalAlignment="Center"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,10,0"
                                        Foreground="Black"/>
                                    <TextBlock Text="Gestion Comptable" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Foreground" Value="#424242"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Book" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Compte de Gestion" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpen" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Livre Journal" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpen" 
                                            VerticalAlignment="Center"
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,15,0"/>
                                        <TextBlock Text="Grand Livre" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ScaleBalance" 
                                           VerticalAlignment="Center"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,15,0"/>
                                        <TextBlock Text="Balance" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>


                            </StackPanel>
                        </Expander>
                        <!-- Section Gestion Comptable Fin  -->
                        
                        <!-- Espacement final -->
                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- Contenu principal -->
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" 
                   Background="White"
                   Height="80"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" 
                                    ShadowDepth="2" 
                                    Opacity="0.1" 
                                    Color="Black"/>
                </Border.Effect>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bouton menu + Titre -->
                    <StackPanel Grid.Column="0" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                               Command="{Binding OpenMenuCommand}"
                               Width="40"
                               Height="40"
                               Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="Menu" Width="26" Height="26"/>
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="CalendarClock" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ExerciceText}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" • " 
                                         FontSize="13"
                                         Foreground="#757575"
                                         Margin="5,0"
                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MapMarker" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CommuneName}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions à droite -->
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <!-- Bouton Exercice -->
                        <Button x:Name="ExerciceButton"
                            Click="ExerciceButtonDown_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="36"
                            Padding="15,0"
                            Margin="0,0,15,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Calendar" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ExerciceText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ExerciceMenu"
                                     ItemsSource="{Binding Exercices}"
                                     MinWidth="180"
                                     Width="200">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Libelle}"/>
                                            <Setter Property="Command" Value="{Binding DataContext.SelectExerciceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding Id}"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Height" Value="36"/>
                                        </Style>
                                    </ContextMenu.Resources>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>


                        <!-- Séparateur -->
                        <Border Width="1" 
                               Background="#E0E0E0" 
                               Margin="10,15"
                               VerticalAlignment="Stretch"/>

                        <!-- Menu utilisateur -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                               StaysOpen="False"
                                               Margin="10,0,0,0">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                           Width="40"
                                           Height="40"
                                           CornerRadius="20"
                                           Margin="0,0,10,0">
                                        <!--<TextBlock Text="{Binding UserInitials}"
                                                 Foreground="Blue"
                                                 FontWeight="SemiBold"
                                                 FontSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/> -->
                                    </Border>
                                    <TextBlock Text="{Binding UserFullName}"
                                                    Foreground="Blue"
                                                     FontWeight="SemiBold"
                                                     FontSize="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>

                            <StackPanel Width="240" Margin="0">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10"
                                       Command="{Binding OpenProfileCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountCircle"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock Text="Profil" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10"
                                       Command="{Binding OpenSettingsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Separator Margin="0,5"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10"
                                       Command="{Binding LogoutCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Zone de contenu principal (Frame) -->
            <Border DockPanel.Dock="Top" Background="#F5F5F5">
                <Frame x:Name="MainContentFrame"
                       NavigationUIVisibility="Hidden"/>
            </Border>
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
