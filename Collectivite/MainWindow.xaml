        <!-- CONTENU PRINCIPAL (Colonne droite) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="1">
            <!-- Header -->
            <Border DockPanel.Dock="Top" 
                   Background="White"
                   Height="80"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" 
                                    ShadowDepth="2" 
                                    Opacity="0.1" 
                                    Color="Black"/>
                </Border.Effect>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titre de la page -->
                    <StackPanel Grid.Column="0" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="CalendarClock" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ExerciceText}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" • " 
                                         FontSize="13"
                                         Foreground="#757575"
                                         Margin="5,0"
                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MapMarker" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CommuneName}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions à droite -->
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <!-- Bouton Exercice -->
                        <Button x:Name="ExerciceButton"
                            Click="ExerciceButtonDown_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="36"
                            Padding="15,0"
                            Margin="0,0,15,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Calendar" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ExerciceText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ExerciceMenu"
                                     ItemsSource="{Binding Exercices}"
                                     MinWidth="180"
                                     Width="200">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Libelle}"/>
                                            <Setter Property="Command" Value="{Binding DataContext.SelectExerciceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding Id}"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Height" Value="36"/>
                                        </Style>
                                    </ContextMenu.Resources>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>


                        <!-- Séparateur -->
                        <Border Width="1" 
                               Background="#E0E0E0" 
                               Margin="10,15"
                               VerticalAlignment="Stretch"/>

                        <!-- Menu utilisateur -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                               StaysOpen="False"
                                               Margin="10,0,0,0">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <!-- Avatar avec initiales -->
                                    <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                           Width="50"
                                           Height="50"
                                           CornerRadius="25"
                                           BorderBrush="#E0E0E0"
                                           BorderThickness="2"
                                           Margin="0,0,12,0">
                                        <TextBlock Text="{Binding UserInitials}"
                                                 Foreground="Blue"
                                                 FontWeight="SemiBold"
                                                 FontSize="18"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Nom et rôle -->
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserFullName}"
                                                   Foreground="Blue"
                                                   FontWeight="SemiBold"
                                                   FontSize="20"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UserRole}"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>

                            <StackPanel Width="240" Margin="0">
                                <!-- Bouton Profil (toujours visible mais actif seulement si connecté) -->
                                <Button HorizontalContentAlignment="Left"
                                        Padding="15,10"
                                        Command="{Binding OpenProfileCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="IsEnabled" Value="{Binding IsUserLoggedIn}"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountCircle"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock Text="Profil" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Bouton Connexion (visible uniquement si NON connecté) -->
                                <Button HorizontalContentAlignment="Left"
                                        Padding="15,10"
                                        Command="{Binding OpenLoginCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Login"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"/>
                                        <TextBlock Text="Se connecter" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Separator Margin="0,5"/>

                                <!-- Bouton Déconnexion (visible uniquement si connecté) -->
                                <Button HorizontalContentAlignment="Left"
                                        Padding="15,10"
                                        Command="{Binding LogoutCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Zone de contenu principal (Frame) -->
            <Border DockPanel.Dock="Top" Background="#F5F5F5">
                <Frame x:Name="MainContentFrame"
                       NavigationUIVisibility="Hidden"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
