<Window x:Class="Collectivite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Gestion Budgétaire et Comptable"
        Height="800" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Style pour les boutons de menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les en-têtes de section du menu -->
        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="20,15,0,5"/>
            
        </Style>
    </Window.Resources>

    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsMenuOpen}">
        <!-- Sidebar (Drawer gauche) -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="280" Background="White">
                <!-- Header de la sidebar -->
                <Border DockPanel.Dock="Top" 
                       Background="{DynamicResource PrimaryHueMidBrush}"
                       Height="160"
                       Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CityVariant" 
                                               Width="60" 
                                               Height="60"
                                               Foreground="Green"
                                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Gestion Municipale"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Margin="0,15,0,0"/>
                        <TextBlock Text="Solution Budgétaire"
                                 FontSize="13"
                                 Foreground="Black"
                                 TextAlignment="Center"
                                 Opacity="0.9"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menu de navigation -->
                <ScrollViewer DockPanel.Dock="Top" 
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,20">
                        <!-- Tableau de bord -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="DashboardButton_Click"
                               Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Configuration -->
                        <TextBlock Text="Configuration" Style="{StaticResource MenuHeaderStyle}"/>
                        
                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="CommuneButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarker" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Commune" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="ExerciceButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarRange" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Exercice" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="BudgetPrimitifButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Budget Primitif" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Gestion Budgétaire -->
                        <TextBlock Text="Gestion Budgétaire" Style="{StaticResource MenuHeaderStyle}"/>

                        <Button Style="{StaticResource MenuButtonStyle}"
                               Click="BudgetLineButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Budget Line" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Budget Remanié" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileChart" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Compte Administratif" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Saisie des Pièces -->
                        <TextBlock Text="Saisie des Pièces" Style="{StaticResource MenuHeaderStyle}"/>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentEdit" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Bon de Commande" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileSign" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Contrat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardText" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Fiche d'Engagement" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashCheck" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Mandat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Receipt" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Ordre de Recette" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section Gestion Comptable -->
                        <TextBlock Text="Gestion Comptable" Style="{StaticResource MenuHeaderStyle}"/>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Compte de Gestion" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Book" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Livre Journal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpen" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Grand Livre" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ScaleBalance" 
                                                       VerticalAlignment="Center"
                                                       Width="22"
                                                       Height="22"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="Balance" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Espacement final -->
                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- Contenu principal -->
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" 
                   Background="White"
                   Height="80"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" 
                                    ShadowDepth="2" 
                                    Opacity="0.1" 
                                    Color="Black"/>
                </Border.Effect>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bouton menu + Titre -->
                    <StackPanel Grid.Column="0" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                               Command="{Binding OpenMenuCommand}"
                               Width="40"
                               Height="40"
                               Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="Menu" Width="26" Height="26"/>
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                     FontSize="24"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="CalendarClock" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ExerciceText}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text=" • " 
                                         FontSize="13"
                                         Foreground="#757575"
                                         Margin="5,0"
                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MapMarker" 
                                                       Width="16" 
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"
                                                       Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CommuneName}"
                                         FontSize="13"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions à droite -->
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <!-- Bouton Exercice -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                               Height="36"
                               Padding="15,0"
                               Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calendar" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ExerciceText}" 
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Séparateur -->
                        <Border Width="1" 
                               Background="#E0E0E0" 
                               Margin="10,15"
                               VerticalAlignment="Stretch"/>

                        <!-- Menu utilisateur -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                               StaysOpen="False"
                                               Margin="10,0,0,0">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                           Width="40"
                                           Height="40"
                                           CornerRadius="20"
                                           Margin="0,0,10,0">
                                        <TextBlock Text="{Binding UserInitials}"
                                                 Foreground="White"
                                                 FontWeight="SemiBold"
                                                 FontSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding UserFullName}"
                                             FontSize="14"
                                             FontWeight="Medium"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>

                            <StackPanel Width="200">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Account" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="Mon profil" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Separator Margin="0,5"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                       HorizontalContentAlignment="Left"
                                       Padding="15,10"
                                       Command="{Binding LogoutCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                        <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Zone de contenu principal (Frame) -->
            <Border DockPanel.Dock="Top" Background="#F5F5F5">
                <Frame x:Name="MainContentFrame"
                      NavigationUIVisibility="Hidden"
                      Margin="0"/>
            </Border>
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
