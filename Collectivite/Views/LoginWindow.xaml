<Window x:Class="Collectivite.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Collectivite.Views.Controls"
        xmlns:utils="clr-namespace:Collectivite.Utils"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Connexion - Gestion Budgétaire"
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Window.Resources>
        <utils:StringToVisibilityConverters x:Key="StringToVis"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.3" 
                            Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section Gauche - Formulaire -->
            <Grid Grid.Column="0" Margin="50,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" VerticalAlignment="Top">
                    <TextBlock Text="Bienvenue"
                             FontSize="30"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Margin="0,10,0,8"
                             Foreground="#1E293B"/>

                    <TextBlock Text="Connectez-vous à votre compte"
                             FontSize="14"
                             FontWeight="Normal"
                             HorizontalAlignment="Center"
                             Foreground="#8A94A6"/>
                </StackPanel>

                <!-- Formulaire -->
                <StackPanel Grid.Row="1" 
                          VerticalAlignment="Center"
                          Margin="0,40,0,0">
                    
                    <!-- Nom d'utilisateur -->
                    <TextBox materialDesign:HintAssist.Hint="Nom d'utilisateur"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0,0,0,25"
                           FontSize="16"
                           Padding="15,18"
                           Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:TextFieldAssist.LeadingIcon>
                            <!-- <materialDesign:PackIcon Kind=""/> -->
                            Account
                        </materialDesign:TextFieldAssist.LeadingIcon>
                    </TextBox>

                    <!-- Mot de passe -->
                    <controls:PasswordRevealBox Hint="Mot de passe"
                               Password="{Binding Password, Mode=TwoWay}"
                               Margin="0,0,0,15"
                               FontSize="16"/>

                    <!-- Message d'erreur -->
                    <TextBlock Text="{Binding ErrorMessage}"
                             Foreground="#F44336"
                             FontSize="13"
                             Margin="5,5,0,15"
                             TextWrapping="Wrap"
                             Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

                    <!-- Bouton de connexion -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                          Height="50"
                          FontSize="16"
                          Command="{Binding LoginCommand}"
                          materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                          materialDesign:ButtonProgressAssist.Value="-1"
                          materialDesign:ButtonProgressAssist.IsIndeterminate="True"  >
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                            <TextBlock Text="SE CONNECTER" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Lien mot de passe oublié -->
                    <!-- <TextBlock Text="Mot de passe oublié ?"
                             HorizontalAlignment="Center"
                             Margin="0,20,0,0"
                             FontSize="13"
                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                             Cursor="Hand">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock> -->
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                          VerticalAlignment="Bottom">
                    <TextBlock Text="© 2026 Gestion Communale"
                             HorizontalAlignment="Center"
                             FontSize="11"
                             Foreground="#B0B8C4"/>
                </StackPanel>
            </Grid>

            <!-- Section Droite - Illustration -->
            <Grid Grid.Column="1">
                <Border CornerRadius="0,10,10,0">
                    <Border.Background>
                        <!-- Mirrors AppPrimaryBrush -> AppPrimaryDarkBrush (Styles/Palette.xaml) -->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1976D2" Offset="0"/>
                            <GradientStop Color="#0D47A1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="40">

                        <!-- Illustration -->
                        <Border Width="180" Height="180"
                              CornerRadius="90"
                              Background="White"
                              Margin="0,0,0,30">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                ShadowDepth="4"
                                                Opacity="0.25"
                                                Color="Black"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/mairie-illustration.png"
                                 Width="120"
                                 Height="120"
                                 Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="GESTION BUDGÉTAIRE &amp; COMPTABLE"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="White"
                              Opacity="0.75"
                              TextAlignment="Center"
                              Margin="0,18,0,6"/>
                        <TextBlock Text="Collectivités Locales"
                              FontSize="26"
                              FontWeight="Bold"
                              Foreground="White"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              MaxWidth="280"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bouton fermer -->
            <Button Grid.Column="1"
                  Style="{StaticResource MaterialDesignIconButton}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Margin="10"
                  Click="CloseButton_Click"
                  Foreground="White">
                <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
            </Button>
        </Grid>
    </Border>
</Window>
