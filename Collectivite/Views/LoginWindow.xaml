<Window x:Class="Collectivite.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Connexion - Gestion Budgétaire"
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.3" 
                            Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section Gauche - Formulaire -->
            <Grid Grid.Column="0" Margin="50,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="AccountCircle" 
                                           Width="80" 
                                           Height="80"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Bienvenue"
                             FontSize="32"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             Margin="0,20,0,5"
                             Foreground="{DynamicResource MaterialDesignBody}"/>
                    
                    <TextBlock Text="Connectez-vous à votre compte"
                             FontSize="14"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>

                <!-- Formulaire -->
                <StackPanel Grid.Row="1" 
                          VerticalAlignment="Center"
                          Margin="0,40,0,0">
                    
                    <!-- Nom d'utilisateur -->
                    <TextBox materialDesign:HintAssist.Hint="Nom d'utilisateur"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0,0,0,25"
                           FontSize="16"
                           Padding="15,18"
                           Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:TextFieldAssist.LeadingIcon>
                            <!-- <materialDesign:PackIcon Kind=""/> -->
                            Account
                        </materialDesign:TextFieldAssist.LeadingIcon>
                    </TextBox>

                    <!-- Mot de passe -->
                    <PasswordBox x:Name="PasswordBox"
                               materialDesign:HintAssist.Hint="Mot de passe"
                               Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                               Margin="0,0,0,15"
                               FontSize="16"
                               Padding="15,18"
                               PasswordChanged="PasswordBox_PasswordChanged">
                        <materialDesign:TextFieldAssist.LeadingIcon>
                            <!-- <materialDesign:PackIcon Kind="Lock"/> -->
                            Lock
                        </materialDesign:TextFieldAssist.LeadingIcon>
                    </PasswordBox>

                    <!-- Message d'erreur -->
                    <TextBlock Text="{Binding ErrorMessage}"
                             Foreground="#F44336"
                             FontSize="13"
                             Margin="5,5,0,15"
                             TextWrapping="Wrap"
                             Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

                    <!-- Bouton de connexion -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                          Height="50"
                          FontSize="16"
                          Command="{Binding LoginCommand}"
                          materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                          materialDesign:ButtonProgressAssist.Value="-1"
                          materialDesign:ButtonProgressAssist.IsIndeterminate="True"  >
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                            <TextBlock Text="SE CONNECTER" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Lien mot de passe oublié -->
                    <!-- <TextBlock Text="Mot de passe oublié ?"
                             HorizontalAlignment="Center"
                             Margin="0,20,0,0"
                             FontSize="13"
                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                             Cursor="Hand">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock> -->
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" 
                          VerticalAlignment="Bottom">
                    <TextBlock Text="© 2025 Gestion Communale"
                             HorizontalAlignment="Center"
                             FontSize="12"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>
            </Grid>

            <!-- Section Droite - Image -->
            <Grid Grid.Column="1">
                <Border CornerRadius="0,10,10,0"
                      Background="{DynamicResource PrimaryHueMidBrush}">
                    <Grid>
                        <!-- Image de la commune -->
                        <Image Source="pack://application:,,,/app_icon_256.png"
                             Stretch="UniformToFill"
                             Opacity="0.9"/>
                        
                        <!-- Overlay gradient -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#80000000" Offset="0"/>
                                    <GradientStop Color="#B0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Texte superposé -->
                        <StackPanel VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"
                                  Margin="40">
                            <materialDesign:PackIcon Kind="CityVariant"
                                  Width="100"
                                  Height="100"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,20"/>

                            <TextBlock Text="Plateforme de Gestion Budgetaire "
                                  FontSize="15"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  TextAlignment="Center"
                                  Margin="0,15,0,0"/>
                            <TextBlock Text="et Comptable des Collectivités"
                                  FontSize="15"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  TextAlignment="Center"
                                  Opacity="0.9"
                                  Margin="0,5,0,0"/>
                            <TextBlock Text="Locales"
                                  FontSize="15"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  TextAlignment="Center"
                                  Opacity="0.9"
                                  Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bouton fermer -->
            <Button Grid.Column="1"
                  Style="{StaticResource MaterialDesignIconButton}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Margin="10"
                  Click="CloseButton_Click"
                  Foreground="White">
                <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
            </Button>
        </Grid>
    </Border>
</Window>
