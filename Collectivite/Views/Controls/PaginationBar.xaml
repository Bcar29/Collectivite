<UserControl x:Class="Collectivite.Views.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="15,8,15,8">
        <TextBlock VerticalAlignment="Center"
                   Margin="0,0,15,0"
                   Opacity="0.7">
            <Run Text="Page"/>
            <Run Text="{Binding PageNumber, ElementName=Root, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text="/"/>
            <Run Text="{Binding TotalPages, ElementName=Root, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text=" — "/>
            <Run Text="{Binding TotalCount, ElementName=Root, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text="résultat(s)"/>
        </TextBlock>

        <Button Style="{StaticResource MaterialDesignIconButton}"
                Width="32" Height="32" Padding="4"
                Command="{Binding PreviousCommand, ElementName=Root}"
                ToolTip="Page précédente">
            <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
        </Button>

        <Button Style="{StaticResource MaterialDesignIconButton}"
                Width="32" Height="32" Padding="4"
                Margin="5,0,0,0"
                Command="{Binding NextCommand, ElementName=Root}"
                ToolTip="Page suivante">
            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
        </Button>
    </StackPanel>
</UserControl>
