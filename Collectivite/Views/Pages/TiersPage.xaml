                                 materialDesign:HintAssist.Hint="Prénom"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogTiers.Prenom, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Email -->
                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 materialDesign:HintAssist.Hint="Email *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogTiers.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Adresse -->
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                 materialDesign:HintAssist.Hint="Adresse *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogTiers.Adresse, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- RCCM -->
