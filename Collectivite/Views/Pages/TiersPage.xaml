                                 materialDesign:HintAssist.Hint="NIF"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogTiers.Nif, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Statut Actif -->
