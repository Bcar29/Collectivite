<Page x:Class="Collectivite.Views.Pages.TiersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Tiers">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Enum TiersType -->
        <ObjectDataProvider x:Key="TiersTypeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:TiersType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TiersType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour les badges de statut -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Style DataGrid réutilisable -->
        <Style x:Key="TiersDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="13 8 8 8"/>
            <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="AccountMultiple" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Tiers" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddTiersDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0" />
                            <TextBlock Text="Nouveau Tiers" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" />
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Barre de recherche -->
            <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox materialDesign:HintAssist.Hint="Rechercher par nom, prénom ou email..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SearchCommand}"
                            Height="40"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Margin="0,0,5,0"/>
                            <TextBlock Text="Rechercher"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- TabControl pour filtrer par type -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- TOUS LES TIERS -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                   Width="20" Height="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Tous" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>
                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding Tiers}"
                                  SelectedItem="{Binding SelectedTiers}"
                                  Style="{StaticResource TiersDataGridStyle}">
                            <DataGrid.Columns>

                                <!-- Type -->
                                <DataGridTemplateColumn Header="Type" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Fournisseur">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Entreprise">
                                                                <Setter Property="Background" Value="#FFF3E0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Redevable">
                                                                <Setter Property="Background" Value="#FCE4EC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Contribuable">
                                                                <Setter Property="Background" Value="#F3E5F5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Association">
                                                                <Setter Property="Background" Value="#E0F2F1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Nom complet -->
                                <DataGridTemplateColumn Header="Nom complet" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Prenom}" FontSize="11" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Email -->
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>

                                <!-- RCCM -->
                                <DataGridTextColumn Header="RCCM" Binding="{Binding Rccm}" Width="120"/>

                                <!-- NIF -->
                                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="120"/>

                                <!-- Adresse -->
                                <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="180"/>

                                <!-- Statut -->
                                <DataGridTemplateColumn Header="Statut" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Cancel"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Actif"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Text" Value="Inactif"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                <!-- Modifier -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.OpenEditTiersDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Modifier">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                                </Button>

                                                <!-- Activer/Désactiver -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.ToggleActifCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="4,0">
                                                    <Button.ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Désactiver"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                            <Setter Property="Text" Value="Activer"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button.ToolTip>
                                                    <materialDesign:PackIcon Foreground="#FF9800">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="EyeOff"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Eye"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>

                                                <!-- Supprimer -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteTiersCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- FOURNISSEURS -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TruckDelivery" 
                                                   Width="20" Height="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Fournisseurs" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>
                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding TiersFournisseurs}"
                                  SelectedItem="{Binding SelectedTiers}"
                                  Style="{StaticResource TiersDataGridStyle}">
                            <DataGrid.Columns>
                                <!-- Mêmes colonnes -->
                                <DataGridTemplateColumn Header="Type" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nom complet" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Prenom}" FontSize="11" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="RCCM" Binding="{Binding Rccm}" Width="120"/>
                                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="120"/>
                                <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="180"/>
                                <DataGridTemplateColumn Header="Statut" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Cancel"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Actif"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Text" Value="Inactif"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.OpenEditTiersDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Modifier">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.ToggleActifCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="4,0">
                                                    <Button.ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Désactiver"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                            <Setter Property="Text" Value="Activer"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button.ToolTip>
                                                    <materialDesign:PackIcon Foreground="#FF9800">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="EyeOff"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Eye"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteTiersCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- ENTREPRISES -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" 
                                                   Width="20" Height="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Entreprises" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>
                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding TiersEntreprises}"
                                  SelectedItem="{Binding SelectedTiers}"
                                  Style="{StaticResource TiersDataGridStyle}">
                            <DataGrid.Columns>
                                <!-- Colonnes identiques à Fournisseurs -->
                                <DataGridTemplateColumn Header="Type" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nom complet" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Prenom}" FontSize="11" Foreground="#666"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="RCCM" Binding="{Binding Rccm}" Width="120"/>
                                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="120"/>
                                <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="180"/>
                                <DataGridTemplateColumn Header="Statut" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Cancel"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Actif"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Text" Value="Inactif"/>
                                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.OpenEditTiersDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Modifier">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.ToggleActifCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="4,0">
                                                    <Button.ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Désactiver"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                            <Setter Property="Text" Value="Activer"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button.ToolTip>
                                                    <materialDesign:PackIcon Foreground="#FF9800">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="EyeOff"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActif}" Value="False">
                                                                        <Setter Property="Kind" Value="Eye"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteTiersCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- REDEVABLES -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                   Width="20" Height="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Redevables" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>
                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding TiersRedevables}"
                                  SelectedItem="{Binding SelectedTiers}"
                                  Style="{StaticResource TiersDataGridStyle}">
                            <!-- Même structure de colonnes -->
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Type" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FCE4EC" Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nom complet" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
