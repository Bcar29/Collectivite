<Page x:Class="Collectivite.Views.Pages.EngagementDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails de l'Engagement">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000">
              
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              Command="{Binding BackCommand}"
                              ToolTip="Retour"
                              Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                   Width="24" 
                                                   Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Détails de l'Engagement" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>

                        <!-- Badge d'état -->
                        <Border Background="{Binding EtatBackground}"
                                CornerRadius="12"
                                Padding="12,6"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Engagement.EngagementEtat}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding PrintCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ExportPdfCommand}"
                            Height="36"
                            Background="DarkRed"
                            BorderBrush="DarkRed"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Contenu -->
                <materialDesign:Card Padding="30">
                    <StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- EN-TÊTE OFFICIEL GUINÉEN -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colonne gauche : Ministère -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ministère de l'Administration du Territoire"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Foreground="#1E293B"/>
                                <TextBlock Text="et de la Décentralisation"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Foreground="#1E293B"/>
                                <TextBlock Text="Direction Générale des Collectivités Locales"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="#475569"
                                     Margin="0,5,0,0"/>

                                <!-- Infos géographiques -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="REGION ADMINISTRATIVE DE "/>
                                        <Run Text="{Binding Commune.RegionCommune, FallbackValue='............................', Mode=OneWay}" 
                                                FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="PREFECTURE DE "/>
                                        <Run Text="{Binding Commune.PrefectureCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="COMMUNE "/>
                                        <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <Run Text=" DE "/>
                                            <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}" 
                                                 FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Colonne centrale : Symbole -->
                            <StackPanel Grid.Column="1" 
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               Margin="20,0">
                                <TextBlock Text="⚜" 
                                 FontSize="36" 
                                 Foreground="#059669"
                                 HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Colonne droite : République -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="REPUBLIQUE DE GUINEE"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Right"/>
                                <TextBlock Text="Travail - Justice - Solidarité"
                                     FontSize="12"
                                     FontStyle="Italic"
                                     Foreground="#475569"
                                     HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Titre du document avec bandeau -->
                        <StackPanel Margin="0,0,0,25">
                            <!-- Titre principal -->
                            <TextBlock Text="ENGAGEMENT"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="#1E293B"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,8"/>

                            <!-- Bandeau avec commune -->
                            <Border Background="#D1FAE5"
                                BorderBrush="#059669"
                                BorderThickness="0,2"
                                Padding="15,8"
                                HorizontalAlignment="Center"
                                MinWidth="400">
                                <TextBlock HorizontalAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Foreground="#065F46">
                                    <Run Text="DE LA COMMUNE "/>
                                    <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}"/>
                                    <Run Text=" DE "/>
                                    <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Exercice -->
                            <TextBlock FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1E293B"
                                 HorizontalAlignment="Center"
                                 Margin="0,10,0,0">

                        <Run Text="{Binding Engagement.Exercice.Libelle, FallbackValue='2025'}"/>
                                                    </TextBlock>
                                                </StackPanel>

                        <Separator Margin="0,0,0,20"/>

                        <!-- Informations générales -->
                        <TextBlock Text="📋 Informations générales"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Exercice :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Engagement.Exercice.Libelle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Engagement.DateEngagement, StringFormat='dd/MM/yyyy'}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Commune :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Engagement.Commune.Nom}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tiers :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Engagement.Tiers.NomComplet}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ligne budgétaire :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Engagement.BudgetLine.Nommenclature.Intitule}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Bon de Commande :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Engagement.BonCommande.Numero, FallbackValue='Non spécifié'}"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Facture :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Engagement.Facture.Numero, FallbackValue='Non spécifiée'}"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Objet :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding Engagement.Objet}" TextWrapping="Wrap"/>
                        </Grid>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Montants -->
                        <TextBlock Text="💰 Montants"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Crédits budgétaires -->
                            <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Crédits budgétaires" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding Engagement.CreditsBudgetaires, StringFormat={}{0:N0} GNF}" 
                                             FontSize="20" 
                                             FontWeight="Bold" 
                                             Foreground="#1976D2"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Engagements antérieurs -->
                            <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Engagements antérieurs" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding Engagement.EngagementsAnterieurs, StringFormat={}{0:N0} GNF}" 
                                             FontSize="20" 
                                             FontWeight="Bold" 
                                             Foreground="#F57C00"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Montant de l'engagement -->
                            <Border Grid.Column="4" Background="#E8F5E9" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Montant de l'engagement" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding Engagement.MontantEngagement, StringFormat={}{0:N0} GNF}" 
                                             FontSize="20" 
                                             FontWeight="Bold" 
                                             Foreground="#388E3C"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Cumul -->
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="Cumul des engagements :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Engagement.CumulEngagement, StringFormat={}{0:N0} GNF}" 
                                         FontSize="24" 
                                         FontWeight="Bold" 
                                         Foreground="#1976D2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Montant en lettres -->
                        <Border Background="#F9FBE7" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Montant en lettres :" 
                                         FontWeight="SemiBold" 
                                         FontSize="12"
                                         Foreground="#666"
                                         Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Engagement.MontantLettre}" 
                                         FontSize="14"
                                         FontStyle="Italic"
                                         TextWrapping="Wrap"
                                         Foreground="#33691E"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Fichier joint -->
                        <TextBlock Text="📎 Fichier joint"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Border Background="#F5F5F5" 
                              CornerRadius="8" 
                              Padding="20"
                              Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" 
                                                       Width="40" 
                                                       Height="40"
                                                       Foreground="#1976D2"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Engagement.FichierName, FallbackValue='Fichier joint disponible'}" 
                                             FontWeight="SemiBold"
                                             FontSize="14"/>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                          Command="{Binding DownloadFileCommand}"
                                          Content="Télécharger le fichier"
                                          Margin="0,5,0,0"
                                          Padding="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Aucun fichier joint"
                            FontStyle="Italic"
                            Foreground="#999">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Caché par défaut -->
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <!-- Visible seulement s'il n'y a pas de fichier -->
                                        <DataTrigger Binding="{Binding HasFile}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>


                        <!-- Section Signatures simplifiée (uniquement si engagement validé) -->
                        <StackPanel Visibility="{Binding IsEngagementValide, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,30,0,20"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                               

                                <!-- Le Maire -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock FontSize="12" 
                                         Foreground="#666"
                                         Margin="0,0,0,8">
                                    <Run Text="{Binding Engagement.Commune.Nom}"/>
                                    <Run Text=" Le "/>
                                    <Run Text=".............."/>
                                    <Run Text=" / "/>
                                    <Run Text=".............."/>
                                    <Run Text=" / "/>
                                    <Run Text=".............."/>
                                    </TextBlock>

                                    <TextBlock 
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Margin="0,30,0,0">
                                        <Run Text="L'Ordonateur :  "/>
                                        <Run Text=""/>
                                    </TextBlock>
                                    <TextBlock 
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Margin="0,40,0,0">
                                        <Run Text="M./Mme :  "/>
                                        <Run Text="......................................................"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>