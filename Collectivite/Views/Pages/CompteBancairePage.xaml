<Page x:Class="Collectivite.Views.Pages.CompteBancairePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Comptes Bancaires">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ✅ Convertisseur inverse -->
        <utils:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- Style pour les en-têtes de section -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="60"
                             Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="Bank" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Comptes Bancaires" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0" />
                            <TextBlock Text="Nouveau Compte" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" />
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Statistiques -->
            <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#E3F2FD" 
                            CornerRadius="8" 
                            Padding="15"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL COMPTES" 
                                       FontSize="11" 
                                       Foreground="#666"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalComptes}" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="#1976D2"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E8F5E9" 
                            CornerRadius="8" 
                            Padding="15">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                     Width="20" 
                                                     Height="20"
                                                     Foreground="#388E3C"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="12" 
                                       Foreground="#424242"
                                       VerticalAlignment="Center">
                                Gérez les comptes bancaires de tous vos tiers (fournisseurs, entreprises, etc.)
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- Barre de filtres et recherche -->
            <materialDesign:Card Grid.Row="2" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recherche -->
                    <TextBox materialDesign:HintAssist.Hint="Rechercher par IBAN, banque ou tiers..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Bouton rechercher -->
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding SearchCommand}"
                            Margin="10,0">
                        <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24"/>
                    </Button>

                    <!-- ✅ ComboBox corrigée -->
                    <ComboBox Grid.Column="2"
                              materialDesign:HintAssist.Hint="Filtrer par tiers"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding TiersList}"
                              SelectedItem="{Binding SelectedTiers}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nom}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </materialDesign:Card>

            <!-- DataGrid des comptes bancaires -->
            <materialDesign:Card Grid.Row="3" Padding="0">
                <DataGrid ItemsSource="{Binding Comptes}"
                          SelectedItem="{Binding SelectedCompte}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                    <DataGrid.Columns>

                        <!-- Tiers -->
                        <DataGridTemplateColumn Header="Tiers" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tiers.Nom}" 
                                                   FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="4" 
                                                    Padding="4,2"
                                                    Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Tiers.Type}" 
                                                           FontSize="10"
                                                           Foreground="#1976D2"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Banque -->
                        <DataGridTemplateColumn Header="Banque" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Bank" 
                                                                 Width="16" 
                                                                 Height="16"
                                                                 Foreground="#1976D2"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Banque}" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- IBAN -->
                        <DataGridTemplateColumn Header="IBAN" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" 
                                            CornerRadius="4" 
                                            Padding="8,4">
                                        <TextBlock Text="{Binding IBAN}" 
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   Foreground="#424242"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- BIC -->
                        <DataGridTextColumn Header="BIC" 
                                            Binding="{Binding BIC}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Pays -->
                        <DataGridTemplateColumn Header="Pays" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Earth" 
                                                                 Width="16" 
                                                                 Height="16"
                                                                 Foreground="#388E3C"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Pays}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <!-- Modifier -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Modifier"
                                                Margin="4,0">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                        </Button>

                                        <!-- Supprimer -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Supprimer"
                                                Margin="4,0">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                   CloseOnClickAway="False" 
                                   Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="600" Margin="20">

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CreditCard" 
                                                 Width="24" 
                                                 Height="24"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ✅ ComboBox corrigée -->
                    <ComboBox materialDesign:HintAssist.Hint="Tiers *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding TiersList}"
                              SelectedItem="{Binding DialogCompte.Tiers}"
                              SelectedValue="{Binding DialogCompte.TiersId}"
                              SelectedValuePath="Id"
                              IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBool}}"
                              Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nom}" FontWeight="Medium"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#666" Margin="0,0,5,0"/>
                                        <TextBlock Text="-" FontSize="10" Foreground="#666" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Email}" FontSize="10" Foreground="#666"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- IBAN -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox materialDesign:HintAssist.Hint="IBAN / Numéro de compte *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogCompte.IBAN, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 MaxLength="34"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding ValidateIBANCommand}"
                                ToolTip="Valider l'IBAN"
                                Margin="5,0,0,0">
                            <materialDesign:PackIcon Kind="CheckCircle" Foreground="#388E3C"/>
                        </Button>
                    </Grid>

                    <!-- BIC -->
                    <TextBox materialDesign:HintAssist.Hint="BIC / SWIFT"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogCompte.BIC, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             MaxLength="11"
                             Margin="0,0,0,15"/>

                    <!-- Banque -->
                    <TextBox materialDesign:HintAssist.Hint="Nom de la banque *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogCompte.Banque, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Margin="0,0,0,15"/>

                    <!-- Pays -->
                    <ComboBox materialDesign:HintAssist.Hint="Pays *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                               Text="{Binding DialogCompte.Pays, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Margin="0,0,0,15">
                        <ComboBoxItem Content="Guinée"/>
                        <ComboBoxItem Content="France"/>
                        <ComboBoxItem Content="Sénégal"/>
                        <ComboBoxItem Content="Mali"/>
                        <ComboBoxItem Content="Côte d'Ivoire"/>
                        <ComboBoxItem Content="Burkina Faso"/>
                        <ComboBoxItem Content="Niger"/>
                        <ComboBoxItem Content="Bénin"/>
                        <ComboBoxItem Content="Togo"/>
                    </ComboBox>

                    <!-- Information IBAN -->
                    <Border Background="#FFF3E0"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                         Width="20" 
                                                         Height="20"
                                                         Foreground="#F57C00"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Format IBAN" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#F57C00"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                                L'IBAN doit contenir entre 15 et 34 caractères alphanumériques.
                                <LineBreak/>
                                Format : 2 lettres (code pays) + 2 chiffres + code banque + numéro de compte
                                <LineBreak/>
                                Exemple (Guinée) : GN1234567890123456789012
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Note -->
                    <TextBlock Text="* Champs obligatoires"
                               FontSize="11"
                               Foreground="#666"
                               FontStyle="Italic"
                               Margin="5,0,0,15"/>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="120"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>
