<Page x:Class="Collectivite.Views.Pages.MandatDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détail du Mandat">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
        <utils:PaymentTooltipConverter x:Key="PaymentTooltipConverter"/>
        <utils:PaymentCommandConverter x:Key="PaymentCommandConverter"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding RetourCommand}"
                            DockPanel.Dock="Left"
                            ToolTip="Retour à la liste">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Détail du Mandat" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding PrintCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding NavigateToEditCommand}"
                            Height="36"
                            Background="DarkRed"
                            BorderBrush="DarkRed"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>

                <!-- Badge de statut -->
                <Border Grid.Row="1" 
                        Background="{Binding StatutCouleur}"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,20">
                    <DockPanel>
                        <materialDesign:PackIcon Width="24" 
                                               Height="24"
                                               Foreground="White"
                                               DockPanel.Dock="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstPaye}" Value="True">
                                            <Setter Property="Kind" Value="CheckCircle"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstPaye}" Value="False">
                                            <Setter Property="Kind" Value="ClockAlert"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding StatutPaiement}"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <TextBlock Foreground="White" FontSize="12" Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstPaye}" Value="True">
                                                <Setter Property="Text" Value="{Binding Mandat.DatePaiement, StringFormat='Payé le {0:dd/MM/yyyy}'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EstPaye}" Value="False">
                                                <Setter Property="Text" Value="En attente de paiement"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="White"
                                    Height="36"
                                    Visibility="{Binding EstPaye, Converter={StaticResource BoolToVis}}">
                                <Button.Command>
                                    <Binding Path="AnnulerPaiementCommand"/>
                                </Button.Command>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircle" Margin="0,0,5,0"/>
                                    <TextBlock Text="Annuler le paiement"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="White"
                                    Height="36">
                                <Button.Command>
                                    <Binding Path="MarquerPayeCommand"/>
                                </Button.Command>
                                <Button.Visibility>
                                    <Binding Path="EstPaye">
                                        <Binding.Converter>
                                            <StaticResource ResourceKey="InverseBoolToVisibilityConverter"/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle" Margin="0,0,5,0"/>
                                    <TextBlock Text="Marquer comme payé"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Contenu détaillé -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne gauche -->
                    <StackPanel Grid.Column="0">
                        <!-- Informations générales -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📋 Informations générales"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Numéro de mandat -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Numéro de mandat"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.NumeroMandat}"
                                             FontSize="16"
                                             FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Bordereau -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Bordereau"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Mandat.Bordereau}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mandat.Bordereau}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="Non renseigné"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="Foreground" Value="#757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Mois -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Mois"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.Mois}"
                                             FontSize="14"/>
                                </StackPanel>

                                <!-- Date d'émission -->
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="Date d'émission"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.DateEmission, StringFormat=dd/MM/yyyy}"
                                             FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Engagement -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🔗 Engagement lié"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Numéro engagement -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Numéro d'engagement"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.Engagement.NumeroEngagement}"
                                             FontSize="14"
                                             FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Tiers -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Tiers"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.Engagement.Tiers.Nom}"
                                             FontSize="14"/>
                                </StackPanel>

                                <!-- Exercice -->
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="Exercice"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.Engagement.Exercice.Libelle}"
                                             FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Objet et Motif -->
                        <materialDesign:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="📝 Description"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Objet -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Objet"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Mandat.Objet}"
                                             FontSize="14"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Motif -->
                                <StackPanel>
                                    <TextBlock Text="Motif / Description détaillée"
                                             FontSize="11"
                                             Foreground="#757575"
                                             Margin="0,0,0,5"/>
                                    <Border Background="#F5F5F5"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10">
                                        <TextBlock Text="{Binding Mandat.Motif}"
                                                 FontSize="13"
                                                 TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mandat.Motif}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Aucun motif renseigné"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>

                    <!-- Colonne droite -->
                    <StackPanel Grid.Column="2">
                        <!-- Montants -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="💰 Décomposition des montants"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Montant brut -->
                                <Border Background="#E3F2FD"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="Montant Brut"
                                                 FontSize="12"
                                                 Foreground="#1976D2"
                                                 DockPanel.Dock="Left"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Mandat.MontantBrut, StringFormat={}{0:N0} GNF}"
                                                 FontSize="16"
                                                 FontWeight="Bold"
                                                 Foreground="#1976D2"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- RTS -->
                                <Border Background="#FFEBEE"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="RTS (Retenue à la Source)"
                                                 FontSize="12"
                                                 Foreground="#D32F2F"
                                                 DockPanel.Dock="Left"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Mandat.Rts, StringFormat={}{0:N0} GNF}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#D32F2F"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Autres précomptes -->
                                <Border Background="#FFF3E0"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,15">
                                    <DockPanel>
                                        <TextBlock Text="Autres précomptes"
                                                 FontSize="12"
                                                 Foreground="#F57C00"
                                                 DockPanel.Dock="Left"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Mandat.AutresPrecomptes, StringFormat={}{0:N0} GNF}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#F57C00"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <Separator Margin="0,0,0,15"/>

                                <!-- Montant net -->
                                <Border Background="#E8F5E9"
                                        BorderBrush="#4CAF50"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Padding="15">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="MONTANT NET À PAYER"
                                                     FontSize="11"
                                                     Foreground="#388E3C"
                                                     FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Mandat.MontantNet, StringFormat={}{0:N0} GNF}"
                                                     FontSize="24"
                                                     FontWeight="Bold"
                                                     Foreground="#2E7D32"
                                                     Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Montant en lettres -->
                        <materialDesign:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="🔤 Montant en lettres"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <Border Background="#F5F5F5"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12">
                                    <TextBlock Text="{Binding Mandat.MontantLettre}"
                                             FontSize="13"
                                             TextWrapping="Wrap"
                                             FontStyle="Italic"
                                             Foreground="#424242"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>