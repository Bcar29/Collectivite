<Page x:Class="Collectivite.Views.Pages.DroitAuComptantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Loaded="Page_Loaded"
      Title="Droits au Comptant">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Converters pour les modes de règlement -->
        <local:EspeceToBoolConverter x:Key="EspeceConverter"/>
        <local:VirementToBoolConverter x:Key="VirementConverter"/>
        <local:ChequeToBoolConverter x:Key="ChequeConverter"/>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
        <local:ModeReglementToBadgeColorConverter x:Key="ModeReglementToBadgeColorConverter"/>
    </Page.Resources>

    <materialDesign:DialogHost Identifier="DroitAuComptantDialog" 
                               IsOpen="{Binding IsDialogOpen}"
                               CloseOnClickAway="False">

        <!-- ═══════════════════════════════════════ -->
        <!-- DIALOG: AJOUTER / MODIFIER UNE OPÉRATION -->
        <!-- ═══════════════════════════════════════ -->
        <materialDesign:DialogHost.DialogContent>
            <Border MinWidth="550" MaxWidth="650" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête du dialog -->
                    <Border Grid.Row="0" 
                            Background="{Binding DialogHeaderColor}" 
                            Padding="24,20" 
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding DialogTitle}" 
                                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding DialogSubtitle}" 
                                           FontSize="13" Foreground="#B3FFFFFF" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding FermerDialogCommand}"
                                    Foreground="White" Margin="-8,-8,0,0">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps du dialog -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel Margin="24,20">

                            <!-- Section Imputation (désactivée en mode modification) -->
                            <TextBlock Text="IMPUTATION"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       Margin="0,0,0,10"/>

                            <ComboBox materialDesign:HintAssist.Hint="Sélectionner une imputation *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding Imputations}"
                                      SelectedItem="{Binding SelectedImputation}"
                                      DisplayMemberPath="DisplayText"
                                      IsEnabled="{Binding IsCreationMode}"
                                      Margin="0,0,0,20"/>

                            <!-- Section Informations -->
                            <TextBlock Text="INFORMATIONS"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date -->
                                <DatePicker Grid.Column="0"
                                            materialDesign:HintAssist.Hint="Date *"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding DialogDate}"
                                            Margin="0,0,0,15"/>

                                <!-- Comptable -->
                                <TextBox Grid.Column="2"
                                         materialDesign:HintAssist.Hint="Comptable *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding DialogComptable, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,15"/>
                            </Grid>

                            <!-- Tiers (optionnel) -->
                            <ComboBox materialDesign:HintAssist.Hint="Tiers (optionnel)"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding TiersList}"
                                      SelectedItem="{Binding SelectedTiers}"
                                      DisplayMemberPath="NomComplet"
                                      Margin="0,0,0,15"/>

                            <!-- Motifs -->
                            <TextBox materialDesign:HintAssist.Hint="Motifs / Observations"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding DialogMotifs, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinLines="2"
                                     MaxLines="4"
                                     Margin="0,0,0,20"/>

                            <!-- Section Encaissement -->
                            <TextBlock Text="ENCAISSEMENT"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       Margin="0,0,0,10"/>

                            <!-- Montant -->
                            <TextBox materialDesign:HintAssist.Hint="Montant (GNF) *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding DialogMontant, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,15"/>

                            <!-- Mode de règlement -->
                            <TextBlock Text="Mode de règlement"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <RadioButton Content="Espèces" 
                                             IsChecked="{Binding DialogModeReglement, Converter={StaticResource EspeceConverter}}"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Margin="0,0,10,0"/>

                                <RadioButton Content="Virement" 
                                             IsChecked="{Binding DialogModeReglement, Converter={StaticResource VirementConverter}}"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Margin="0,0,10,0"/>

                                <RadioButton Content="Chèque" 
                                             IsChecked="{Binding DialogModeReglement, Converter={StaticResource ChequeConverter}}"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"/>
                            </StackPanel>

                            <!-- Champs Virement -->
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                                    Visibility="{Binding IsVirementVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Détails du virement" 
                                               FontSize="12" FontWeight="SemiBold" 
                                               Foreground="#1565C0" Margin="0,0,0,10"/>

                                    <TextBox materialDesign:HintAssist.Hint="Référence virement *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding DialogRefVirement, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBox materialDesign:HintAssist.Hint="N° compte bénéficiaire"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding DialogNumBanque, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <!-- Champs Chèque -->
                            <Border Background="#FFF8E1" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                                    Visibility="{Binding IsChequeVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Détails du chèque" 
                                               FontSize="12" FontWeight="SemiBold" 
                                               Foreground="#FF8F00" Margin="0,0,0,10"/>

                                    <TextBox materialDesign:HintAssist.Hint="Référence chèque *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding DialogRefCheque, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Boutons du dialog -->
                    <Border Grid.Row="2" Background="#FAFAFA" Padding="24,16" 
                            CornerRadius="0,0,12,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler"
                                    Command="{Binding FermerDialogCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,12,0"
                                    Height="40" Padding="20,0"/>

                            <Button Command="{Binding EnregistrerOperationCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{Binding DialogButtonColor}"
                                    BorderBrush="{Binding DialogButtonColor}"
                                    Height="40" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding DialogButtonIcon}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DialogButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- ═══════════════════════════════════════ -->
        <!-- CONTENU PRINCIPAL -->
        <!-- ═══════════════════════════════════════ -->
        <Grid>
            <!-- Overlay de chargement -->
            <Grid Background="#80000000" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                  Panel.ZIndex="999">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                               Value="0"
                               Width="60"
                               Height="60"/>
                    <TextBlock Text="Chargement..." 
                               Foreground="White"
                               FontSize="16"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Contenu -->
            <Grid Margin="30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="CashRegister" 
                                                 Width="32" Height="32"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Droits au Comptant"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Gestion des encaissements directs"
                                       FontSize="13"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <!-- Bouton Rafraîchir -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ChargerDonneesCommand}"
                                Margin="0,0,10,0"
                                Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,8,0"/>
                                <TextBlock Text="Rafraîchir"/>
                            </StackPanel>
                        </Button>

                        <!-- Bouton Ajouter -->
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding OuvrirDialogCommand}"
                                Background="#4CAF50"
                                BorderBrush="#4CAF50"
                                Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter une opération"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Statistiques -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total opérations -->
                    <materialDesign:Card Grid.Column="0" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,0,15,0">
                                <materialDesign:PackIcon Kind="FormatListNumbered" 
                                                         Width="28" Height="28" 
                                                         Foreground="#1976D2"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nombre d'opérations"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalOperations}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Total montant -->
                    <materialDesign:Card Grid.Column="2" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="0,0,15,0">
                                <materialDesign:PackIcon Kind="CashCheck" 
                                                         Width="28" Height="28" 
                                                         Foreground="#4CAF50"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total encaissé"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalMontantFormate}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Résultats filtrés -->
                    <materialDesign:Card Grid.Column="4" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="12" Margin="0,0,15,0">
                                <materialDesign:PackIcon Kind="Filter" 
                                                         Width="28" Height="28" 
                                                         Foreground="#FF9800"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Résultats filtrés"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Text="{Binding ResultatsFiltresCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FF9800"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- ZONE DE FILTRES -->
                <materialDesign:Card Grid.Row="2" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titre des filtres -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="FilterVariant" 
                                                     Width="20" Height="20" 
                                                     Foreground="#1976D2"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Filtres de recherche"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Champs de filtre -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche par numéro d'ordre -->
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Rechercher par N° ordre..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding FiltreNumeroOrdre, UpdateSourceTrigger=PropertyChanged}"
                                     Height="50">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AppliquerFiltresCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Date début -->
                            <DatePicker Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Date début"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding FiltreDateDebut}"
                                        Height="50"/>

                            <!-- Date fin -->
                            <DatePicker Grid.Column="4"
                                        materialDesign:HintAssist.Hint="Date fin"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding FiltreDateFin}"
                                        Height="50"/>

                            <!-- Mode de règlement -->
                            <ComboBox Grid.Column="6"
                                      materialDesign:HintAssist.Hint="Mode"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding ModesReglementFiltre}"
                                      SelectedItem="{Binding FiltreModeReglement}"
                                      Height="45"/>

                            <!-- Boutons -->
                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding AppliquerFiltresCommand}"
                                        Background="#1976D2"
                                        BorderBrush="#1976D2"
                                        Height="45"
                                        Padding="15,0"
                                        Margin="0,0,10,0"
                                        ToolTip="Appliquer les filtres">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Rechercher" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding ReinitialiserFiltresCommand}"
                                        Height="45"
                                        Padding="15,0"
                                        ToolTip="Réinitialiser les filtres">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilterRemove" Width="20" Height="20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Réinitialiser" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- Liste des opérations -->
                <materialDesign:Card Grid.Row="3" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding DroitsAuComptantFiltres}"
                                  SelectedItem="{Binding SelectedDroit}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  RowHeight="55"
                                  HeadersVisibility="Column">

                            <DataGrid.Columns>
                                <!-- N° Ordre -->
                                <DataGridTextColumn Header="N° Ordre" 
                                                    Binding="{Binding NumeroOrdre}" 
                                                    Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Date -->
                                <DataGridTextColumn Header="Date" 
                                                    Binding="{Binding DateOrdreFormatee}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Imputation -->
                                <DataGridTextColumn Header="Imputation" 
                                                    Binding="{Binding Imputation}" 
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Débiteur -->
                                <DataGridTextColumn Header="Débiteur" 
                                                    Binding="{Binding Debiteur}" 
                                                    Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant -->
                                <DataGridTextColumn Header="Montant" 
                                                    Binding="{Binding MontantEncaisseFormate}" 
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Mode (Badge coloré) -->
                                <DataGridTemplateColumn Header="Mode" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ModeReglement, Converter={StaticResource ModeReglementToBadgeColorConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModeReglement}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Colonne Actions -->
                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" 
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <!-- Bouton Voir -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="36" Height="36"
                                                        ToolTip="Voir les détails"
                                                        Command="{Binding DataContext.VoirDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Eye" 
                                                                             Width="20" Height="20" 
                                                                             Foreground="#1976D2"/>
                                                </Button>

                                                <!-- Bouton Modifier -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="36" Height="36"
                                                        ToolTip="Modifier"
                                                        Command="{Binding DataContext.ModifierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Pencil" 
                                                                             Width="20" Height="20" 
                                                                             Foreground="#FF9800"/>
                                                </Button>

                                                <!-- Bouton Supprimer -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="36" Height="36"
                                                        ToolTip="Supprimer"
                                                        Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" 
                                                                             Width="20" Height="20" 
                                                                             Foreground="#F44336"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Message si liste vide -->
                        <Border Background="#FAFAFA" 
                                Visibility="{Binding DroitsAuComptantFiltres.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Collapsed}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Padding="40" CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                         Width="64" Height="64" 
                                                         Foreground="#BDBDBD" 
                                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Aucune opération" 
                                           FontSize="18" 
                                           FontWeight="SemiBold"
                                           Foreground="#666666" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,15,0,5"/>
                                <TextBlock Text="Cliquez sur 'Ajouter une opération' pour commencer" 
                                           FontSize="13"
                                           Foreground="#999999" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Page>
