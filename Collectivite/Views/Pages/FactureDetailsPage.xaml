<Page x:Class="Collectivite.Views.Pages.FactureDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails de la facture">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1200">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding GoBackCommand}"
                                ToolTip="Retour"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                 Width="32" 
                                                 Height="32"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Détails de la facture" 
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Informations générales -->
                <materialDesign:Card Padding="30" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📋 Informations générales"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° Facture :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Facture.NumeroFacture}" FontSize="14"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Date facture :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding Facture.DateFacture, StringFormat='dd/MM/yyyy'}" FontSize="14"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tiers :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Facture.Tiers.NomComplet}" FontSize="14"/>

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Échéance :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Facture.DateEcheance, StringFormat='dd/MM/yyyy'}" FontSize="14"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Statut :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Facture.Status}" FontSize="14"/>

                            <TextBlock Grid.Row="4" Grid.Column="3" Text="Exercice :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding Facture.Exercice.Libelle}" FontSize="14"/>
                        </Grid>

                        <TextBlock Text="Description :" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Facture.Description}" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Détails de la facture -->
                <materialDesign:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🧾 Détails de la facture"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>

                        <DataGrid ItemsSource="{Binding Details}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  LoadingRow="DataGrid_LoadingRow"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" 
                                                    Width="50"
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>
                                <DataGridTextColumn Header="Libellé" 
                                                    Binding="{Binding Libelle}" 
                                                    Width="*" 
                                                    MinWidth="250"/>
                                <DataGridTextColumn Header="Quantité" 
                                                    Binding="{Binding Quantite}" 
                                                    Width="100"/>
                                <DataGridTemplateColumn Header="Prix unitaire" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrixUnitaire, StringFormat={}{0:N0} GNF}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#666"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Total" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding MontantTotal, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Récapitulatif -->
                <materialDesign:Card Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashCheck" 
                                                     Width="32" 
                                                     Height="32"
                                                     Foreground="#4CAF50"
                                                     Margin="0,0,15,0"/>
                            <TextBlock Text="Récapitulatif"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="MONTANT TOTAL"
                                       FontSize="14"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding MontantTotal, StringFormat={}{0:N0} GNF}"
                                       FontWeight="Bold"
                                       FontSize="28"
                                       Foreground="#4CAF50"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
