                        <materialDesign:PackIcon Kind="TrendingUp" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Investissement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>

                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource MaterialDesignDataGrid}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <Button Width="20" 
                                                  Height="20"
                                                  Padding="0"
                                                  Margin="0,0,5,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Style="{StaticResource MaterialDesignFlatButton}">
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" 
                                                                       Width="16" 
                                                                       Height="16"/>
                                            </Button>
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                     VerticalAlignment="Center"
                                                     FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" 
                                              Binding="{Binding BudgetLine.Nommenclature.Article}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" 
                                              Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" 
                                              Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Intitulé" 
                                              Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                              Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" 
                                              Binding="{Binding BudgetLine.MontantDefinitif, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Montant Emis" 
                                              Binding="{Binding BudgetLine.MontantRealise, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Montant Recouvré" 
                                              Binding="{Binding BudgetLine.MontantEntreSortie, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Taux Recouvrement" 
                                              Binding="{Binding BudgetLine.TauxEntreSortie, StringFormat={}{0:N2} %}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Reste Recouvré" 
                                              Binding="{Binding BudgetLine.ResteEntreSortie, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 3 : Dépense - Fonctionnement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
