<Page x:Class="Collectivite.Views.Pages.CompteGestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:Utils="clr-namespace:Collectivite.Utils"
      Unloaded="Page_Unloaded"
      Language="fr-FR"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>
        <Utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- 🆕 Convertisseur pour les couleurs de fond -->
        <Utils:BackgroundColorConverter x:Key="BackgroundColorConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="999"
              Grid.RowSpan="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Onglets -->
        <TabControl Grid.Row="1" 
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="20,0,20,20">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 1 : Recette - Fonctionnement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashPlus" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Fonctionnement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>

                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource MaterialDesignDataGrid}">

                        <!-- 🆕 Style des lignes avec couleur de fond -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- 🆕 Colonne avec expander et chapitre -->
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <!-- Bouton expander -->
                                            <Button Width="20" 
                                                  Height="20"
                                                  Padding="0"
                                                  Margin="0,0,5,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Style="{StaticResource MaterialDesignFlatButton}">
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" 
                                                                       Width="16" 
                                                                       Height="16"/>
                                            </Button>

                                            <!-- Texte du chapitre -->
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                     VerticalAlignment="Center"
                                                     FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" 
                                              Binding="{Binding BudgetLine.Nommenclature.Article}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" 
                                              Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" 
                                              Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Intitulé" 
                                              Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                              Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" 
                                              Binding="{Binding BudgetLine.MontantDefinitif, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Montant Emis" 
                                              Binding="{Binding BudgetLine.MontantRealise, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Montant Recouvré" 
                                              Binding="{Binding BudgetLine.MontantEntreSortie, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Taux Recouvrement" 
                                              Binding="{Binding BudgetLine.TauxEntreSortie, StringFormat={}{0:N2} %}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Reste Recouvré" 
                                              Binding="{Binding BudgetLine.ResteEntreSortie, StringFormat={}{0:N3} GNF}" 
                                              Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 2 : Recette - Investissement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
