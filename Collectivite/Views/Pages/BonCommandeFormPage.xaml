<Page x:Class="Collectivite.Views.Pages.BonCommandeFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Formulaire Bon de Commande">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- Converter pour afficher le message quand la liste est vide -->
        <Style x:Key="EmptyMessageStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Details.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageTitle}" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Section 1 : Informations du Bon de Commande -->
                <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📋 Informations du Bon de Commande"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Numéro (readonly) -->
                            <TextBox Grid.Row="0" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="N° Bon de Commande (automatique)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding BonCommande.Numero}"
                                     IsReadOnly="True"
                                     Background="#F0F0F0"
                                     Margin="0,0,0,15"/>

                            <!-- Date -->
                            <DatePicker Grid.Row="0" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Date de création *"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding BonCommande.DateCreation}"
                                        Margin="0,0,0,15"/>

                            <!-- Expression de Besoin - Utilise SelectedExpressionBesoin -->
                            <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                      materialDesign:HintAssist.Hint="Expression de Besoin * (sélectionner pour charger les lignes)"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding ExpressionBesoins}"
                                      SelectedItem="{Binding SelectedExpressionBesoin, Mode=TwoWay}"
                                      Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Numero}" FontWeight="SemiBold"/>
                                            <TextBlock Text=" - " Foreground="#666"/>
                                            <TextBlock Text="{Binding DateCreation, StringFormat='dd/MM/yyyy'}" Foreground="#666"/>
                                            <TextBlock Text=" (" Foreground="#999"/>
                                            <TextBlock Text="{Binding Details.Count}" Foreground="#1976D2" FontWeight="SemiBold"/>
                                            <TextBlock Text=" lignes)" Foreground="#999"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Info sur l'expression de besoin sélectionnée -->
                        <Border Background="#E3F2FD" 
                                CornerRadius="8" 
                                Padding="15"
                                Visibility="{Binding SelectedExpressionBesoin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" 
                                                         Width="20" 
                                                         Height="20"
                                                         Foreground="#1976D2"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock VerticalAlignment="Center" Foreground="#1976D2">
                                    <Run Text="Expression de besoin sélectionnée : "/>
                                    <Run Text="{Binding SelectedExpressionBesoin.Numero, Mode=OneWay, FallbackValue='-'}" FontWeight="Bold"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding NombreLignes, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" ligne(s) chargée(s)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Section 2 : Détails du Bon de Commande -->
                <materialDesign:Card Grid.Row="2" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Titre section -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="📦 Détails du Bon de Commande"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1976D2"/>
                                <Border Background="#E8F5E9" 
                                        CornerRadius="12" 
                                        Padding="8,4" 
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="#4CAF50" FontWeight="SemiBold">
                                        <Run Text="{Binding NombreLignes, Mode=OneWay}"/>
                                        <Run Text=" ligne(s)"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding AddDetailCommand}"
                                    Height="36"
                                    DockPanel.Dock="Right">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" 
                                                           Width="18" 
                                                           Height="18"
                                                           Margin="0,0,5,0"/>
                                    <TextBlock Text="Ajouter une ligne"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Message si aucune expression de besoin sélectionnée -->
                        <Border Background="#FFF8E1" 
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15"
                                Visibility="{Binding SelectedExpressionBesoin, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF8F00"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <TextBlock Text="Sélectionnez une expression de besoin pour charger automatiquement les lignes."
                                           VerticalAlignment="Center"
                                           Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- En-tête du tableau -->
                        <Border Background="#1976D2" 
                                CornerRadius="8,8,0,0"
                                Padding="15,10"
                                Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Désignation" 
                                           Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Quantité" 
                                           Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Prix Unitaire (GNF)" 
                                           Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Total" 
                                           Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="" 
                                           Foreground="White"/>
                            </Grid>
                        </Border>

                        <!-- Liste des détails -->
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" 
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1,0,1,1"
                                            Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Désignation -->
                                            <TextBox Grid.Column="0"
                                                     materialDesign:HintAssist.Hint="Désignation *"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="10,8"/>

                                            <!-- Quantité -->
                                            <TextBox Grid.Column="2"
                                                     materialDesign:HintAssist.Hint="Qté *"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Center"
                                                     Padding="10,8">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" 
                                                                Command="{Binding DataContext.RecalculerDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>

                                            <!-- Prix unitaire -->
                                            <TextBox Grid.Column="4"
                                                     materialDesign:HintAssist.Hint="Prix Unit. *"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding PrixUnitaire, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     HorizontalContentAlignment="Right"
                                                     Padding="10,8">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" 
                                                                Command="{Binding DataContext.RecalculerDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>

                                            <!-- Total (calculé automatiquement) -->
                                            <Border Grid.Column="6"
                                                    Background="#E3F2FD"
                                                    CornerRadius="4"
                                                    Padding="10,8"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Supprimer -->
                                            <Button Grid.Column="8"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Supprimer cette ligne"
                                                    VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Message si aucun détail -->
                        <Border Background="#FFF3E0" 
                                CornerRadius="0,0,8,8"
                                Padding="20"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1,0,1,1"
                                Style="{StaticResource EmptyMessageStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <TextBlock Text="Aucune ligne. Sélectionnez une expression de besoin ou cliquez sur 'Ajouter une ligne'."
                                           VerticalAlignment="Center"
                                           Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- Montant total -->
                        <Border Background="#E8F5E9" 
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,20,0,0"
                                BorderBrush="#4CAF50"
                                BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashCheck" 
                                                             Width="28" 
                                                             Height="28"
                                                             Foreground="#4CAF50"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="MONTANT TOTAL :"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MontantTotal, StringFormat={}{0:N0} GNF}"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           Foreground="#4CAF50"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Buttons -->
                <StackPanel Grid.Row="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,10,0,20">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Annuler"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,15,0"
                            Width="120"
                            Height="45"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            Width="180"
                            Height="45"
                            Background="#4CAF50"
                            BorderBrush="#4CAF50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" 
                                                     Width="20" 
                                                     Height="20"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Enregistrer" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
