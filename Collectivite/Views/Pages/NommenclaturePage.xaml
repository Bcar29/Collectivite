<Page x:Class="Collectivite.Views.Pages.NommenclaturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Nomenclatures">

    <Page.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Converter pour les enums -->
        <ObjectDataProvider x:Key="NatureTypeValues" 
                          MethodName="GetValues" 
                          ObjectType="{x:Type models:NatureType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:NatureType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="SectionTypeValues" 
                          MethodName="GetValues" 
                          ObjectType="{x:Type models:SectionType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SectionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour le TreeView -->
        <Style x:Key="NomenclatureTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Style pour les TreeViewItems avec indentation -->
        <Style x:Key="NomenclatureTreeViewItemStyle" TargetType="TreeViewItem" 
               BasedOn="{StaticResource MaterialDesignTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Template pour afficher un élément de nomenclature dans le TreeView -->
        <HierarchicalDataTemplate x:Key="NomenclatureTreeTemplate" 
                                ItemsSource="{Binding Children}">
            <Border Background="Transparent"
                    Padding="8,6"
                    CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Code (Chapitre-Article-Paragraphe-SousParagraphe) -->
                    <Border Grid.Column="0"
                            Background="#F5F5F5"
                            CornerRadius="4"
                            Padding="8,4"
                            MinWidth="80">
                        <TextBlock Text="{Binding CodeComplet}"
                                 FontFamily="Consolas"
                                 FontWeight="SemiBold"
                                 FontSize="13"
                                 Foreground="#424242"
                                 HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Intitulé -->
                    <TextBlock Grid.Column="2"
                             Text="{Binding Nommenclature.Intitule}"
                             FontSize="14"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Triggers>
                                    <!-- Racines en gras -->
                                    <DataTrigger Binding="{Binding Level}" Value="0">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="15"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Boutons d'actions -->
                    <StackPanel Grid.Column="3"
                              Orientation="Horizontal"
                              Margin="10,0,0,0">
                        
                        <!-- Bouton Modifier -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              ToolTip="Modifier"
                              Width="32"
                              Height="32"
                              Command="{Binding DataContext.OppenEditNommenclatureCommand, 
                                      RelativeSource={RelativeSource AncestorType=Page}}"
                              CommandParameter="{Binding Nommenclature}">
                            <materialDesign:PackIcon Kind="Pencil" 
                                                   Width="18"
                                                   Height="18"
                                                   Foreground="#1976D2"/>
                        </Button>

                        <!-- Bouton Supprimer -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              ToolTip="Supprimer"
                              Width="32"
                              Height="32"
                              Command="{Binding DataContext.DeleteNommenclatureCommand, 
                                      RelativeSource={RelativeSource AncestorType=Page}}"
                              CommandParameter="{Binding Nommenclature}"
                              Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Delete" 
                                                   Width="18"
                                                   Height="18"
                                                   Foreground="#F44336"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

    </Page.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY DE CHARGEMENT
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
             ═══════════════════════════════════════════════════════════ -->
        <StackPanel Margin="20">

            <!-- ───────────────────────────────────────────────────
                 HEADER AVEC BOUTON D'AJOUT
                 ─────────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <!-- Titre -->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                           Width="32" 
                                           Height="32"
                                           Foreground="#1976D2"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Nomenclatures" 
                             FontSize="24"
                             FontWeight="SemiBold"
                             Margin="15,0,0,0"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bouton Ajouter -->
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="40"
                        Command="{Binding OppenAddNommenclatureCommand}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" 
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Nouvelle Nomenclature" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 ONGLETS PRINCIPAUX : RECETTE / DÉPENSE
                 ═══════════════════════════════════════════════════════════ -->
            <materialDesign:Card UniformCornerRadius="8">
                <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                    <!-- ═══════════════════════════════════════════════════
                         ONGLET RECETTE
                         ═══════════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowUp" 
                                                       Width="24" 
                                                       Height="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#388E3C"/>
                                <TextBlock Text="RECETTES" 
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Sous-onglets Fonctionnement / Investissement -->
                        <TabControl Style="{StaticResource MaterialDesignFilledTabControl}"
                                  Margin="10">

                            <!-- Recette - Fonctionnement -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog" 
                                                               Width="18" 
                                                               Height="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Fonctionnement" 
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>

                                <!-- TreeView pour Recette - Fonctionnement -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding RecetteFonctionnementTree}"
                                            
                                            ItemContainerStyle="{StaticResource NomenclatureTreeViewItemStyle}"
                                            ItemTemplate="{StaticResource NomenclatureTreeTemplate}">
                                        <!-- Message si vide -->
                                        <TreeView.Style>
                                            <Style TargetType="TreeView" BasedOn="{StaticResource NomenclatureTreeViewStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecetteFonctionnementTree.Count}" Value="0">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <Border Background="#F5F5F5" 
                                                                          CornerRadius="8"
                                                                          Padding="40"
                                                                          Margin="20">
                                                                        <StackPanel HorizontalAlignment="Center" 
                                                                                  VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                                                                   Width="64" 
                                                                                                   Height="64"
                                                                                                   Foreground="#BDBDBD"
                                                                                                   HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Aucune nomenclature" 
                                                                                     FontSize="16"
                                                                                     Foreground="#757575"
                                                                                     Margin="0,20,0,0"
                                                                                     HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Cliquez sur 'Nouvelle Nomenclature' pour commencer" 
                                                                                     FontSize="13"
                                                                                     Foreground="#9E9E9E"
                                                                                     Margin="0,8,0,0"
                                                                                     HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.Style>
                                    </TreeView>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Recette - Investissement -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartLine" 
                                                               Width="18" 
                                                               Height="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Investissement" 
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>

                                <!-- TreeView pour Recette - Investissement -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding RecetteInvestissementTree}"
                                            
                                            ItemContainerStyle="{StaticResource NomenclatureTreeViewItemStyle}"
                                            ItemTemplate="{StaticResource NomenclatureTreeTemplate}">
                                        <TreeView.Style>
                                            <Style TargetType="TreeView" BasedOn="{StaticResource NomenclatureTreeViewStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecetteInvestissementTree.Count}" Value="0">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <Border Background="#F5F5F5" CornerRadius="8" Padding="40" Margin="20">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Aucune nomenclature" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.Style>
                                    </TreeView>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════
                         ONGLET DÉPENSE
                         ═══════════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowDown" 
                                                       Width="24" 
                                                       Height="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#D32F2F"/>
                                <TextBlock Text="DÉPENSES" 
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Sous-onglets Fonctionnement / Investissement -->
                        <TabControl Style="{StaticResource MaterialDesignFilledTabControl}"
                                  Margin="10">

                            <!-- Dépense - Fonctionnement -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog" 
                                                               Width="18" 
                                                               Height="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Fonctionnement" 
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>

                                <!-- TreeView pour Dépense - Fonctionnement -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding DepenseFonctionnementTree}"
                                            
                                            ItemContainerStyle="{StaticResource NomenclatureTreeViewItemStyle}"
                                            ItemTemplate="{StaticResource NomenclatureTreeTemplate}">
                                        <TreeView.Style>
                                            <Style TargetType="TreeView" BasedOn="{StaticResource NomenclatureTreeViewStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DepenseFonctionnementTree.Count}" Value="0">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <Border Background="#F5F5F5" CornerRadius="8" Padding="40" Margin="20">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Aucune nomenclature" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.Style>
                                    </TreeView>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Dépense - Investissement -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartLine" 
                                                               Width="18" 
                                                               Height="18"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Investissement" 
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>

                                <!-- TreeView pour Dépense - Investissement -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding DepenseInvestissementTree}"
                                            
                                            ItemContainerStyle="{StaticResource NomenclatureTreeViewItemStyle}"
                                            ItemTemplate="{StaticResource NomenclatureTreeTemplate}">
                                        <TreeView.Style>
                                            <Style TargetType="TreeView" BasedOn="{StaticResource NomenclatureTreeViewStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DepenseInvestissementTree.Count}" Value="0">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <Border Background="#F5F5F5" CornerRadius="8" Padding="40" Margin="20">
                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Aucune nomenclature" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.Style>
                                    </TreeView>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </TabItem>

                </TabControl>
            </materialDesign:Card>

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOG MODAL AJOUT/MODIFICATION
             ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                 CloseOnClickAway="False"
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="600" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="BookmarkMultiple" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grid pour organiser les champs -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chapitre -->
                        <TextBox Grid.Row="0" Grid.Column="0"
                               materialDesign:HintAssist.Hint="Chapitre"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding DialogNommenclature.Chapitre, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="10"/>

                        <!-- Article -->
                        <TextBox Grid.Row="0" Grid.Column="2"
                               materialDesign:HintAssist.Hint="Article"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding DialogNommenclature.Article, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="10"/>

                        <!-- Paragraphe -->
                        <TextBox Grid.Row="2" Grid.Column="0"
                               materialDesign:HintAssist.Hint="Paragraphe"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding DialogNommenclature.Paragraphe, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="10"/>

                        <!-- Sous-Paragraphe -->
                        <TextBox Grid.Row="2" Grid.Column="2"
                               materialDesign:HintAssist.Hint="Sous-Paragraphe"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding DialogNommenclature.SousParagraphe, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="10"/>

                        <!-- Intitulé (obligatoire) -->
                        <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                               materialDesign:HintAssist.Hint="Intitulé *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding DialogNommenclature.Intitule, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="200"/>

                        <!-- Nature -->
                        <ComboBox Grid.Row="6" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Nature *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding Source={StaticResource NatureTypeValues}}"
                                SelectedItem="{Binding DialogNommenclature.Nature}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="20" Height="20" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="ArrowUp"/>
                                                    <Setter Property="Foreground" Value="#388E3C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Depense">
                                                            <Setter Property="Kind" Value="ArrowDown"/>
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Section -->
                        <ComboBox Grid.Row="6" Grid.Column="2"
                                materialDesign:HintAssist.Hint="Section *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding Source={StaticResource SectionTypeValues}}"
                                SelectedItem="{Binding DialogNommenclature.Section}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="20" Height="20" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="Cog"/>
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Investissement">
                                                            <Setter Property="Kind" Value="ChartLine"/>
                                                            <Setter Property="Foreground" Value="#F57C00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Parent -->
                        <ComboBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                                materialDesign:HintAssist.Hint="Parent (optionnel)"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding Nommenclatures}"
                                SelectedValue="{Binding DialogNommenclature.ParentId}"
                                SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Code -->
                                        <Border Background="#F5F5F5"
                                              CornerRadius="4"
                                              Padding="6,2"
                                              Margin="0,0,8,0">
                                            <TextBlock FontFamily="Consolas"
                                                     FontSize="11"
                                                     Foreground="#666">
                                                <Run Text="{Binding Chapitre, Mode=OneWay}"/>
                                                <Run Text="-" Foreground="#999"/>
                                                <Run Text="{Binding Article, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                        <!-- Intitulé -->
                                        <TextBlock Text="{Binding Intitule}"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Note explicative -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="* Champs obligatoires"
                                 FontSize="11"
                                 Foreground="#666"
                                 FontStyle="Italic"
                                 Margin="5,0,0,0"/>

                        <!-- Boutons -->
                        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
                                  Orientation="Horizontal" 
                                  HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                  Content="Annuler"
                                  Command="{Binding CancelNommenclatureCommand}"
                                  Margin="0,0,10,0"
                                  Width="100"/>

                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                  Content="Enregistrer"
                                  Command="{Binding SaveNommenclatureCommand}"
                                  Width="120"/>
                        </StackPanel>

                    </Grid>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>