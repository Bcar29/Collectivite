<Page x:Class="Collectivite.Views.Pages.BonCommandeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Unloaded="Page_Unloaded"
      Title="Bons de Commande">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Bons de Commande" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                         Command="{Binding GoForwardCommand}"
                         Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowForward" Margin="0,0,5,0" Height="20" Width="30"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddPageCommand}"
                            Height="36"
                            Margin="0,0,10,0"
                            Visibility="{Binding CanCreateBonCommande, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouveau Bon"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="1" Padding="0">
              <Grid>
                <DataGrid ItemsSource="{Binding BonCommandes}"
                          SelectedItem="{Binding SelectedBonCommande}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                    <DataGrid.Columns>
                        <!-- Numéro -->
                        <DataGridTextColumn Header="N° Bon" 
                                          Binding="{Binding Numero}" 
                                          Width="150"
                                          FontWeight="SemiBold"/>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date Création" 
                                          Binding="{Binding DateCreation, StringFormat='dd/MM/yyyy'}" 
                                          Width="120"/>

                        <!-- Expression de Besoin -->
                        <DataGridTextColumn Header="Expression de Besoin" 
                                          Binding="{Binding ExpressionBesoin.Numero}" 
                                          Width="180"
                                          FontWeight="SemiBold"/>

                        <!-- Exercice -->
                        <DataGridTextColumn Header="Exercice" 
                                          Binding="{Binding ExpressionBesoin.Exercice.Libelle}" 
                                          Width="160"/>

                        <!-- Nombre de détails -->
                        <DataGridTemplateColumn Header="Nombre de Lignes" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E3F2FD" 
                                            CornerRadius="12"
                                            Padding="8,4">
                                        <TextBlock Text="{Binding Details.Count}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1976D2"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenDetailsPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanViewBonCommande, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#4CAF50" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Voir les détails"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenEditPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditBonCommande, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Modifier"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDeleteBonCommande, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Supprimer"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Message si vide -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BonCommandes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucun bon de commande" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cliquez sur 'Nouveau Bon' pour commencer" FontSize="13" Foreground="#9E9E9E" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
              </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>