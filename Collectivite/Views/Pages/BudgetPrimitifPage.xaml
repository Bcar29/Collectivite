<Page x:Class="Collectivite.Views.Pages.BudgetPrimitifPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Title="Gestion des Budgets Primitifs"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>
        <utils:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <utils:StatusAtLeastConverter x:Key="StatusAtLeastConverter"/>
        <utils:RecetteDepenseToSoldeConverter x:Key="RecetteDepenseToSoldeConverter"/>
        <utils:RecetteDepenseToSoldeBrushConverter x:Key="RecetteDepenseToSoldeBrushConverter"/>
        <utils:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Style partagé pour les DataGrid de la Vue d'Ensemble : lignes zébrées + séparateurs -->
        <Style x:Key="VueEnsembleRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VueEnsembleHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY DE CHARGEMENT
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL AVEC DEUX SECTIONS
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     SECTION 1 : DÉBALLER POUR VALIDER LE BUDGET
                     ═══════════════════════════════════════════════════════════ -->
                <Expander materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                          IsExpanded="False"
                          Margin="0,0,0,30">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline"
                                                      Width="24" Height="24"
                                                      Foreground="{StaticResource AppPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Déballer pour valider le budget"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Suivez la progression de chaque exercice : Brouillon → Approuvé → Validé"
                                           Style="{StaticResource SectionSubtitleTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Margin="0,15,0,0"
                                Visibility="{Binding CanViewBudgetPrimitif, Converter={StaticResource BoolToVis}}">

                        <!-- État vide -->
                        <Border Background="White"
                                CornerRadius="8"
                                Padding="30"
                                Visibility="{Binding BudgetPrimitifs, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                          Width="40" Height="40"
                                                          Foreground="{StaticResource AppMutedTextBrush}"
                                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Aucun budget primitif pour l'exercice courant"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding BudgetPrimitifs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card UniformCornerRadius="10"
                                                          Padding="20"
                                                          Margin="0,0,0,15">
                                        <StackPanel>

                                            <!-- En-tête : exercice + badge de statut -->
                                            <Grid Margin="0,0,0,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Exercice.Libelle}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>

                                                <!-- Badge Brouillon -->
                                                <Border Grid.Column="1" Background="#EEEEEE" CornerRadius="12" Padding="12,5">
                                                    <Border.Visibility>
                                                        <Binding Path="Status" Converter="{StaticResource EnumToVisibilityConverter}" ConverterParameter="DRAFT"/>
                                                    </Border.Visibility>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Brouillon" FontSize="11" FontWeight="SemiBold" Foreground="#757575" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Badge Approuvé -->
                                                <Border Grid.Column="1" Background="{StaticResource AppWarningLightBrush}" CornerRadius="12" Padding="12,5">
                                                    <Border.Visibility>
                                                        <Binding Path="Status" Converter="{StaticResource EnumToVisibilityConverter}" ConverterParameter="APPROVED"/>
                                                    </Border.Visibility>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Foreground="{StaticResource AppWarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Approuvé" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppWarningBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Badge Validé -->
                                                <Border Grid.Column="1" Background="{StaticResource AppSuccessLightBrush}" CornerRadius="12" Padding="12,5">
                                                    <Border.Visibility>
                                                        <Binding Path="Status" Converter="{StaticResource EnumToVisibilityConverter}" ConverterParameter="VALIDATED"/>
                                                    </Border.Visibility>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Validé" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Stepper de progression Brouillon → Approuvé → Validé -->
                                            <Grid Margin="10,0,10,25">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Étape 1 : Brouillon -->
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="APPROVED"/>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{StaticResource AppSuccessBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="APPROVED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="APPROVED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Brouillon" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>

                                                <!-- Liaison 1→2 -->
                                                <Border Grid.Column="1" Height="3" VerticalAlignment="Center" Margin="4,0" CornerRadius="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AppBorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="APPROVED"/>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="{StaticResource AppSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Étape 2 : Approuvé -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AppBorderBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="Visible">
                                                                        <DataTrigger.Binding>
                                                                            <Binding Path="Status" Converter="{StaticResource EnumToVisibilityConverter}" ConverterParameter="APPROVED"/>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{StaticResource AppSuccessBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Approuvé" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding DateApprobation, StringFormat='dd/MM/yyyy'}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AppMutedTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{Binding DateApprobation, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <!-- Liaison 2→3 -->
                                                <Border Grid.Column="3" Height="3" VerticalAlignment="Center" Margin="4,0" CornerRadius="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AppBorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="{StaticResource AppSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Étape 3 : Validé -->
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AppBorderBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{StaticResource AppSuccessBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <Binding Path="Status" Converter="{StaticResource StatusAtLeastConverter}" ConverterParameter="VALIDATED"/>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Validé" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding DateValidation, StringFormat='dd/MM/yyyy'}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AppMutedTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{Binding DateValidation, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Montants + actions -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Background="{StaticResource AppSuccessLightBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                                                        <StackPanel>
                                                            <TextBlock Text="Recettes" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}"/>
                                                            <TextBlock Text="{Binding MontantRecette, StringFormat={}{0:N0} GNF}"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AppSuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#FFEBEE" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                                                        <StackPanel>
                                                            <TextBlock Text="Dépenses" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}"/>
                                                            <TextBlock Text="{Binding MontantDepense, StringFormat={}{0:N0} GNF}"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AppDangerBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#ECEFF1" CornerRadius="8" Padding="14,10" MinWidth="150">
                                                        <StackPanel>
                                                            <TextBlock Text="Solde" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}"/>
                                                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource RecetteDepenseToSoldeConverter}">
                                                                        <Binding Path="MontantRecette"/>
                                                                        <Binding Path="MontantDepense"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                                <TextBlock.Foreground>
                                                                    <MultiBinding Converter="{StaticResource RecetteDepenseToSoldeBrushConverter}">
                                                                        <Binding Path="MontantRecette"/>
                                                                        <Binding Path="MontantDepense"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">

                                                    <!-- Bouton Approuver -->
                                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                            Background="{StaticResource AppWarningBrush}"
                                                            BorderBrush="{StaticResource AppWarningBrush}"
                                                            Height="40"
                                                            Command="{Binding DataContext.OpenApprovalDialogCommand,
                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanApproveBudget,
                                                            RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <Button.Visibility>
                                                            <Binding Path="Status"
                                                                   Converter="{StaticResource EnumToVisibilityConverter}"
                                                                   ConverterParameter="DRAFT"/>
                                                        </Button.Visibility>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CheckCircleOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Approuver le budget" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Bouton Valider -->
                                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                            Background="{StaticResource AppSuccessBrush}"
                                                            BorderBrush="{StaticResource AppSuccessBrush}"
                                                            Height="40"
                                                            Command="{Binding DataContext.OpenValidationDialogCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.CanValidateBudget,
                                                                                RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <Button.Visibility>
                                                            <Binding Path="Status"
                                                               Converter="{StaticResource EnumToVisibilityConverter}"
                                                               ConverterParameter="APPROVED"/>
                                                        </Button.Visibility>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Valider le budget" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Badge Validé -->
                                                    <Border Background="{StaticResource AppSuccessLightBrush}"
                                                            CornerRadius="8"
                                                            Padding="14,10">
                                                        <Border.Visibility>
                                                            <Binding Path="Status"
                                                               Converter="{StaticResource EnumToVisibilityConverter}"
                                                               ConverterParameter="VALIDATED"/>
                                                        </Border.Visibility>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CheckDecagram"
                                                               Width="18"
                                                               Height="18"
                                                               Foreground="{StaticResource AppSuccessBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                            <TextBlock Text="Budget validé"
                                                                 FontWeight="SemiBold"
                                                                 Foreground="{StaticResource AppSuccessBrush}"
                                                                 VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                        </StackPanel>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <!-- ═══════════════════════════════════════════════════════════
                     SECTION 2 : VUE D'ENSEMBLE (SYNTHÈSE)
                     ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,30,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ExportPdfCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Exporter PDF"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PrintCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding LoadVueEnsembleCommand}"
                                Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                                <TextBlock Text="Rafraîchir"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Onglets Vue d'Ensemble -->
                <TabControl SelectedIndex="{Binding SelectedVueEnsembleTabIndex}"
                            Margin="0,0,0,20">

                    <!-- Recette - Fonctionnement -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus" 
                                                       Width="20" 
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Recette - Fonctionnement" 
                                         VerticalAlignment="Center" 
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </TabItem.Header>

                        <materialDesign:Card Padding="0" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding VueEnsembleDisplayedLines}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="48"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                                      AlternationCount="2"
                                      RowStyle="{StaticResource VueEnsembleRowStyle}"
                                      ColumnHeaderStyle="{StaticResource VueEnsembleHeaderStyle}"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="150"/>
                                    <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                                    <DataGridTextColumn Header="Montant Définitif"
                                                        Binding="{Binding MontantDefinitif, StringFormat={}{0:N0} GNF}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </TabItem>

                    <!-- Recette - Investissement -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrendingUp" 
                                                       Width="20" 
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Recette - Investissement" 
                                         VerticalAlignment="Center" 
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </TabItem.Header>

                        <materialDesign:Card Padding="0" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding VueEnsembleDisplayedLines}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="48"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                                      AlternationCount="2"
                                      RowStyle="{StaticResource VueEnsembleRowStyle}"
                                      ColumnHeaderStyle="{StaticResource VueEnsembleHeaderStyle}"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="150"/>
                                    <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                                    <DataGridTextColumn Header="Montant Définitif"
                                                        Binding="{Binding MontantDefinitif, StringFormat={}{0:N0} GNF}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </TabItem>

                    <!-- Dépense - Fonctionnement -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMinus" 
                                                       Width="20" 
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Dépense - Fonctionnement" 
                                         VerticalAlignment="Center" 
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </TabItem.Header>

                        <materialDesign:Card Padding="0" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding VueEnsembleDisplayedLines}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="48"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                                      AlternationCount="2"
                                      RowStyle="{StaticResource VueEnsembleRowStyle}"
                                      ColumnHeaderStyle="{StaticResource VueEnsembleHeaderStyle}"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="150"/>
                                    <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                                    <DataGridTextColumn Header="Montant Définitif"
                                                        Binding="{Binding MontantDefinitif, StringFormat={}{0:N0} GNF}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </TabItem>

                    <!-- Dépense - Investissement -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrendingDown" 
                                                       Width="20" 
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Dépense - Investissement" 
                                         VerticalAlignment="Center" 
                                         FontWeight="Medium"/>
                            </StackPanel>
                        </TabItem.Header>

                        <materialDesign:Card Padding="0" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding VueEnsembleDisplayedLines}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="48"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                                      AlternationCount="2"
                                      RowStyle="{StaticResource VueEnsembleRowStyle}"
                                      ColumnHeaderStyle="{StaticResource VueEnsembleHeaderStyle}"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="150"/>
                                    <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                                    <DataGridTextColumn Header="Montant Définitif"
                                                        Binding="{Binding MontantDefinitif, StringFormat={}{0:N0} GNF}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </TabItem>

                </TabControl>

               
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - APPROBATION DU BUDGET
         ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsApprovalDialogOpen}" 
                           CloseOnClickAway="False"
                           Panel.ZIndex="1001">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#FF9800" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="Approbation du Budget Primitif"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="White"/>
                                    <TextBlock Text="Approuver le budget avant validation"
                                     FontSize="12"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Date d'approbation -->
                            <DatePicker SelectedDate="{Binding DateApprobationDateTime, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Date d'approbation *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              Margin="0,0,0,20"/>

                            <!-- Avertissement -->
                            <Border Background="#FFF3E0"
                          CornerRadius="8"
                          Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,10,0"/>
                                        <TextBlock TextWrapping="Wrap" 
                                         FontSize="13" 
                                         Foreground="#F57C00"
                                         FontWeight="Medium">
                                    <Run Text="ℹ️ Information"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" 
                                     FontSize="12" 
                                     Foreground="#666"
                                     Margin="34,0,0,0">
                                <Run Text="L'approbation du budget permet de le rendre disponible pour la validation."/>
                                <LineBreak/>
                                <Run Text="Une fois approuvé, le budget pourra être validé avec un fichier de validation."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                      Background="#FAFAFA" 
                      BorderBrush="#E0E0E0" 
                      BorderThickness="0,1,0,0"
                      Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Command="{Binding CancelApprovalCommand}"
                              Width="100"
                              Height="40"
                              Margin="0,0,10,0"/>

                                <Button Command="{Binding ConfirmApprovalCommand}"
                              Width="140"
                              Height="40"
                              Background="#FF9800"
                              BorderBrush="#FF9800"
                              Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="Approuver" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>


        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - VALIDATION DU BUDGET
         ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsValidationDialogOpen}" 
                           CloseOnClickAway="False"
                           Panel.ZIndex="1002">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#4CAF50" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="Validation du Budget Primitif"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="White"/>
                                    <TextBlock Text="Cette action est irréversible"
                                     FontSize="12"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Date de validation -->
                            <DatePicker SelectedDate="{Binding DateValidationDateTime, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Date de validation *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              Margin="0,0,0,15"/>

                            <!-- Fichier de validation -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Fichier de validation"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     Foreground="#424242"
                                     Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding FileNameValidation, Mode=OneWay}"
                                         IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Aucun fichier sélectionné"
                                         Margin="0,0,10,0"/>

                                    <Button Grid.Column="1"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding SelectFileCommand}"
                                        Content="Parcourir"
                                        Width="100"/>
                                </Grid>
                            </StackPanel>

                            <!-- Avertissement -->
                            <Border Background="#FFF3E0"
                          CornerRadius="8"
                          Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="AlertCircle" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,10,0"/>
                                        <TextBlock TextWrapping="Wrap" 
                                         FontSize="13" 
                                         Foreground="#F57C00"
                                         FontWeight="Medium">
                                    <Run Text="⚠️ Attention : Action irréversible"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" 
                                     FontSize="12" 
                                     Foreground="#666"
                                     Margin="34,0,0,0">
                                <Run Text="Une fois le budget validé, vous ne pourrez plus :"/>
                                <LineBreak/>
                                <Run Text="• Modifier les lignes budgétaires"/>
                                <LineBreak/>
                                <Run Text="• Ajouter ou supprimer des lignes"/>
                                <LineBreak/>
                                <Run Text="• Modifier le budget primitif"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                      Background="#FAFAFA" 
                      BorderBrush="#E0E0E0" 
                      BorderThickness="0,1,0,0"
                      Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Command="{Binding CancelValidationCommand}"
                              Width="100"
                              Height="40"
                              Margin="0,0,10,0"/>

                                <Button Command="{Binding ConfirmValidationCommand}"
                              Width="140"
                              Height="40"
                              Background="#4CAF50"
                              BorderBrush="#4CAF50"
                              Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="Valider" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>