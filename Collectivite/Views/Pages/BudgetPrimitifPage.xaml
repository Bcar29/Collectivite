<Page x:Class="Collectivite.Views.Pages.BudgetPrimitifPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Title="Gestion des Budgets Primitifs"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>
        <utils:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY DE CHARGEMENT
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- ───────────────────────────────────────────────────
                     HEADER AVEC BOUTON D'AJOUT
                     ─────────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,20">
                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMultiple" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Budgets Primitifs" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ───────────────────────────────────────────────────
                     DATAGRID DES BUDGETS PRIMITIFS
                     ─────────────────────────────────────────────────── -->
                <materialDesign:Card Padding="0" 
                                   UniformCornerRadius="8">
                    <DataGrid ItemsSource="{Binding BudgetPrimitifs}"
                              SelectedItem="{Binding SelectedBudgetPrimitif}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Visibility="{Binding CanViewBudgetPrimitif, Converter={StaticResource BoolToVis}}"
                              SelectionMode="Single"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>

                            <!-- Exercice -->
                            <DataGridTextColumn Header="Exercice" 
                                              Binding="{Binding Exercice.Libelle}"
                                              Width="200"
                                              FontWeight="Medium"/>

                            <!-- Année (si disponible dans Exercice) 
                            <DataGridTemplateColumn Header="Année" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarRange" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#1976D2"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Exercice.Annee}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn> -->

                            <!-- Montant Total -->
                            <DataGridTemplateColumn Header="Montant total" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                                   Width="18" 
                                                                   Height="18"
                                                                   Foreground="#388E3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#388E3C">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} GNF">
                                                        <Binding Path="MontantTotal"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Montant Recette -->
                            <DataGridTemplateColumn Header="Montant des recettes" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                                   Width="18" 
                                                                   Height="18"
                                                                   Foreground="#388E3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#388E3C">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} GNF">
                                                        <Binding Path="MontantRecette"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Montant Depense -->
                            <DataGridTemplateColumn Header="Montant des depense" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                                   Width="18" 
                                                                   Height="18"
                                                                   Foreground="#388E3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#388E3C">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} GNF">
                                                        <Binding Path="MontantDepense"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date d'approbation -->
                            <DataGridTemplateColumn Header="Date d'approbation" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarCheck" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#F57C00"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateApprobation, StringFormat='dd/MM/yyyy'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Date de validation -->
                            <DataGridTemplateColumn Header="Date de validation" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarCheck" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#F57C00"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateValidation, StringFormat='dd/MM/yyyy'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Statut (optionnel) 
                            <DataGridTemplateColumn Header="Statut" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F5E9"
                                              CornerRadius="12"
                                              Padding="10,4">
                                            <TextBlock Text="Voté"
                                                     Foreground="#388E3C"
                                                     FontSize="11"
                                                     FontWeight="SemiBold"
                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn> -->

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                      HorizontalAlignment="Center">

                                            <!-- Bouton Approuver (visible seulement si statut = DRAFT)
                                                 et activable uniquement si l'utilisateur possède la
                                                 permission fonctionnelle Budget.Approve -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                      ToolTip="Approuver le budget"
                      Command="{Binding DataContext.OpenApprovalDialogCommand, 
                              RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding}"
                      Margin="4,0"
                      IsEnabled="{Binding DataContext.CanApproveBudget,
                                          RelativeSource={RelativeSource AncestorType=Page}}">
                                                <Button.Visibility>
                                                    <Binding Path="Status" 
                               Converter="{StaticResource EnumToVisibilityConverter}" 
                               ConverterParameter="DRAFT"/>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                           Foreground="#FF9800"
                                           Width="20"
                                           Height="20"/>
                                            </Button>

                                            <!-- Bouton Valider (visible seulement si statut = APPROVED)
                                                 et activable uniquement si l'utilisateur possède la
                                                 permission fonctionnelle Budget.Validate -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                      ToolTip="Valider le budget"
                      Command="{Binding DataContext.OpenValidationDialogCommand, 
                              RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding}"
                      Margin="4,0"
                      IsEnabled="{Binding DataContext.CanValidateBudget,
                                          RelativeSource={RelativeSource AncestorType=Page}}">
                                                <Button.Visibility>
                                                    <Binding Path="Status" 
                               Converter="{StaticResource EnumToVisibilityConverter}" 
                               ConverterParameter="APPROVED"/>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="CheckCircle" 
                                           Foreground="#4CAF50"
                                           Width="20"
                                           Height="20"/>
                                            </Button>

                                            <!-- Badge Validé (visible seulement si statut = VALIDATED) -->
                                            <Border Background="#E8F5E9"
                      CornerRadius="12"
                      Padding="8,4"
                      Margin="4,0">
                                                <Border.Visibility>
                                                    <Binding Path="Status" 
                               Converter="{StaticResource EnumToVisibilityConverter}" 
                               ConverterParameter="VALIDATED"/>
                                                </Border.Visibility>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckCircle" 
                                               Width="16" 
                                               Height="16"
                                               Foreground="#4CAF50"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                                    <TextBlock Text="Validé" 
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="#4CAF50"
                                 VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bouton Supprimer (visible seulement si statut = APPROVED) -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="Supprimer"
                                          Command="{Binding DataContext.DeleteBudgetPrimitifCommand, 
                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                          CommandParameter="{Binding}"
                                          Margin="4,0"
                                          IsEnabled="{Binding DataContext.CanDeleteBudgetPrimitif, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <Button.Visibility>
                                        <Binding Path="Status" 
                                               Converter="{StaticResource EnumToVisibilityConverter}" 
                                               ConverterParameter="APPROVED"/>
                                        </Button.Visibility>
                                        <materialDesign:PackIcon Kind="Delete" 
                                           Foreground="#F44336"
                                           Width="20"
                                           Height="20"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - APPROBATION DU BUDGET
         ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsApprovalDialogOpen}" 
                           CloseOnClickAway="False"
                           Panel.ZIndex="1001">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#FF9800" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="Approbation du Budget Primitif"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="White"/>
                                    <TextBlock Text="Approuver le budget avant validation"
                                     FontSize="12"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Date d'approbation -->
                            <DatePicker SelectedDate="{Binding DateApprobationDateTime, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Date d'approbation *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              Margin="0,0,0,20"/>

                            <!-- Avertissement -->
                            <Border Background="#FFF3E0"
                          CornerRadius="8"
                          Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,10,0"/>
                                        <TextBlock TextWrapping="Wrap" 
                                         FontSize="13" 
                                         Foreground="#F57C00"
                                         FontWeight="Medium">
                                    <Run Text="ℹ️ Information"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" 
                                     FontSize="12" 
                                     Foreground="#666"
                                     Margin="34,0,0,0">
                                <Run Text="L'approbation du budget permet de le rendre disponible pour la validation."/>
                                <LineBreak/>
                                <Run Text="Une fois approuvé, le budget pourra être validé avec un fichier de validation."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                      Background="#FAFAFA" 
                      BorderBrush="#E0E0E0" 
                      BorderThickness="0,1,0,0"
                      Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Command="{Binding CancelApprovalCommand}"
                              Width="100"
                              Height="40"
                              Margin="0,0,10,0"/>

                                <Button Command="{Binding ConfirmApprovalCommand}"
                              Width="140"
                              Height="40"
                              Background="#FF9800"
                              BorderBrush="#FF9800"
                              Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="Approuver" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - VALIDATION DU BUDGET
         ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsValidationDialogOpen}" 
                           CloseOnClickAway="False"
                           Panel.ZIndex="1002">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#4CAF50" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>
                                <StackPanel>
                                    <TextBlock Text="Validation du Budget Primitif"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="White"/>
                                    <TextBlock Text="Cette action est irréversible"
                                     FontSize="12"
                                     Foreground="White"
                                     Opacity="0.9"
                                     Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Date de validation -->
                            <DatePicker SelectedDate="{Binding DateValidationDateTime, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Date de validation *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              Margin="0,0,0,15"/>

                            <!-- Fichier de validation -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Fichier de validation"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     Foreground="#424242"
                                     Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding FileNameValidation, Mode=OneWay}"
                                         IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Aucun fichier sélectionné"
                                         Margin="0,0,10,0"/>
                                    
                                    <Button Grid.Column="1"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding SelectFileCommand}"
                                        Content="Parcourir"
                                        Width="100"/>
                                </Grid>
                            </StackPanel>

                            <!-- Avertissement -->
                            <Border Background="#FFF3E0"
                          CornerRadius="8"
                          Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="AlertCircle" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,10,0"/>
                                        <TextBlock TextWrapping="Wrap" 
                                         FontSize="13" 
                                         Foreground="#F57C00"
                                         FontWeight="Medium">
                                    <Run Text="⚠️ Attention : Action irréversible"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" 
                                     FontSize="12" 
                                     Foreground="#666"
                                     Margin="34,0,0,0">
                                <Run Text="Une fois le budget validé, vous ne pourrez plus :"/>
                                <LineBreak/>
                                <Run Text="• Modifier les lignes budgétaires"/>
                                <LineBreak/>
                                <Run Text="• Ajouter ou supprimer des lignes"/>
                                <LineBreak/>
                                <Run Text="• Modifier le budget primitif"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                      Background="#FAFAFA" 
                      BorderBrush="#E0E0E0" 
                      BorderThickness="0,1,0,0"
                      Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Command="{Binding CancelValidationCommand}"
                              Width="100"
                              Height="40"
                              Margin="0,0,10,0"/>

                                <Button Command="{Binding ConfirmValidationCommand}"
                              Width="140"
                              Height="40"
                              Background="#4CAF50"
                              BorderBrush="#4CAF50"
                              Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="Valider" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>