<Page x:Class="Collectivite.Views.Pages.CommunePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="{StaticResource AppPageBackgroundBrush}"
      Title="Profil de la Commune">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid>
        <!-- OVERLAY DE CHARGEMENT -->
        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..."
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- EN-TÊTE -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="City" Style="{StaticResource PageHeaderIconStyle}"/>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Profil de la Commune" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SectionSubtitleTextStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding OpenDetailCommuneCommand}"
                                Visibility="{Binding IsNewCommune, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Détails démographiques" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding ExportPdfCommand}"
                                Visibility="{Binding IsNewCommune, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Foreground="{StaticResource AppDangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Exporter PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- FORMULAIRE PROFIL -->
                <materialDesign:Card Padding="20" Margin="0,0,0,15" IsEnabled="{Binding CanEditForm}">
                    <StackPanel>
                        <TextBlock Text="Identité" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,15"/>

                        <TextBox materialDesign:HintAssist.Hint="Nom de la commune *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding CurrentCommune.Nom, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,0,0,15"
                               MaxLength="200"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Type de commune *"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ItemsSource="{Binding TypesCommuneDisponibles}"
                                    SelectedItem="{Binding SelectedTypeCommuneItem}"
                                    DisplayMemberPath="Libelle"
                                    utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                            <DatePicker Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Date de création"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    SelectedDate="{Binding CurrentCommuneDateCreation}"
                                    Language="fr-FR"
                                    IsEnabled="{Binding IsNewCommune}"/>
                        </Grid>

                        <TextBox materialDesign:HintAssist.Hint="Région Administrative *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding CurrentCommune.Region, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,0,0,15"
                               MaxLength="200"/>

                        <TextBox materialDesign:HintAssist.Hint="Préfecture"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding CurrentCommune.Prefecture, UpdateSourceTrigger=PropertyChanged}"
                               MaxLength="200"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Margin="0,0,0,15" IsEnabled="{Binding CanEditForm}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="MapMarkerDistance" Width="20" Height="20" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Distances géographiques" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Distances en kilomètres depuis les différents centres administratifs."
                                 Style="{StaticResource SectionSubtitleTextStyle}"
                                 Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                   materialDesign:HintAssist.Hint="Dist. Chef-Lieu Province (km)"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding CurrentCommune.DistanceChefLieuProvince, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="2"
                                   materialDesign:HintAssist.Hint="Dist. Chef-Lieu Région (km)"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding CurrentCommune.DistanceChefLieuRegion, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="4"
                                   materialDesign:HintAssist.Hint="Dist. Capitale (km)"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding CurrentCommune.DistanceCapitale, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <TextBlock Text="* Champs obligatoires"
                         FontSize="11"
                         Foreground="{StaticResource AppMutedTextBrush}"
                         FontStyle="Italic"
                         Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                          Content="Annuler les modifications"
                          Command="{Binding CancelCommuneCommand}"
                          Margin="0,0,10,0"
                          Height="40"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                          Command="{Binding SaveCommuneCommand}"
                          Width="140"
                          Height="40"
                          Visibility="{Binding CanEditForm, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
