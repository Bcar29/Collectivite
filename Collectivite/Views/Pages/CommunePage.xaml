<Page x:Class="Collectivite.Views.Pages.CommunePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5"
      Title="Gestion des Communes">

    <Page.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY DE CHARGEMENT
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CONTENU PRINCIPAL
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- ───────────────────────────────────────────────────
                     HEADER AVEC BOUTON D'AJOUT
                     ─────────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,20">
                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="City" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Communes" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Bouton Ajouter -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Command="{Binding OppenAddCommuneCommand}"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding CanCreateCommune}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Nouvelle Commune" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ───────────────────────────────────────────────────
                     DATAGRID DES COMMUNES
                     ─────────────────────────────────────────────────── -->
                <materialDesign:Card Padding="0" 
                                   UniformCornerRadius="8">
                    <DataGrid ItemsSource="{Binding Communes}"
                              SelectedItem="{Binding SelectedCommune}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Visibility="{Binding CanViewCommune, Converter={StaticResource BoolToVis}}"
                              SelectionMode="Single"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>

                            <!-- Nom de la commune -->
                            <DataGridTextColumn Header="Nom de la Commune" 
                                              Binding="{Binding Nom}"
                                              Width="250"
                                              FontWeight="Medium"/>

                            <!-- Distance Chef-Lieu Province -->
                            <DataGridTemplateColumn Header="Dist. Chef-Lieu Province" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MapMarkerDistance" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#1976D2"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2} km">
                                                        <Binding Path="DistanceChefLieuProvince"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Distance Chef-Lieu Région -->
                            <DataGridTemplateColumn Header="Dist. Chef-Lieu Région" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MapMarkerDistance" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#388E3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2} km">
                                                        <Binding Path="DistanceChefLieuRegion"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Distance Capitale -->
                            <DataGridTemplateColumn Header="Dist. Capitale" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MapMarkerDistance" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#F57C00"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2} km">
                                                        <Binding Path="DistanceCapitale"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date de création -->
                            <DataGridTemplateColumn Header="Date de Création" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarClock" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#757575"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateCreation, StringFormat='dd/MM/yyyy'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                  HorizontalAlignment="Center">

                                            <!-- Bouton Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Modifier"
                                                  Command="{Binding DataContext.OppenEditCommuneCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0"
                                                  IsEnabled="{Binding DataContext.CanEditCommune, RelativeSource={RelativeSource AncestorType=Page}}">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                                                       Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Bouton Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Supprimer"
                                                  Command="{Binding DataContext.DeleteCommuneCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0"
                                                  IsEnabled="{Binding DataContext.CanDeleteCommune, RelativeSource={RelativeSource AncestorType=Page}}">
                                                <materialDesign:PackIcon Kind="Delete" 
                                                                       Foreground="#F44336"/>
                                            </Button>

                                            <!-- ✅ Bouton Détail (NOUVEAU) -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="Voir les détails"
                                              Command="{Binding DataContext.OpenDetailCommuneCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"
                                              Margin="4,0">
                                                <materialDesign:PackIcon Kind="InformationOutline" 
                                           Foreground="#009688"/>
                                            </Button>

                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOG MODAL AJOUT/MODIFICATION
             ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                 CloseOnClickAway="False"
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="550" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="City" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nom de la commune -->
                    <TextBox materialDesign:HintAssist.Hint="Nom de la commune *"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding DialogCommune.Nom, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,15"
                           MaxLength="200"/>

                    <!-- Section Distances -->
                    <Border 
                          CornerRadius="8"
                          
                          Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Information" 
                                                       Width="20" 
                                                       Height="20"
                                                       Foreground="#1976D2"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Distances géographiques" 
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         Foreground="#1976D2"
                                         VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Indiquez les distances en kilomètres depuis les différents centres administratifs"
                                     FontSize="12"
                                     Foreground="#424242"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,15"/>

                            <!-- Grid pour les distances -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Distance Chef-Lieu Province -->
                                <TextBox Grid.Row="0" Grid.Column="0"
                                       materialDesign:HintAssist.Hint="Dist. Chef-Lieu Province (km)"
                                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                       Text="{Binding DialogCommune.DistanceChefLieuProvince, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveCommuneCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Distance Chef-Lieu Région -->
                                <TextBox Grid.Row="0" Grid.Column="2"
                                       materialDesign:HintAssist.Hint="Dist. Chef-Lieu Région (km)"
                                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                       Text="{Binding DialogCommune.DistanceChefLieuRegion, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveCommuneCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Distance Capitale -->
                                <TextBox Grid.Row="2" Grid.Column="0"
                                       materialDesign:HintAssist.Hint="Dist. Capitale (km)"
                                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                       Margin="0,0,0,15"
                                       Text="{Binding DialogCommune.DistanceCapitale, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveCommuneCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Date de création -->
                                <DatePicker materialDesign:HintAssist.Hint="Date de création"
                                      Grid.Row="2" Grid.Column="2"
                                      SelectedDate="{Binding DialogCommuneDateCreation}"
                                      Language="fr-FR"
                                      Margin="0,0,0,15">
                                    <DatePicker.Style>
                                        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                                            <Style.Triggers>
                                                <!-- En mode édition, désactiver le DatePicker -->
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DatePicker.Style>
                                </DatePicker>


                                <!-- Espace vide pour alignement -->
                                <Border Grid.Row="2" Grid.Column="2"/>

                            </Grid>
                        </StackPanel>
                    </Border>


                    <!-- Note explicative -->
                    <TextBlock Text="* Champs obligatoires"
                             FontSize="11"
                             Foreground="#666"
                             FontStyle="Italic"
                             Margin="0,0,0,15"/>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" 
                              HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                              Content="Annuler"
                              Command="{Binding CancelCommuneCommand}"
                              Margin="0,0,10,0"
                              Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Enregistrer"
                              Command="{Binding SaveCommuneCommand}"
                              Width="120">
                            <Button.CommandParameter>
                                <Binding RelativeSource="{RelativeSource Self}"/>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>