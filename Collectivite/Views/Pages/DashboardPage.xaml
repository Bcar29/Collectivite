<Page x:Class="Collectivite.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:Collectivite.Utils"
      Background="#F5F5F5"
      Title="Dashboard">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Converters personnalisés -->
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <!-- Style pour les cards d'indicateurs -->
        <Style x:Key="IndicatorCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Card_MouseLeave"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les cards de section -->
        <Style x:Key="SectionCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
        </Style>

        <!-- Style pour les boutons d'action rapide -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  Padding="20">
        <StackPanel>
            
            <!-- Section des indicateurs principaux -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1 : Budget Total -->
                <materialDesign:Card Grid.Column="0" 
                                   Style="{StaticResource IndicatorCardStyle}"
                                   x:Name="Card1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header avec icône -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E3F2FD" 
                                      CornerRadius="8"
                                      Width="48" 
                                      Height="48"
                                      Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="CashMultiple" 
                                                           Width="28" 
                                                           Height="28"
                                                           Foreground="#1976D2"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Budget Total" 
                                         FontSize="14"
                                         FontWeight="Medium"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Montant -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock Text="15 000 000 000" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <TextBlock Text="GNF" 
                                     FontSize="14"
                                     Foreground="#757575"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Variation -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="16" 
                                                   Height="16"
                                                   Foreground="#4CAF50"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="+5.2%" 
                                     FontSize="13"
                                     Foreground="#4CAF50"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text=" vs mois dernier" 
                                     FontSize="12"
                                     Foreground="#9E9E9E"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Card 2 : Dépenses Engagées -->
                <materialDesign:Card Grid.Column="1" 
                                   Style="{StaticResource IndicatorCardStyle}"
                                   x:Name="Card2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFEBEE" 
                                      CornerRadius="8"
                                      Width="48" 
                                      Height="48"
                                      Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="TrendingDown" 
                                                           Width="28" 
                                                           Height="28"
                                                           Foreground="#F44336"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Dépenses Engagées" 
                                         FontSize="14"
                                         FontWeight="Medium"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock Text="8 450 000 000" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <TextBlock Text="GNF" 
                                     FontSize="14"
                                     Foreground="#757575"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingDown" 
                                                   Width="16" 
                                                   Height="16"
                                                   Foreground="#F44336"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="-2.8%" 
                                     FontSize="13"
                                     Foreground="#F44336"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text=" vs mois dernier" 
                                     FontSize="12"
                                     Foreground="#9E9E9E"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Card 3 : Recettes Perçues -->
                <materialDesign:Card Grid.Column="2" 
                                   Style="{StaticResource IndicatorCardStyle}"
                                   x:Name="Card3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E8F5E9" 
                                      CornerRadius="8"
                                      Width="48" 
                                      Height="48"
                                      Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="TrendingUp" 
                                                           Width="28" 
                                                           Height="28"
                                                           Foreground="#4CAF50"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Recettes Perçues" 
                                         FontSize="14"
                                         FontWeight="Medium"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock Text="12 800 000 000" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <TextBlock Text="GNF" 
                                     FontSize="14"
                                     Foreground="#757575"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="16" 
                                                   Height="16"
                                                   Foreground="#4CAF50"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="+8.5%" 
                                     FontSize="13"
                                     Foreground="#4CAF50"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text=" vs mois dernier" 
                                     FontSize="12"
                                     Foreground="#9E9E9E"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Card 4 : Solde Disponible -->
                <materialDesign:Card Grid.Column="3" 
                                   Style="{StaticResource IndicatorCardStyle}"
                                   x:Name="Card4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFF3E0" 
                                      CornerRadius="8"
                                      Width="48" 
                                      Height="48"
                                      Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="WalletOutline" 
                                                           Width="28" 
                                                           Height="28"
                                                           Foreground="#FF9800"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Solde Disponible" 
                                         FontSize="14"
                                         FontWeight="Medium"
                                         Foreground="#757575"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock Text="6 550 000 000" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="#212121"/>
                            <TextBlock Text="GNF" 
                                     FontSize="14"
                                     Foreground="#757575"
                                     Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="16" 
                                                   Height="16"
                                                   Foreground="#4CAF50"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="+3.4%" 
                                     FontSize="13"
                                     Foreground="#4CAF50"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text=" vs mois dernier" 
                                     FontSize="12"
                                     Foreground="#9E9E9E"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Section Graphiques -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Graphique en barres -->
                <materialDesign:Card Grid.Column="0" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Répartition par Nature et Section" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,20"/>
                        
                        <Canvas Height="300" x:Name="BarChartCanvas">
                            <!-- Le graphique sera dessiné ici par code-behind -->
                        </Canvas>

                        <!-- Légende -->
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center"
                                  Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Border Background="#4CAF50" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Recettes" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F44336" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Dépenses" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Graphique en courbes -->
                <materialDesign:Card Grid.Column="1" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Exécution Mensuelle" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,20"/>
                        
                        <Canvas Height="300" x:Name="LineChartCanvas">
                            <!-- Le graphique sera dessiné ici par code-behind -->
                        </Canvas>

                        <!-- Légende -->
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center"
                                  Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Border Background="#2196F3" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Recettes" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FF9800" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Dépenses" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Section Activités Récentes et Actions Rapides -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Activités Récentes -->
                <materialDesign:Card Grid.Column="0" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Activités Récentes" 
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                  Content="Voir tout"
                                  HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" 
                                          BorderThickness="0,0,0,1"
                                          Padding="0,12"
                                          Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icône 
                                            <Border Grid.Column="0"
                                                  Background="{Binding IconColor, Converter={StaticResource ColorToBrushConverter}}"
                                                  Width="40"
                                                  Height="40"
                                                  CornerRadius="20"
                                                  Opacity="0.15"
                                                  Margin="0,0,15,0">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                       Width="22"
                                                                       Height="22"
                                                                       Foreground="{Binding IconColor, Converter={StaticResource ColorToBrushConverter}}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                            </Border> -->

                                            <!-- Contenu -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                         FontSize="14"
                                                         FontWeight="Medium"
                                                         Foreground="#212121"
                                                         TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding RelativeTime}"
                                                             FontSize="12"
                                                             Foreground="#9E9E9E"/>
                                                    <TextBlock Text=" • "
                                                             FontSize="12"
                                                             Foreground="#9E9E9E"
                                                             Margin="5,0"
                                                             Visibility="{Binding Amount, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding FormattedAmount}"
                                                             FontSize="12"
                                                             Foreground="#9E9E9E"
                                                             Visibility="{Binding Amount, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Badge type 
                                            <Border Grid.Column="2"
                                                  Background="#F5F5F5"
                                                  CornerRadius="4"
                                                  Padding="8,4"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}"
                                                         FontSize="11"
                                                         Foreground="#757575"
                                                         FontWeight="Medium"/>
                                            </Border> -->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Actions Rapides -->
                <materialDesign:Card Grid.Column="1" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Actions Rapides" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,20"/>

                        <ItemsControl ItemsSource="{Binding QuickActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                          Command="{Binding Command}"
                                          Height="70"
                                          Margin="0,0,0,12"
                                          HorizontalContentAlignment="Left"
                                          Padding="16"
                                          Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                  Background="White"
                                                  Width="40"
                                                  Height="40"
                                                  CornerRadius="20"
                                                  Opacity="0.3"
                                                  Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                       Width="24"
                                                                       Height="24"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         Foreground="White"/>
                                                <TextBlock Text="{Binding Description}"
                                                         FontSize="11"
                                                         Foreground="White"
                                                         Opacity="0.9"
                                                         Margin="0,2,0,0"
                                                         TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
