<Page x:Class="Collectivite.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:Collectivite.Utils"
      Background="#F5F5F5"
      Title="Dashboard">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Converters personnalisés -->
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:CurrencyConverter x:Key="CurrencyConverter"/>
        <local:PercentageConverter x:Key="PercentageConverter"/>
 

        <!-- Style pour les cards d'indicateurs -->
        <Style x:Key="IndicatorCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Card_MouseLeave"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les cards de section -->
        <Style x:Key="SectionCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
        </Style>

        <!-- Style pour les boutons d'action rapide -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  Padding="20">

       
        <StackPanel>
            <!-- Overlay de chargement 
            <Grid Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999"
                Grid.RowSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0"
                         IsIndeterminate="True"
                         Width="60"
                         Height="60"/>
                    <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>-->
            <!-- Section des indicateurs principaux -->
            <ItemsControl ItemsSource="{Binding Indicators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Style="{StaticResource IndicatorCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header avec icône -->
                                <Grid Grid.Row="0" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="8"
                                              Width="48" 
                                              Height="48"
                                              Margin="0,0,12,0"
                                              Opacity="0.1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"/>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="8"
                                              Width="48" 
                                              Height="48"
                                              Margin="-48,0,12,0">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                   Width="28" 
                                                                   Height="28"
                                                                   Foreground="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" 
                                                 FontSize="14"
                                                 FontWeight="Medium"
                                                 Foreground="#757575"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Montant -->
                                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                    <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" 
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             Foreground="#212121"/>
                                    <TextBlock Text="GNF" 
                                             FontSize="14"
                                             Foreground="#757575"
                                             Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Variation -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" 
                                                           Height="16"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                                        <Setter Property="Kind" Value="TrendingUp"/>
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                        <Setter Property="Kind" Value="TrendingDown"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock FontSize="13"
                                             FontWeight="Medium"
                                             VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding PercentageChange, Converter={StaticResource PercentageConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text=" vs exercice dernier" 
                                             FontSize="12"
                                             Foreground="#9E9E9E"
                                             VerticalAlignment="Center"
                                             Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,20,0,20"
           HorizontalAlignment="Center">

                <!-- Graphique en barres -->
                <materialDesign:Card
        Width="500"
        Margin="10"
        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Répartition par Nature et Section"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

                        <Canvas Height="300"
                    x:Name="BarChartCanvas"/>

                        <!-- Légende -->
                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Border Background="#4CAF50" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Recettes" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F44336" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Dépenses" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Graphique en courbes -->
                <materialDesign:Card
        Width="900"
        Margin="10"
        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Exécution Mensuelle"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

                        <Canvas Height="300"
                    x:Name="LineChartCanvas"/>

                        <!-- Légende -->
                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Border Background="#2196F3" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Recettes" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FF9800" Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="Dépenses" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

            </WrapPanel>

            <!-- Section Activités Récentes et Actions Rapides -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Activités Récentes -->
                <materialDesign:Card Grid.Column="0" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Activités Récentes" 
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                  Content="Voir tout"
                                  HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" 
                                          BorderThickness="0,0,0,1"
                                          Padding="0,12"
                                          Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Contenu -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionTitle}"
                                                         FontSize="14"
                                                         FontWeight="Medium"
                                                         Foreground="#212121"
                                                         TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding PerformedBy}"
                                                             FontSize="12"
                                                             Foreground="Black"/>
                                                    <TextBlock Text=" • "
                                                             FontSize="12"
                                                             Foreground="Black"
                                                             Margin="5,0"/>
                                                    <TextBlock Text="{Binding RelativeTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                             FontSize="12"
                                                             Foreground="Black"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Badge type -->
                                            <Border Grid.Column="1"
                                                  Background="#F5F5F5"
                                                  CornerRadius="4"
                                                  Padding="8,4"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EntityType}"
                                                         FontSize="11"
                                                         Foreground="#757575"
                                                         FontWeight="Medium"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Actions Rapides -->
                <materialDesign:Card Grid.Column="1" 
                                   Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Actions Rapides" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,20"/>

                        <ItemsControl ItemsSource="{Binding QuickActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                          Command="{Binding Command}"
                                          Height="70"
                                          Margin="0,0,0,12"
                                          HorizontalContentAlignment="Left"
                                          Padding="16"
                                          Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                  Background="White"
                                                  Width="40"
                                                  Height="40"
                                                  CornerRadius="20"
                                                  Opacity="0.3"
                                                  Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                       Width="24"
                                                                       Height="24"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         Foreground="White"/>
                                                <TextBlock Text="{Binding Description}"
                                                         FontSize="11"
                                                         Foreground="White"
                                                         Opacity="0.9"
                                                         Margin="0,2,0,0"
                                                         TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>