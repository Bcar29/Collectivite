<Page x:Class="Collectivite.Views.Pages.ExpressionBesoinDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails de l'Expression de Besoin">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Retour"
                            DockPanel.Dock="Left"
                            Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardTextOutline" 
                                                 Width="32" 
                                                 Height="32"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Détails de l'Expression de Besoin" 
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Informations générales -->
                <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titre section -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="Informations Générales"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- Numéro -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="N° Expression de Besoin"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ExpressionBesoin.Numero}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Date de Création"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ExpressionBesoin.DateCreation, StringFormat='dd/MM/yyyy'}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Exercice -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Exercice "
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ExpressionBesoin.Exercice.Libelle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"/>
                        </StackPanel>

                        <!-- Nombre de lignes -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Nombre de lignes"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <Border Background="#E3F2FD" 
                                    CornerRadius="8"
                                    Padding="10,5"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Details.Count}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Détails de l'expression de besoin -->
                <materialDesign:Card Grid.Row="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Détails de l'Expression de Besoin"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- DataGrid des détails -->
                        <DataGrid ItemsSource="{Binding Details}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  LoadingRow="DataGrid_LoadingRow"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTextColumn Header="#" 
                                                  Width="50"
                                                  Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>

                                <!-- Nomenclature -->
                                <DataGridTextColumn Header="Code Nomenclature" 
                                                  Binding="{Binding Nommenclature.CodeNomenclature}" 
                                                  Width="150"
                                                  FontWeight="SemiBold"/>

                                <!-- Désignation -->
                                <DataGridTextColumn Header="Désignation" 
                                                  Binding="{Binding Designation}" 
                                                  Width="*" 
                                                  MinWidth="300"/>

                                <!-- Quantité -->
                                <DataGridTemplateColumn Header="Quantité" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="4" 
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding Quantite}"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>