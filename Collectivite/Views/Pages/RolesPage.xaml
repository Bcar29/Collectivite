<Page x:Class="Collectivite.Views.Pages.RolesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewModels="clr-namespace:Collectivite.ViewModels"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="MaterialBoolToVis"/>
        <utils:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <viewModels:RolesViewModel/>
    </Page.DataContext>

    <Grid>
        <!-- Loading overlay -->
        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="60"
                             Height="60"/>
                <TextBlock Text="Chargement..."
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="ShieldAccount"
                                             Width="32"
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des rôles"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Visibility="{Binding CanCreateRole, Converter={StaticResource BoolToVis}}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouveau rôle"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" />
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="1" Padding="0">
                <DataGrid ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"
                                            MinWidth="200"/>
                        <DataGridTextColumn Header="Statut" Width="120"
                                            Binding="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Actif;Inactif'}"/>
                        
                        <!-- COLONNE PERMISSIONS : Badge + Icône œil uniquement -->
                        <DataGridTemplateColumn Header="Permissions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Badge avec nombre de permissions -->
                                        <Border Background="#1976D2"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ShieldCheck"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Foreground="White"
                                                                         Margin="0,0,4,0"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} permission(s)">
                                                            <Binding Path="RolePermissions.Count"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Bouton ICÔNE ŒIL UNIQUEMENT (sans texte) -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.ShowPermissionsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Voir le détail des permissions">
                                            <materialDesign:PackIcon Kind="Eye" 
                                                                     Width="20" 
                                                                     Height="20"
                                                                     Foreground="#1976D2"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditRole, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Modifier"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDeleteRole, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Supprimer"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog d'édition de rôle -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                   CloseOnClickAway="False"
                                   Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="600" Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ShieldAccount"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#1976D2"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBox materialDesign:HintAssist.Hint="Nom *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRole.Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Description"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRole.Description, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <CheckBox Content="Rôle actif"
                              IsChecked="{Binding DialogRole.IsActive}"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Permissions disponibles"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>

                    <TextBox materialDesign:HintAssist.Hint="Rechercher une permission"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding PermissionFilterText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"/>

                    <ScrollViewer Height="220">
                        <ItemsControl ItemsSource="{Binding PermissionSelections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,10,10"
                                              ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CloseDialogCommand}"
                                Margin="0,0,10,0"
                                Width="110"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="140"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Dialog pour afficher les permissions d'un rôle -->
        <materialDesign:DialogHost IsOpen="{Binding IsPermissionsDialogOpen}"
                                   CloseOnClickAway="True"
                                   Panel.ZIndex="1001">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="500" Padding="20">
                    <StackPanel>
                        <!-- En-tête -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="ShieldCheck"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#1976D2"
                                                     Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Permissions du rôle"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedRole.Name}"
                                           FontSize="14"
                                           Foreground="#666"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Statistiques -->
                        <Border Background="#E3F2FD"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="20"
                                                         Height="20"
                                                         Foreground="#1976D2"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Ce rôle dispose de"/>
                                    <Run Text="{Binding SelectedRole.RolePermissions.Count, Mode=OneWay}"
                                         FontWeight="Bold"
                                         Foreground="#1976D2"/>
                                    <Run Text="permission(s)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Liste des permissions -->
                        <ScrollViewer MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding SelectedRole.RolePermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,0,1"
                                                Padding="8"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icône -->
                                                <materialDesign:PackIcon Kind="CheckCircle"
                                                                         Width="20"
                                                                         Height="20"
                                                                         Foreground="#4CAF50"
                                                                         Margin="0,0,12,0"
                                                                         VerticalAlignment="Top"/>

                                                <!-- Détails de la permission -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Permission.Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{Binding Permission.Code}"
                                                               FontSize="11"
                                                               Foreground="#1976D2"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Permission.Description}"
                                                               FontSize="11"
                                                               Foreground="#666"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Message si aucune permission -->
                        <TextBlock Text="Aucune permission n'est associée à ce rôle."
                                   FontStyle="Italic"
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="{Binding SelectedRole.RolePermissions.Count, Converter={StaticResource MaterialBoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRole.RolePermissions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Bouton Fermer -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Fermer"
                                Command="{Binding ClosePermissionsDialogCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Width="120"/>
                    </StackPanel>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>
