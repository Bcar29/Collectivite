<UserControl x:Class="Collectivite.Views.Pages.MouvementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:Collectivite.Utils"
             
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <utils:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        
        <utils:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisConverter"/>
        <utils:NonEmptyCollectionToVisibilityConverter x:Key="NonEmptyCollectionToVisConverter"/>
        <utils:CountZeroToVisibilityConverter x:Key="CountZeroToVisConverter"/>
        <!-- Converters pour les modes de règlement (classes spécifiques) -->
        <utils:EspeceToBoolConverter x:Key="EspeceToBoolConverter"/>
        <utils:VirementToBoolConverter x:Key="VirementToBoolConverter"/>
        <utils:ChequeToBoolConverter x:Key="ChequeToBoolConverter"/>

        <utils:EtatOrdreToTextConverter x:Key="StatutToText"/>
        <utils:EtatOrdreToColorConverter x:Key="StatutToColor"/>
        <utils:EtatOrdreToBackgroundConverter x:Key="StatutToBackground"/>
        
        <!-- Converter inverse pour la visibilité -->
        <Style x:Key="VisibleWhenTrue" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les badges de statut -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Style pour les boutons d'action dans le DataGrid -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Style pour les en-têtes de section -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="MouvementDialog" 
                               IsOpen="{Binding IsDialogOpen}"
                               CloseOnClickAway="False">

        <!-- ═══════════════════════════════════════ -->
        <!-- CONTENU DU DIALOGUE -->
        <!-- ═══════════════════════════════════════ -->
        <materialDesign:DialogHost.DialogContent>
            <Border MinWidth="500" MaxWidth="600" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête du dialogue -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="24,20" 
                            CornerRadius="12,12,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding DialogTitre}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock FontSize="14" Foreground="#64748B" Margin="0,4,0,0">
                                    <Run Text="Pièce : "/>
                                    <Run Text="{Binding DialogNumero}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding FermerDialogueCommand}"
                                    Foreground="#94A3B8" Margin="-8,-8,0,0">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corps du dialogue -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20">

                            <!-- Informations de la pièce -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bénéficiaire/Débiteur -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="Tiers" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding DialogBeneficiaire}" FontSize="13" 
                                                   FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>

                                    <!-- Montant total -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,12">
                                        <TextBlock Text="Montant total" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding DialogMontantTotalFormate}" FontSize="13" 
                                                   FontWeight="SemiBold" Foreground="#1E293B" TextAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Montant restant -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <TextBlock Text="Montant restant à régler" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding DialogMontantRestantFormate}" FontSize="22" 
                                                   FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Date du mouvement -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Date du mouvement" FontSize="12" Foreground="#64748B" 
                                           FontWeight="Medium" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding DialogDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            materialDesign:HintAssist.Hint="Date"
                                            Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Montant du mouvement -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Montant à régler" FontSize="12" Foreground="#64748B" 
                                           FontWeight="Medium" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DialogMontant, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Montant en GNF"
                                         FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Mode de règlement -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Mode de règlement" FontSize="12" Foreground="#64748B" 
                                           FontWeight="Medium" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Espèces -->
                                    <RadioButton Content="Espèces" 
                                                 IsChecked="{Binding DialogModeReglement, Converter={StaticResource EspeceToBoolConverter}}"
                                                 Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                                 Margin="0,0,8,0"
                                                 Background="#F1F5F9"/>

                                    <!-- Virement -->
                                    <RadioButton Content="Virement" 
                                                 IsChecked="{Binding DialogModeReglement, Converter={StaticResource VirementToBoolConverter}}"
                                                 Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                                 Margin="0,0,8,0"
                                                 Background="#F1F5F9"/>

                                    <!-- Chèque -->
                                    <RadioButton Content="Chèque" 
                                                 IsChecked="{Binding DialogModeReglement, Converter={StaticResource ChequeToBoolConverter}}"
                                                 Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                                 Background="#F1F5F9"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Champs Virement (visibles si mode = Virement) -->
                            <Border Background="#EEF2FF" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                                    Visibility="{Binding IsVirementVisible, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Détails du virement" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="#4F46E5" Margin="0,0,0,12"/>

                                    <TextBox Text="{Binding DialogRefVirement, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Référence du virement *"
                                             Margin="0,0,0,12"/>

                                    <TextBox Text="{Binding DialogNumBanque, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="N° compte bancaire bénéficiaire"/>
                                </StackPanel>
                            </Border>

                            <!-- Champs Chèque (visibles si mode = Chèque) -->
                            <Border Background="#FEF3C7" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                                    Visibility="{Binding IsChequeVisible, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Détails du chèque" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="#D97706" Margin="0,0,0,12"/>

                                    <TextBox Text="{Binding DialogRefCheque, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Référence du chèque *"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Boutons du dialogue -->
                    <Border Grid.Row="2" Background="#F8FAFC" Padding="24,16" 
                            CornerRadius="0,0,12,12"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler"
                                    Command="{Binding FermerDialogueCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#64748B"
                                    BorderBrush="#CBD5E1"
                                    Margin="0,0,12,0"
                                    Height="40" Padding="20,0"/>

                            <Button Command="{Binding ValiderMouvementCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#059669"
                                    BorderBrush="#059669"
                                    Height="40" Padding="20,0"
                                    materialDesign:ButtonAssist.CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Valider le mouvement"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- ═══════════════════════════════════════ -->
        <!-- CONTENU PRINCIPAL -->
        <!-- ═══════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <Border Grid.Row="0" Background="White" Padding="28,24"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mouvements de Trésorerie" 
                                   FontSize="28" FontWeight="Bold" 
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Paiements de mandats et encaissements d'ordres de recette" 
                                   FontSize="14" Foreground="#94A3B8" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Bouton Rafraîchir -->
                    <Button Grid.Column="1"
                            Command="{Binding ChargerDonneesCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#64748B"
                            BorderBrush="#CBD5E1"
                            Height="40" Padding="16,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ONGLETS -->
            <TabControl Grid.Row="1" 
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        SelectedIndex="{Binding OngletActif}"
                        Background="White">

                <!-- ═══════════════════════════════════════ -->
                <!-- ONGLET 1 : MANDATS NON PAYÉS -->
                <!-- ═══════════════════════════════════════ -->
                <TabItem Width="204">
                    <TabItem.Header >
                        <StackPanel Orientation="Horizontal" Margin="12,8" >
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" 
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Mandats à payer" VerticalAlignment="Center" FontWeight="Medium" />
                            <Border Background="#FEE2E2" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MandatsNonPayes.Count}" FontSize="11" 
                                           FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="24">
                        <DataGrid ItemsSource="{Binding MandatsNonPayes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="White"
                                  BorderThickness="1"
                                  BorderBrush="#E2E8F0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="60"
                                  HeadersVisibility="Column">

                            <DataGrid.Columns>
                                <!-- N° Mandat -->
                                <DataGridTextColumn Header="N° Mandat" Binding="{Binding NumeroMandat}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Date -->
                                <DataGridTextColumn Header="Date" Binding="{Binding DateEmissionFormatee}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Bénéficiaire -->
                                <DataGridTextColumn Header="Bénéficiaire" Binding="{Binding Beneficiaire}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Objet -->
                                <DataGridTextColumn Header="Objet" Binding="{Binding Objet}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Net -->
                                <DataGridTextColumn Header="Montant Net" Binding="{Binding MontantNetFormate}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Payé -->
                                <DataGridTextColumn Header="Payé" Binding="{Binding MontantPayeFormate}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#059669"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Restant -->
                                <DataGridTextColumn Header="Restant" Binding="{Binding MontantRestantFormate}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Etat Mandat  -->
                                <DataGridTemplateColumn Header="Etat" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" 
                                             Padding="8,4"
                                              HorizontalAlignment="Center"
                                              Background="{Binding Etat, Converter={StaticResource StatutToBackground}}">
                                                 <TextBlock Text="{Binding Etat, Converter={StaticResource StatutToText}}"
                                                 Foreground="{Binding Etat, Converter={StaticResource StatutToColor}}"
                                                 FontSize="11" 
                                                 FontWeight="SemiBold" 
                                                 HorizontalAlignment="Left"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Bouton Payer -->
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Payer"
                                                    Command="{Binding DataContext.OuvrirDialoguePaiementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#059669"
                                                    BorderBrush="#059669"
                                                    Foreground="White"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Message si liste vide -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="40"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding MandatsNonPayes.Count, Converter={StaticResource CountZeroToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="64" Height="64" 
                                                         Foreground="#10B981" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tous les mandats sont payés !" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="Aucun mandat en attente de paiement" FontSize="14"
                                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══════════════════════════════════════ -->
                <!-- ONGLET 2 : ORDRES DE RECETTE NON ENCAISSÉS -->
                <!-- ═══════════════════════════════════════ -->
                <TabItem Width="209">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,8">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" 
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Ordres à encaisser" VerticalAlignment="Center" FontWeight="Medium"/>
                            <Border Background="#DBEAFE" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrdresRecetteNonEncaisses.Count}" FontSize="11" 
                                           FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="24">
                        <DataGrid ItemsSource="{Binding OrdresRecetteNonEncaisses}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="White"
                                  BorderThickness="1"
                                  BorderBrush="#E2E8F0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="60"
                                  HeadersVisibility="Column">

                            <DataGrid.Columns>
                                <!-- N° Ordre -->
                                <DataGridTextColumn Header="N° Ordre" Binding="{Binding NumeroOrdre}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Date -->
                                <DataGridTextColumn Header="Date" Binding="{Binding DateOrdreFormatee}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Débiteur -->
                                <DataGridTextColumn Header="Débiteur" Binding="{Binding Debiteur}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Motif -->
                                <DataGridTextColumn Header="Motif" Binding="{Binding Motifs}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Ordre -->
                                <DataGridTextColumn Header="Montant" Binding="{Binding MontantOrdreFormate}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Encaissé -->
                                <DataGridTextColumn Header="Encaissé" Binding="{Binding MontantEncaisseFormate}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#059669"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montant Restant -->
                                <DataGridTextColumn Header="Restant" Binding="{Binding MontantRestantFormate}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2563EB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Etat Ordre Recett  -->
                                <DataGridTemplateColumn Header="Etat" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" 
                                             Padding="8,4"
                                              HorizontalAlignment="Center"
                                              Background="{Binding Etat, Converter={StaticResource StatutToBackground}}">
                                                <TextBlock Text="{Binding Etat, Converter={StaticResource StatutToText}}"
                                                 Foreground="{Binding ordre.Etat, Converter={StaticResource StatutToColor}}"
                                                 FontSize="11" 
                                                 FontWeight="SemiBold" 
                                                 HorizontalAlignment="Left"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Bouton Encaisser -->
                                <DataGridTemplateColumn Header="" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Encaisser"
                                                    Command="{Binding DataContext.OuvrirDialogueEncaissementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2563EB"
                                                    BorderBrush="#2563EB"
                                                    Foreground="White"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Message si liste vide -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="40"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding OrdresRecetteNonEncaisses.Count, Converter={StaticResource CountZeroToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="64" Height="64" 
                                                         Foreground="#10B981" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tous les ordres sont encaissés !" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="Aucun ordre de recette en attente d'encaissement" FontSize="14"
                                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Barre de chargement -->
            <ProgressBar Grid.Row="1" 
                         IsIndeterminate="True" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                         VerticalAlignment="Top"
                         Foreground="#6366F1"
                         Background="Transparent"
                         Height="3"/>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
