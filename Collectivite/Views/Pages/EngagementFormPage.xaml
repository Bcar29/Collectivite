<Page x:Class="Collectivite.Views.Pages.EngagementFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="{Binding PageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              Command="{Binding CancelCommand}"
                              ToolTip="Retour"
                              Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                   Width="24" 
                                                   Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageTitle}" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="Annuler"
                              Command="{Binding CancelCommand}"
                              Height="40"
                              Margin="0,0,10,0"
                              Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Enregistrer"
                              Command="{Binding SaveCommand}"
                              Height="40"
                              Width="130"/>
                    </StackPanel>
                </Grid>

                <!-- Formulaire -->
                <materialDesign:Card Padding="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section : Informations générales -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="📋 Informations générales"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,10"/>

                        <!-- Exercice -->
                        <ComboBox Grid.Row="2" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Exercice *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding Exercices}"
                                SelectedValue="{Binding Engagement.ExerciceId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Libelle"/>

                        <!-- Date d'engagement -->
                        <DatePicker Grid.Row="2" Grid.Column="2"
                                  materialDesign:HintAssist.Hint="Date d'engagement *"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  SelectedDate="{Binding Engagement.DateEngagement}"
                                  Language="fr-FR"/>

                        <!-- Commune -->
                        <ComboBox Grid.Row="4" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Commune *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding Communes}"
                                SelectedValue="{Binding Engagement.CommuneId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Nom"/>

                        <!-- Tiers -->
                        <ComboBox Grid.Row="4" Grid.Column="2"
                                materialDesign:HintAssist.Hint="Tiers *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding TiersList}"
                                SelectedValue="{Binding Engagement.TiersId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Nom"/>

                        <!-- Ligne budgétaire -->
                        <ComboBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                materialDesign:HintAssist.Hint="Ligne budgétaire *"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                ItemsSource="{Binding BudgetLines}"
                                SelectedItem="{Binding SelectedBudgetLine}"
                                SelectedValue="{Binding Engagement.BudgetLineId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Nommenclature.Intitule"/>

                        <!-- Objet -->
                        <TextBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                               materialDesign:HintAssist.Hint="Objet de l'engagement *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding Engagement.Objet, UpdateSourceTrigger=PropertyChanged}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinLines="3"
                               MaxLines="5"
                               VerticalScrollBarVisibility="Auto"/>

                        <!-- Section : Montants -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="💰 Montants"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,10"/>

                        <!-- Crédits budgétaires -->
                        <TextBox Grid.Row="12" Grid.Column="0"
                               materialDesign:HintAssist.Hint="Crédits budgétaires (GNF) *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               
                               Text="{Binding Engagement.CreditsBudgetaires, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>

                        <!-- Engagements antérieurs -->
                        <TextBox Grid.Row="12" Grid.Column="2"
                               materialDesign:HintAssist.Hint="Engagements antérieurs (GNF)"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding Engagement.EngagementsAnterieurs, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>

                        <!-- Montant de l'engagement -->
                        <TextBox Grid.Row="14" Grid.Column="0"
                               materialDesign:HintAssist.Hint="Montant de l'engagement (GNF) *"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding Engagement.MontantEngagement, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>

                        <!-- Disponible budgétaire (calculé) -->
                        <Border Grid.Row="14" Grid.Column="2"
                              Background="#E3F2FD"
                              CornerRadius="4"
                              Padding="15">
                            <StackPanel>
                                <TextBlock Text="Disponible budgétaire"
                                         FontSize="12"
                                         Foreground="#1976D2"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DisponibleBudgetaire, StringFormat={}{0:N0} GNF, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="18"
                                         Foreground="#1976D2"
                                         FontWeight="Bold"
                                         Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Section : Fichier joint -->
                        <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="📎 Fichier joint (optionnel)"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="3"
                                  Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Command="{Binding ChooseFileCommand}"
                                  Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileUpload" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Choisir un fichier" 
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding FichierName}"
                                     VerticalAlignment="Center"
                                     Margin="15,0,0,0"
                                     FontStyle="Italic"
                                     Foreground="#666">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FichierName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FichierName}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                    </Grid>
                </materialDesign:Card>

                <!-- Note -->
                <Border Background="#FFF3E0"
                      CornerRadius="8"
                      Padding="15"
                      Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#F57C00"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Informations importantes" 
                                     FontWeight="SemiBold"
                                     FontSize="14"
                                     Foreground="#F57C00"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                            • Tous les champs marqués d'un astérisque (*) sont obligatoires
                            <LineBreak/>
                            • Le montant de l'engagement ne peut pas dépasser le disponible budgétaire
                            <LineBreak/>
                            • Les engagements ne peuvent être créés que sur des exercices non clôturés
                            <LineBreak/>
                            • La taille maximale du fichier joint est de 5 MB
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>