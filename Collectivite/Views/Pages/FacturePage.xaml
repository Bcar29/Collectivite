<Page x:Class="Collectivite.Views.Pages.FacturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      Language="fr-FR"
      Background="#F5F5F5"
      Unloaded="Page_Unloaded"
      Title="Gestion des Factures">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Enum StatusFact -->
        <ObjectDataProvider x:Key="StatusFactValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:StatusFact}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StatusFact"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour les badges de statut -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="impayee">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="payee">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="enCours">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="impayee">
                    <Setter Property="Text" Value="IMPAYÉE"/>
                    <Setter Property="Foreground" Value="#F44336"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="payee">
                    <Setter Property="Text" Value="PAYÉE"/>
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="enCours">
                    <Setter Property="Text" Value="EN COURS"/>
                    <Setter Property="Foreground" Value="#FF9800"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="ClipboardText" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Factures" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0"
                            Visibility="{Binding CanCreateFacture, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouvelle Facture"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="1" Padding="0">
                <DataGrid ItemsSource="{Binding Factures}"
                          SelectedItem="{Binding SelectedFacture}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                    <DataGrid.Columns>
                        <!-- Numéro -->
                        <DataGridTextColumn Header="N° Facture" 
                                          Binding="{Binding NumeroFacture}" 
                                          Width="160"
                                          FontWeight="SemiBold"/>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date" 
                                          Binding="{Binding DateFacture, StringFormat='dd/MM/yyyy'}" 
                                          Width="100"/>

                        <!-- Tiers -->
                        <DataGridTextColumn Header="Tiers" 
                                          Binding="{Binding Tiers.Nom}" 
                                          Width="*" 
                                          MinWidth="150"/>

                        <!-- Montant HT -->
                        <DataGridTemplateColumn Header="Montant HT" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MontantHT, StringFormat={}{0:N0} GNF}"
                                               HorizontalAlignment="Right"
                                               Foreground="#666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TVA -->
                        <DataGridTemplateColumn Header="TVA" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TauxTVA, StringFormat={}{0}%}"
                                               HorizontalAlignment="Center"
                                               Foreground="#666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Montant TTC -->
                        <DataGridTemplateColumn Header="Montant TTC" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E3F2FD" 
                                            CornerRadius="4" 
                                            Padding="8,4">
                                        <TextBlock Text="{Binding MontantTTC, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   Foreground="#1976D2"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Échéance -->
                        <DataGridTextColumn Header="Échéance" 
                                          Binding="{Binding DateEcheance, StringFormat='dd/MM/yyyy'}" 
                                          Width="100"/>

                        <!-- Statut -->
                        <DataGridTemplateColumn Header="Statut" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        ToolTip="Export PDF">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#F44336"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.ExportExcelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        ToolTip="Export Excel">
                                            <materialDesign:PackIcon Kind="FileExcel" Foreground="#4CAF50"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                        
                        Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                         CloseOnClickAway="False" 
                         Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <StackPanel Width="600" Margin="15">

                        <!-- Titre -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <materialDesign:PackIcon Kind="FileDocument" 
                                           Width="20" 
                                           Height="20"
                                           Foreground="#1976D2"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DialogTitle}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Informations principales -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Numéro facture -->
                            <TextBox Grid.Row="0" Grid.Column="0"
                             materialDesign:HintAssist.Hint="N° Facture *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogFacture.NumeroFacture, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10"/>

                            <!-- Date facture -->
                            <DatePicker Grid.Row="0" Grid.Column="2"
                                materialDesign:HintAssist.Hint="Date facture *"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding DialogFacture.DateFacture}"
                                Margin="0,0,0,10"/>

                            <!-- Tiers -->
                            <ComboBox Grid.Row="1" Grid.Column="0"
                              materialDesign:HintAssist.Hint="Tiers *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding TiersList}"
                              SelectedValue="{Binding DialogFacture.TiersId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nom"
                              Margin="0,0,0,10"/>

                            <!-- Exercice -->
                            <ComboBox Grid.Row="1" Grid.Column="2"
                              materialDesign:HintAssist.Hint="Exercice *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Exercices}"
                              SelectedValue="{Binding DialogFacture.ExerciceId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Libelle"
                              Margin="0,0,0,10"/>

                            <!-- Date échéance -->
                            <DatePicker Grid.Row="2" Grid.Column="0"
                                materialDesign:HintAssist.Hint="Date échéance *"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding DialogFacture.DateEcheance}"
                                Margin="0,0,0,10"/>

                            <!-- Statut -->
                            <ComboBox Grid.Row="2" Grid.Column="2"
                              materialDesign:HintAssist.Hint="Statut *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Source={StaticResource StatusFactValues}}"
                              SelectedItem="{Binding DialogFacture.Status}"
                              Margin="0,0,0,10"/>

                            <!-- Contrat (optionnel) -->
                            <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                              materialDesign:HintAssist.Hint="Contrat (optionnel)"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding ContratsList}"
                              SelectedValue="{Binding DialogFacture.ContratId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="NumeroContrat"
                              Margin="0,0,0,10"/>

                            <!-- Description -->
                            <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                             materialDesign:HintAssist.Hint="Description *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogFacture.Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinLines="2"
                             MaxLines="3"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>
                        </Grid>

                        <!-- Fichier joint -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ChooseFileCommand}"
                            Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Attachment" 
                                                   Width="14" 
                                                   Height="14"
                                                   Margin="0,0,5,0"/>
                                    <TextBlock Text="Joindre fichier" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding FichierName}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontStyle="Italic"
                               FontSize="11"
                               Foreground="#666"/>
                        </StackPanel>

                        <!-- Section Détails de la facture -->
                        <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Titre section -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Détails de la facture"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left"/>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding AddDetailCommand}"
                                    Height="28"
                                    DockPanel.Dock="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" 
                                                           Width="14" 
                                                           Height="14"
                                                           Margin="0,0,4,0"/>
                                            <TextBlock Text="Ajouter ligne" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <!-- Liste des détails -->
                                <ItemsControl ItemsSource="{Binding DialogDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9F9F9" 
                                            CornerRadius="4"
                                            Padding="8"
                                            Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Ligne 1 : Libellé et bouton supprimer -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                                         materialDesign:HintAssist.Hint="Libellé"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"/>

                                                        <Button Grid.Column="1"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="5,0,0,0"
                                                        ToolTip="Supprimer">
                                                            <materialDesign:PackIcon Kind="Delete" 
                                                                           Width="16"
                                                                           Height="16"
                                                                           Foreground="#F44336"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Ligne 2 : Quantité, Prix unitaire, Montant total -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Quantité -->
                                                        <TextBox Grid.Column="0"
                                                         materialDesign:HintAssist.Hint="Qté"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return" 
                                                                    Command="{Binding DataContext.RecalculerMontantDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>

                                                        <!-- Prix unitaire -->
                                                        <TextBox Grid.Column="2"
                                                         materialDesign:HintAssist.Hint="Prix unit."
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Text="{Binding PrixUnitaire, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         FontSize="12">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Return" 
                                                                    Command="{Binding DataContext.RecalculerMontantDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>

                                                        <!-- Montant total -->
                                                        <TextBox Grid.Column="4"
                                                         materialDesign:HintAssist.Hint="Total"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         Text="{Binding MontantTotal, StringFormat=N0}"
                                                         IsReadOnly="True"
                                                         Background="#E8F5E9"
                                                         FontWeight="SemiBold"
                                                         FontSize="12"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Total des détails -->
                                <Border Background="#E3F2FD" 
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,5,0,0">
                                    <DockPanel>
                                        <TextBlock Text="TOTAL :"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding TotalDetails, StringFormat={}{0:N0} GNF}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section Montants -->
                        <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Montant HT -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Montant HT"
                                       FontSize="11"
                                       Foreground="#666"
                                       Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DialogFacture.MontantHT, StringFormat=N0}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"
                                     FontWeight="SemiBold"
                                     FontSize="13"/>
                                </StackPanel>

                                <!-- Taux TVA -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TVA (%)"
                                       FontSize="11"
                                       Foreground="#666"
                                       Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DialogFacture.TauxTVA, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontWeight="SemiBold"
                                     FontSize="13">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding OnMontantsChangedCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </StackPanel>

                                <!-- Montant TTC -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Montant TTC"
                                       FontSize="11"
                                       Foreground="#666"
                                       Margin="0,0,0,4"/>
                                    <Border Background="#E3F2FD" 
                                    CornerRadius="4"
                                    Padding="8">
                                        <TextBlock Text="{Binding MontantTTCCalcule, StringFormat={}{0:N0} GNF}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Content="Annuler"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"
                            Width="90"
                            Height="32"/>
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Enregistrer"
                            Command="{Binding SaveCommand}"
                            Width="130"
                            Height="32"/>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>