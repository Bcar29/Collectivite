<Page x:Class="Collectivite.Views.Pages.FacturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Unloaded="Page_Unloaded"
      Title="Gestion des Factures">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Enum StatusFact -->
        <ObjectDataProvider x:Key="StatusFactValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:StatusFact}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StatusFact"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour les badges de statut -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="impayee">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="payee">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="enCours">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="impayee">
                    <Setter Property="Text" Value="IMPAYÉE"/>
                    <Setter Property="Foreground" Value="#F44336"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="payee">
                    <Setter Property="Text" Value="PAYÉE"/>
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="enCours">
                    <Setter Property="Text" Value="EN COURS"/>
                    <Setter Property="Foreground" Value="#FF9800"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="ClipboardText" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Factures" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0"
                            Visibility="{Binding CanCreateFacture, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouvelle Facture"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="1" Padding="0">
              <Grid>
                <DataGrid ItemsSource="{Binding Factures}"
                          SelectedItem="{Binding SelectedFacture}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="52"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                          AlternationCount="2"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Numéro -->
                        <DataGridTextColumn Header="N° Facture" 
                                          Binding="{Binding NumeroFacture}" 
                                          Width="160"
                                          FontWeight="SemiBold"/>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date" 
                                          Binding="{Binding DateFacture, StringFormat='dd/MM/yyyy'}" 
                                          Width="100"/>

                        <!-- Tiers -->
                        <DataGridTextColumn Header="Tiers" 
                                      Binding="{Binding Tiers.NomComplet}" 
                                          Width="*" 
                                          MinWidth="150"/>

                        <!-- Montant HT -->
                        <DataGridTemplateColumn Header="Montant HT" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MontantHT, StringFormat={}{0:N0} GNF}"
                                               HorizontalAlignment="Right"
                                               Foreground="#666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TVA -->
                        <DataGridTemplateColumn Header="TVA" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TauxTVA, StringFormat={}{0}%}"
                                               HorizontalAlignment="Center"
                                               Foreground="#666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Montant TTC -->
                        <DataGridTemplateColumn Header="Montant TTC" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E3F2FD" 
                                            CornerRadius="4" 
                                            Padding="8,4">
                                        <TextBlock Text="{Binding MontantTTC, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   Foreground="#1976D2"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Échéance -->
                        <DataGridTextColumn Header="Échéance" 
                                          Binding="{Binding DateEcheance, StringFormat='dd/MM/yyyy'}" 
                                          Width="100"/>

                        <!-- Statut -->
                        <DataGridTemplateColumn Header="Statut" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanViewFacture, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#4CAF50" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Voir les détails"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditFacture, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Modifier"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDeleteFacture, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Supprimer"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanViewFacture, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#F44336" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Export PDF"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.ExportExcelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanViewFacture, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileExcel" Foreground="#4CAF50" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Export Excel"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Message si vide -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Factures.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardText" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucune facture" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cliquez sur 'Nouvelle Facture' pour commencer" FontSize="13" Foreground="#9E9E9E" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
              </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                         CloseOnClickAway="False"
                         Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="700" MaxHeight="680">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Border Grid.Row="0"
                              Background="{StaticResource AppPrimaryBrush}"
                              Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument"
                                                       Width="26"
                                                       Height="26"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding DialogTitle}"
                                         FontSize="20"
                                         FontWeight="SemiBold"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- CONTENU SCROLLABLE -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>

                                <!-- ═══ INFORMATIONS GÉNÉRALES ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Informations générales" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Numéro facture -->
                                            <TextBox Grid.Row="0" Grid.Column="0"
                                             materialDesign:HintAssist.Hint="N° Facture *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding DialogFacture.NumeroFacture, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- Date facture -->
                                            <DatePicker Grid.Row="0" Grid.Column="2"
                                                materialDesign:HintAssist.Hint="Date facture *"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                SelectedDate="{Binding DialogFacture.DateFacture}"/>

                                            <!-- Tiers -->
                                            <ComboBox Grid.Row="2" Grid.Column="0"
                                              materialDesign:HintAssist.Hint="Tiers *"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding TiersList}"
                                              SelectedValue="{Binding DialogFacture.TiersId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="NomComplet"
                                              utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                                            <!-- Exercice -->
                                            <ComboBox Grid.Row="2" Grid.Column="2"
                                              materialDesign:HintAssist.Hint="Exercice *"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding Exercices}"
                                              SelectedValue="{Binding DialogFacture.ExerciceId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Libelle"
                                              utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                                            <!-- Date échéance -->
                                            <DatePicker Grid.Row="4" Grid.Column="0"
                                                materialDesign:HintAssist.Hint="Date échéance *"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                SelectedDate="{Binding DialogFacture.DateEcheance}"/>

                                            <!-- Statut -->
                                            <ComboBox Grid.Row="4" Grid.Column="2"
                                              materialDesign:HintAssist.Hint="Statut *"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding Source={StaticResource StatusFactValues}}"
                                              SelectedItem="{Binding DialogFacture.Status}"
                                              utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                                            <!-- Description -->
                                            <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                             materialDesign:HintAssist.Hint="Description *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding DialogFacture.Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinLines="2"
                                             MaxLines="3"
                                             VerticalScrollBarVisibility="Auto"/>
                                        </Grid>

                                        <!-- Fichier joint -->
                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding ChooseFileCommand}"
                                            Height="32">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Attachment"
                                                                   Width="14"
                                                                   Height="14"
                                                                   Margin="0,0,5,0"/>
                                                    <TextBlock Text="Joindre fichier" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding FichierName}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               FontStyle="Italic"
                                               FontSize="11"
                                               Foreground="{StaticResource AppMutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ DÉTAILS DE LA FACTURE ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                                <TextBlock Text="Détails de la facture" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding AddDetailCommand}"
                                            Height="32"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Plus"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,5,0"/>
                                                    <TextBlock Text="Ajouter ligne" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>

                                        <!-- Liste des détails -->
                                        <ItemsControl ItemsSource="{Binding DialogDetails}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource AppPageBackgroundBrush}"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Ligne 1 : Libellé et bouton supprimer -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox Grid.Column="0"
                                                                 materialDesign:HintAssist.Hint="Libellé"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="13"/>

                                                                <Button Grid.Column="1"
                                                                Style="{StaticResource MaterialDesignIconButton}"
                                                                Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Width="36"
                                                                Height="36"
                                                                Margin="8,0,0,0"
                                                                ToolTip="Supprimer">
                                                                    <materialDesign:PackIcon Kind="Delete"
                                                                                   Width="18"
                                                                                   Height="18"
                                                                                   Foreground="{StaticResource AppDangerBrush}"/>
                                                                </Button>
                                                            </Grid>

                                                            <!-- Ligne 2 : Quantité, Prix unitaire, Montant total -->
                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Quantité -->
                                                                <TextBox Grid.Column="0"
                                                                 materialDesign:HintAssist.Hint="Qté"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="13">
                                                                    <TextBox.InputBindings>
                                                                        <KeyBinding Key="Return"
                                                                            Command="{Binding DataContext.RecalculerMontantDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    </TextBox.InputBindings>
                                                                </TextBox>

                                                                <!-- Prix unitaire -->
                                                                <TextBox Grid.Column="2"
                                                                 materialDesign:HintAssist.Hint="Prix unit."
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 Text="{Binding PrixUnitaire, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                                 FontSize="13">
                                                                    <TextBox.InputBindings>
                                                                        <KeyBinding Key="Return"
                                                                            Command="{Binding DataContext.RecalculerMontantDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    </TextBox.InputBindings>
                                                                </TextBox>

                                                                <!-- Montant total -->
                                                                <TextBox Grid.Column="4"
                                                                 materialDesign:HintAssist.Hint="Total"
                                                                 Style="{StaticResource ComputedFieldTextBoxStyle}"
                                                                 Text="{Binding MontantTotal, StringFormat=N0}"
                                                                 FontWeight="SemiBold"
                                                                 FontSize="13"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Total des détails -->
                                        <Border Background="{StaticResource AppPrimaryLightBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,5,0,0">
                                            <DockPanel>
                                                <TextBlock Text="TOTAL"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalDetails, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{StaticResource AppPrimaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ MONTANTS ═══ -->
                                <materialDesign:Card Padding="15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="Calculator" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Montants" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Montant HT -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Montant HT"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppMutedTextBrush}"
                                                   Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding DialogFacture.MontantHT, StringFormat=N0}"
                                                 Style="{StaticResource ComputedFieldTextBoxStyle}"
                                                 FontWeight="SemiBold"
                                                 FontSize="14"/>
                                            </StackPanel>

                                            <!-- Taux TVA -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="TVA (%)"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppMutedTextBrush}"
                                                   Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding DialogFacture.TauxTVA, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 FontWeight="SemiBold"
                                                 FontSize="14">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding OnMontantsChangedCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </StackPanel>

                                            <!-- Montant TTC -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Montant TTC"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppMutedTextBrush}"
                                                   Margin="0,0,0,8"/>
                                                <Border Background="{StaticResource AppPrimaryLightBrush}"
                                                CornerRadius="6"
                                                Padding="8">
                                                    <TextBlock Text="{Binding MontantTTCCalcule, StringFormat={}{0:N0} GNF}"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="{StaticResource AppPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- FOOTER -->
                        <Border Grid.Row="2"
                              Background="{StaticResource AppPageBackgroundBrush}"
                              BorderBrush="{StaticResource AppBorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="20">
                            <Grid>
                                <TextBlock Text="* Champs obligatoires"
                                         FontSize="11"
                                         Foreground="{StaticResource AppMutedTextBrush}"
                                         FontStyle="Italic"
                                         VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="Annuler"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,10,0"
                                    Width="100"
                                    Height="40"/>
                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding SaveCommand}"
                                    Width="140"
                                    Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>