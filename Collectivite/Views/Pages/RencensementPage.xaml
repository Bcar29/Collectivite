<Page x:Class="Collectivite.Views.Pages.RecensementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Recensements"
      x:Name="RecensementPageRoot">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Proxy pour le binding -->
        <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}"/>
    </Page.Resources>

    <Grid>
        <!-- Proxy invisible pour le binding -->
        <ContentControl Visibility="Collapsed" Content="{StaticResource ProxyElement}"/>

        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="CashMultiple" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Recensements des Recettes" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouveau Recensement"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Bandeau d'information -->
            <Border Grid.Row="1" 
                    Background="#E3F2FD" 
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                               Width="20" 
                                               Height="20"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="Recensement des recettes (fiscales et non fiscales)"
                                   FontSize="13"
                                   Foreground="#1976D2"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="Total recensé :"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#424242"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TotalRecense, StringFormat={}{0:N0} GNF}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Panneau de configuration des colonnes -->
            <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,0,0,15">
                <Expander Header="⚙️ Affichage des colonnes" 
                         materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                         IsExpanded="False">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Colonne 1 -->
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Exercice" 
                                     IsChecked="{Binding ShowExercice}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Commune" 
                                     IsChecked="{Binding ShowCommune}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Chapitre" 
                                     IsChecked="{Binding ShowChapitre}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>
                        </StackPanel>

                        <!-- Colonne 2 -->
                        <StackPanel Grid.Column="1">
                            <CheckBox Content="Article" 
                                     IsChecked="{Binding ShowArticle}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Paragraphe" 
                                     IsChecked="{Binding ShowParagraphe}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Sous-paragraphe" 
                                     IsChecked="{Binding ShowSousParagraphe}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>
                        </StackPanel>

                        <!-- Colonne 3 -->
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Intitulé" 
                                     IsChecked="{Binding ShowIntitule}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Tiers" 
                                     IsChecked="{Binding ShowTiers}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>

                            <CheckBox Content="Montant Recensé" 
                                     IsChecked="{Binding ShowMontant}"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Expander>
            </materialDesign:Card>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="3" Padding="0">
                <DataGrid ItemsSource="{Binding Recensements}"
                          SelectedItem="{Binding SelectedRecensement}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                    <DataGrid.Columns>
                        <!-- Exercice -->
                        <DataGridTextColumn Header="Exercice" 
                                          Binding="{Binding Exercice.Libelle}" 
                                          Width="110"
                                          Visibility="{Binding DataContext.ShowExercice, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}"/>

                        <!-- Commune -->
                        <DataGridTextColumn Header="Commune" 
                                          Binding="{Binding Commune.Nom}" 
                                          Width="130"
                                          Visibility="{Binding DataContext.ShowCommune, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}"/>

                        <!-- Chapitre -->
                        <DataGridTemplateColumn Header="Chapitre" 
                                              Width="90"
                                              Visibility="{Binding DataContext.ShowChapitre, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E3F2FD" 
                                           CornerRadius="3"
                                           Padding="5,2">
                                        <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                  FontWeight="Bold"
                                                  FontSize="10"
                                                  Foreground="#1976D2"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Article -->
                        <DataGridTemplateColumn Header="Article" 
                                              Width="90"
                                              Visibility="{Binding DataContext.ShowArticle, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9" 
                                           CornerRadius="3"
                                           Padding="5,2">
                                        <TextBlock Text="{Binding BudgetLine.Nommenclature.Article}" 
                                                  FontWeight="SemiBold"
                                                  FontSize="10"
                                                  Foreground="#388E3C"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Paragraphe -->
                        <DataGridTemplateColumn Header="Paragraphe" 
                                              Width="100"
                                              Visibility="{Binding DataContext.ShowParagraphe, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3E0" 
                                           CornerRadius="3"
                                           Padding="5,2">
                                        <TextBlock Text="{Binding BudgetLine.Nommenclature.Paragraphe}" 
                                                  FontWeight="SemiBold"
                                                  FontSize="10"
                                                  Foreground="#F57C00"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sous-paragraphe -->
                        <DataGridTemplateColumn Header="Sous-paragraphe" 
                                              Width="120"
                                              Visibility="{Binding DataContext.ShowSousParagraphe, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F3E5F5" 
                                           CornerRadius="3"
                                           Padding="5,2">
                                        <TextBlock Text="{Binding BudgetLine.Nommenclature.SousParagraphe}" 
                                                  FontWeight="SemiBold"
                                                  FontSize="10"
                                                  Foreground="#7B1FA2"
                                                  HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Intitulé ligne budgétaire -->
                        <DataGridTextColumn Header="Intitulé" 
                                          Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                          Width="*" 
                                          MinWidth="200"
                                          Visibility="{Binding DataContext.ShowIntitule, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}"/>

                        <!-- Tiers -->
                        <DataGridTextColumn Header="Tiers" 
                                          Binding="{Binding Tiers.Nom}" 
                                          Width="150"
                                          Visibility="{Binding DataContext.ShowTiers, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}"/>

                        <!-- Montant recensé -->
                        <DataGridTemplateColumn Header="Montant Recensé" 
                                              Width="140"
                                              Visibility="{Binding DataContext.ShowMontant, Source={StaticResource ProxyElement}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9" 
                                            CornerRadius="4" 
                                            Padding="8,4">
                                        <TextBlock Text="{Binding MontantRecense, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   Foreground="#388E3C"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions (toujours visible) -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, ElementName=RecensementPageRoot}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=RecensementPageRoot}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                 CloseOnClickAway="False" 
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="600" Margin="20">

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ClipboardList" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Info recensement -->
                    <Border Background="#E3F2FD" 
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="18" 
                                                       Height="18"
                                                       Foreground="#1976D2"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Recensement des recettes" 
                                         FontWeight="SemiBold"
                                         FontSize="13"
                                         Foreground="#1565C0"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Sélectionnez une ligne budgétaire pour enregistrer le recensement des recettes (fiscales ou non fiscales)."
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Foreground="#424242"
                                     Margin="26,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Formulaire -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Exercice -->
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Exercice *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Exercices}"
                                  SelectedValue="{Binding DialogRecensement.ExerciceId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Libelle"
                                  Margin="0,0,0,15"/>

                        <!-- Commune -->
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  materialDesign:HintAssist.Hint="Commune *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Communes}"
                                  SelectedValue="{Binding DialogRecensement.CommuneId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nom"
                                  Margin="0,0,0,15"/>

                        <!-- Ligne budgétaire -->
                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Ligne budgétaire *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding LignesBudgetaires}"
                                  SelectedValue="{Binding DialogRecensement.BudgetLineId}"
                                  SelectedValuePath="Id"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <!-- Codes -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Nommenclature.Chapitre}" FontWeight="Bold" FontSize="11" Foreground="#1976D2"/>
                                            </Border>
                                            <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Nommenclature.Article}" FontWeight="SemiBold" FontSize="11" Foreground="#388E3C"/>
                                            </Border>
                                            <Border Background="#FFF3E0" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Nommenclature.Paragraphe}" FontWeight="SemiBold" FontSize="11" Foreground="#F57C00"/>
                                            </Border>
                                            <Border Background="#F3E5F5" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding Nommenclature.SousParagraphe}" FontWeight="SemiBold" FontSize="11" Foreground="#7B1FA2"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Intitulé -->
                                        <TextBlock Text="{Binding Nommenclature.Intitule}" FontSize="12" TextWrapping="Wrap" Foreground="#424242"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Tiers -->
                        <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Tiers *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding TiersList}"
                                  SelectedValue="{Binding DialogRecensement.TiersId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nom"
                                  Margin="0,0,0,15"/>

                        <!-- Montant recensé -->
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Montant recensé (GNF) *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogRecensement.MontantRecense, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>