<Page x:Class="Collectivite.Views.Pages.RecensementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Recensements">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="CashMultiple" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Recensements des Recettes Fiscales" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouveau Recensement"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Bandeau d'information -->
            <Border Grid.Row="1" 
                    Background="#E3F2FD" 
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                               Width="20" 
                                               Height="20"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="Recensement des recettes fiscales (Chapitre 71xx uniquement)"
                                   FontSize="13"
                                   Foreground="#1976D2"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="Total recensé :"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#424242"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TotalRecense, StringFormat={}{0:N0} GNF}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <materialDesign:Card Grid.Row="2" Padding="0">
                <DataGrid ItemsSource="{Binding Recensements}"
                          SelectedItem="{Binding SelectedRecensement}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                    <DataGrid.Columns>
                        <!-- Exercice -->
                        <DataGridTextColumn Header="Exercice" 
                                          Binding="{Binding Exercice.Libelle}" 
                                          Width="120"/>

                        <!-- Commune -->
                        <DataGridTextColumn Header="Commune" 
                                          Binding="{Binding Commune.Nom}" 
                                          Width="150"/>

                        <!-- Chapitre -->
                        <DataGridTextColumn Header="Chapitre" 
                                          Binding="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                          Width="80"/>

                        <!-- Article -->
                        <DataGridTextColumn Header="Article" 
                                          Binding="{Binding BudgetLine.Nommenclature.Article}" 
                                          Width="80"/>

                        <!-- Intitulé ligne budgétaire -->
                        <DataGridTextColumn Header="Ligne budgétaire" 
                                          Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                          Width="*" 
                                          MinWidth="200"/>

                        <!-- Tiers -->
                        <DataGridTextColumn Header="Tiers" 
                                          Binding="{Binding Tiers.Nom}" 
                                          Width="180"/>

                        <!-- Montant recensé -->
                        <DataGridTemplateColumn Header="Montant Recensé" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9" 
                                            CornerRadius="4" 
                                            Padding="8,4">
                                        <TextBlock Text="{Binding MontantRecense, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   Foreground="#388E3C"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                 CloseOnClickAway="False" 
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="550" Margin="20">

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ClipboardList" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Info recettes fiscales -->
                    <Border Background="#FFF3E0" 
                            BorderBrush="#FF9800"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                       Width="18" 
                                                       Height="18"
                                                       Foreground="#FF9800"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Recettes fiscales uniquement" 
                                         FontWeight="SemiBold"
                                         FontSize="13"
                                         Foreground="#E65100"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Seules les lignes budgétaires du chapitre 71 (recettes fiscales) sont disponibles pour le recensement."
                                     TextWrapping="Wrap"
                                     FontSize="11"
                                     Foreground="#424242"
                                     Margin="26,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Formulaire -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Exercice -->
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Exercice *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Exercices}"
                                  SelectedValue="{Binding DialogRecensement.ExerciceId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Libelle"
                                  Margin="0,0,0,15"/>

                        <!-- Commune -->
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  materialDesign:HintAssist.Hint="Commune *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Communes}"
                                  SelectedValue="{Binding DialogRecensement.CommuneId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nom"
                                  Margin="0,0,0,15"/>

                        <!-- Ligne budgétaire (recettes fiscales 71xx uniquement) -->
                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Recette fiscale (71xx) *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding RecettesFiscales}"
                                  SelectedValue="{Binding DialogRecensement.BudgetLineId}"
                                  SelectedValuePath="Id"
                                 
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Nommenclature.Chapitre, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Nommenclature.Intitule, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Tiers -->
                        <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Tiers *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding TiersList}"
                                  SelectedValue="{Binding DialogRecensement.TiersId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nom"
                                  Margin="0,0,0,15"/>

                        <!-- Montant recensé -->
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Montant recensé (GNF) *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding DialogRecensement.MontantRecense, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>