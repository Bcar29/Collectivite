<UserControl x:Class="Collectivite.Views.BalancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Converter pour les objets null -->
        <Style x:Key="NotNullVisibility" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Totaux}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les cellules d'en-tête -->
        <Style x:Key="HeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Style pour les cellules de données -->
        <Style x:Key="DataCellStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Style pour les cellules de total -->
        <Style x:Key="TotalCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Style pour le texte d'en-tête -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style pour le texte de données -->
        <Style x:Key="DataTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Style pour le texte des totaux -->
        <Style x:Key="TotalTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Style pour les boutons d'action -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!-- EN-TÊTE -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="28,24"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TitrePeriode}" 
                               FontSize="28" FontWeight="Bold" 
                               Foreground="#1E293B"/>
                    <TextBlock Text="{Binding SousTitre}" 
                               FontSize="14" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Boutons d'action avec jolies couleurs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Bouton Excel - Vert émeraude -->
                    <Button Command="{Binding ExporterExcelCommand}"
                            Background="#10B981" 
                            BorderBrush="#10B981"
                            Foreground="White"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" Margin="0,0,8,0" Width="18" Height="18"/>
                            <TextBlock Text="Exporter Excel"/>
                        </StackPanel>
                    </Button>

                    <!-- Bouton PDF - Rouge élégant -->
                    <Button Command="{Binding ExporterPdfCommand}"
                            Background="#EF4444" 
                            BorderBrush="#EF4444"
                            Foreground="White"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,8,0" Width="18" Height="18"/>
                            <TextBlock Text="Exporter PDF"/>
                        </StackPanel>
                    </Button>

                    <!-- Bouton Imprimer - Bleu indigo -->
                    <Button Command="{Binding ImprimerCommand}"
                            Background="#6366F1" 
                            BorderBrush="#6366F1"
                            Foreground="White"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,8,0" Width="18" Height="18"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- BARRE DE FILTRES -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#F8FAFC" Padding="24,18"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtre Année 
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Année" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                    <ComboBox Width="110" 
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding AnneeSelectionnee}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>
                 -->
                <!-- Filtre Mois -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Mois" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                    <ComboBox Width="150" 
                              ItemsSource="{Binding Mois}"
                              SelectedValue="{Binding MoisSelectionne}"
                              SelectedValuePath="Numero"
                              DisplayMemberPath="Nom"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Filtre Classe -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="Classe de compte" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                    <ComboBox Width="170" 
                              ItemsSource="{Binding ClassesComptes}"
                              SelectedItem="{Binding ClasseSelectionnee}"
                              DisplayMemberPath="Libelle"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Recherche -->
                <StackPanel Grid.Column="3" Margin="0,0,20,0">
                    <TextBlock Text="Recherche" FontSize="12" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Rechercher un compte..."
                             materialDesign:TextFieldAssist.HasClearButton="True"/>
                </StackPanel>

                <!-- Bouton réinitialiser -->
                <Button Grid.Column="4" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ReinitialiserFiltresCommand}"
                        Foreground="#64748B"
                        BorderBrush="#CBD5E1"
                        Height="38"
                        VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Réinitialiser"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- TABLEAU DE LA BALANCE -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      Background="White">
            <StackPanel Margin="24">

                <!-- EN-TÊTE NIVEAU 1 (Débit, Crédit, Solde) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="" Style="{StaticResource HeaderTextStyle}"/>
                    </Border>

                    <!-- Débit - Vert émeraude -->
                    <Border Grid.Column="2" Background="#059669" BorderBrush="#047857" BorderThickness="1" Padding="10,12">
                        <TextBlock Text="DÉBIT" FontSize="14" FontWeight="Bold" Foreground="White" 
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Crédit - Rouge corail -->
                    <Border Grid.Column="3" Background="#DC2626" BorderBrush="#B91C1C" BorderThickness="1" Padding="10,12">
                        <TextBlock Text="CRÉDIT" FontSize="14" FontWeight="Bold" Foreground="White" 
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Solde - Bleu indigo -->
                    <Border Grid.Column="4" Background="#4F46E5" BorderBrush="#4338CA" BorderThickness="1" Padding="10,12">
                        <TextBlock Text="SOLDE" FontSize="14" FontWeight="Bold" Foreground="White" 
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- EN-TÊTE NIVEAU 2 (sous-colonnes) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="N°&#x0a;Comptes" Style="{StaticResource HeaderTextStyle}" TextWrapping="Wrap" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource HeaderCellStyle}">
                        <TextBlock Text="Intitulés" Style="{StaticResource HeaderTextStyle}" FontWeight="Bold"/>
                    </Border>

                    <!-- Débit - Tons verts clairs -->
                    <Border Grid.Column="2" Background="#D1FAE5" BorderBrush="#A7F3D0" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Balance&#x0a;Entrée" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#065F46" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="3" Background="#D1FAE5" BorderBrush="#A7F3D0" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Mouv&#x0a;Antérieur" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#065F46" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="4" Background="#D1FAE5" BorderBrush="#A7F3D0" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Mouv&#x0a;Mois" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#065F46" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="5" Background="#A7F3D0" BorderBrush="#6EE7B7" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Total" TextAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="#065F46" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- Crédit - Tons rouges clairs -->
                    <Border Grid.Column="6" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Balance&#x0a;Entrée" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#991B1B" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="7" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Mouv&#x0a;Antérieur" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#991B1B" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="8" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Mouv&#x0a;Mois" TextWrapping="Wrap" TextAlignment="Center" 
                                   VerticalAlignment="Center" Foreground="#991B1B" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="9" Background="#FECACA" BorderBrush="#FCA5A5" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Total" TextAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="#991B1B" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- Solde - Tons bleus clairs -->
                    <Border Grid.Column="10" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Débiteur" TextAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="#3730A3" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="11" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="10,8">
                        <TextBlock Text="Créditeur" TextAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="#3730A3" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- DONNÉES -->
                <ItemsControl ItemsSource="{Binding Lignes}" AlternationCount="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding NumeroCompte}" Style="{StaticResource DataTextStyle}" 
                                               TextAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding IntituleCompte}" Style="{StaticResource DataTextStyle}" 
                                               TextAlignment="Left" Foreground="#334155"/>
                                </Border>

                                <!-- Débit -->
                                <Border Grid.Column="2" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding DebitBalanceEntreeFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding DebitMouvAnterieurFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding DebitMouvMoisFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="5" Style="{StaticResource DataCellStyle}" Background="#F0FDF4">
                                    <TextBlock Text="{Binding DebitTotalFormate}" Style="{StaticResource DataTextStyle}" 
                                               FontWeight="Bold" Foreground="#059669"/>
                                </Border>

                                <!-- Crédit -->
                                <Border Grid.Column="6" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding CreditBalanceEntreeFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="7" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding CreditMouvAnterieurFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="8" Style="{StaticResource DataCellStyle}">
                                    <TextBlock Text="{Binding CreditMouvMoisFormate}" Style="{StaticResource DataTextStyle}"/>
                                </Border>
                                <Border Grid.Column="9" Style="{StaticResource DataCellStyle}" Background="#FEF2F2">
                                    <TextBlock Text="{Binding CreditTotalFormate}" Style="{StaticResource DataTextStyle}" 
                                               FontWeight="Bold" Foreground="#DC2626"/>
                                </Border>

                                <!-- Solde -->
                                <Border Grid.Column="10" Style="{StaticResource DataCellStyle}" Background="#F0FDF4">
                                    <TextBlock Text="{Binding SoldeDebiteurFormate}" Style="{StaticResource DataTextStyle}" 
                                               FontWeight="SemiBold" Foreground="#059669"/>
                                </Border>
                                <Border Grid.Column="11" Style="{StaticResource DataCellStyle}" Background="#FEF2F2">
                                    <TextBlock Text="{Binding SoldeCrebiteurFormate}" Style="{StaticResource DataTextStyle}" 
                                               FontWeight="SemiBold" Foreground="#DC2626"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════ -->
                <!-- LIGNE DE TOTAUX (toujours visible) -->
                <!-- ═══════════════════════════════════════ -->
                <Grid Style="{StaticResource NotNullVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <!-- Label TOTAUX -->
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="TOTAUX" FontSize="13" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Totaux Débit -->
                    <Border Grid.Column="2" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalDebitBalanceEntreeFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalDebitMouvAnterieurFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalDebitMouvMoisFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalDebitFormate}" Style="{StaticResource TotalTextStyle}" 
                                   Foreground="#34D399"/>
                    </Border>

                    <!-- Totaux Crédit -->
                    <Border Grid.Column="6" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalCreditBalanceEntreeFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalCreditMouvAnterieurFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalCreditMouvMoisFormate}" Style="{StaticResource TotalTextStyle}"/>
                    </Border>
                    <Border Grid.Column="9" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalCreditFormate}" Style="{StaticResource TotalTextStyle}" 
                                   Foreground="#F87171"/>
                    </Border>

                    <!-- Totaux Solde -->
                    <Border Grid.Column="10" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalSoldeDebiteurFormate}" Style="{StaticResource TotalTextStyle}" 
                                   Foreground="#34D399"/>
                    </Border>
                    <Border Grid.Column="11" Style="{StaticResource TotalCellStyle}">
                        <TextBlock Text="{Binding Totaux.TotalSoldeCrebiteurFormate}" Style="{StaticResource TotalTextStyle}" 
                                   Foreground="#F87171"/>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- RÉSUMÉ DE LA BALANCE (nouveau) -->
                <!-- ═══════════════════════════════════════ -->
                <Border Margin="0,20,0,0" Background="#F8FAFC" CornerRadius="8" Padding="20" 
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Style="{StaticResource NotNullVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Débit -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Total Débits" FontSize="12" Foreground="#64748B" 
                                       TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Totaux.TotalDebitFormate}" FontSize="20" FontWeight="Bold" 
                                       Foreground="#059669" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Total Crédit -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Total Crédits" FontSize="12" Foreground="#64748B" 
                                       TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Totaux.TotalCreditFormate}" FontSize="20" FontWeight="Bold" 
                                       Foreground="#DC2626" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Solde Débiteur -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Solde Débiteur" FontSize="12" Foreground="#64748B" 
                                       TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Totaux.TotalSoldeDebiteurFormate}" FontSize="20" FontWeight="Bold" 
                                       Foreground="#059669" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Solde Créditeur -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="Solde Créditeur" FontSize="12" Foreground="#64748B" 
                                       TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Totaux.TotalSoldeCrebiteurFormate}" FontSize="20" FontWeight="Bold" 
                                       Foreground="#DC2626" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════ -->
        <!-- BARRE DE STATUT -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#F8FAFC" Padding="20,14"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MessageErreur}" Foreground="#EF4444" FontWeight="Medium"
                               Visibility="{Binding MessageErreur, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <CheckBox Content="Afficher les comptes vides" 
                              IsChecked="{Binding AfficherComptesVides}"
                              Foreground="#64748B"
                              Margin="0,0,28,0"/>

                    <!-- Badge Comptes - Gris -->
                    <Border Background="#F1F5F9" CornerRadius="16" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Counter" Foreground="#64748B" Width="16" Height="16" 
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Foreground="#475569" VerticalAlignment="Center">
                                <Run Text="Comptes : "/>
                                <Run Text="{Binding Statistiques.NombreComptes, Mode=OneWay}" FontWeight="Bold" Foreground="#1E293B"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Badge Débiteurs - Vert -->
                    <Border Background="#D1FAE5" CornerRadius="16" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" Foreground="#059669" Width="16" Height="16" 
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Foreground="#065F46" VerticalAlignment="Center">
                                <Run Text="Débiteurs : "/>
                                <Run Text="{Binding Statistiques.NombreComptesDebiteurs, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Badge Créditeurs - Rouge -->
                    <Border Background="#FEE2E2" CornerRadius="16" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingDown" Foreground="#DC2626" Width="16" Height="16" 
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Foreground="#991B1B" VerticalAlignment="Center">
                                <Run Text="Créditeurs : "/>
                                <Run Text="{Binding Statistiques.NombreComptesCrediteures, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre de chargement -->
        <ProgressBar Grid.Row="2" 
                     IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                     VerticalAlignment="Top"
                     Foreground="#6366F1"
                     Background="Transparent"
                     Height="3"/>
    </Grid>
</UserControl>
