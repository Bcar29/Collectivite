<Page x:Class="Collectivite.Views.Pages.OrdreRecetteDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails Ordre de Recette">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,20,40,40" MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête avec navigation -->
                <DockPanel Margin="0,0,0,20">
                    <!-- Bouton retour -->
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding NavigateBackCommand}"
                            DockPanel.Dock="Left"
                            Width="40"
                            Height="40"
                            Margin="0,0,15,0"
                            ToolTip="Retour à la liste">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                               Width="28" 
                                               Height="28"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="Détails de l'ordre de recette"
                                 FontSize="22"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                                DockPanel.Dock="Right" 
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PrintCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding NavigateToEditCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Margin="0,0,5,0"/>
                                <TextBlock Text="Modifier"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding DeleteCommand}"
                                Background="#F44336"
                                BorderBrush="#F44336"
                                Height="36">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Margin="0,0,5,0"/>
                                <TextBlock Text="Supprimer"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Bandeau numéro d'ordre -->
                <Border Grid.Row="1"
                        Background="#1976D2"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="Barcode" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"
                                               Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Numéro d'ordre"
                                       Foreground="White"
                                       FontSize="12"
                                       Opacity="0.9"/>
                            <TextBlock Text="{Binding NumeroOrdre}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Date"
                                       Foreground="White"
                                       FontSize="12"
                                       Opacity="0.9"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DateOrdre}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Contenu des détails -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne gauche -->
                    <StackPanel Grid.Column="0">

                        <!-- Section Informations générales -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="INFORMATIONS GÉNÉRALES"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Exercice -->
                                <DockPanel Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="CalendarRange" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#666"
                                                           VerticalAlignment="Top"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Exercice"
                                                 FontSize="11"
                                                 Foreground="#999"/>
                                        <TextBlock Text="{Binding Exercice}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#424242"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Commune -->
                                <DockPanel Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="MapMarker" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#666"
                                                           VerticalAlignment="Top"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Commune"
                                                 FontSize="11"
                                                 Foreground="#999"/>
                                        <TextBlock Text="{Binding Commune}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#424242"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Comptable -->
                                <DockPanel Margin="0,0,0,0">
                                    <materialDesign:PackIcon Kind="AccountTie" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#666"
                                                           VerticalAlignment="Top"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Comptable"
                                                 FontSize="11"
                                                 Foreground="#999"/>
                                        <TextBlock Text="{Binding Comptable}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="#424242"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Section Ligne budgétaire -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="LIGNE BUDGÉTAIRE"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Chapitre -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Chapitre :"
                                             FontSize="12"
                                             Foreground="#666"
                                             Width="80"
                                             DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Chapitre}"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Foreground="#424242"/>
                                </DockPanel>

                                <!-- Article -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Article :"
                                             FontSize="12"
                                             Foreground="#666"
                                             Width="80"
                                             DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Article}"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Foreground="#424242"/>
                                </DockPanel>

                                <!-- Intitulé -->
                                <Border Background="#F5F5F5"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,5,0,0">
                                    <TextBlock Text="{Binding LigneBudgetaire}"
                                             TextWrapping="Wrap"
                                             FontSize="13"
                                             Foreground="#424242"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Section Tiers -->
                        <materialDesign:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="TIERS"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,10"/>

                                <DockPanel>
                                    <materialDesign:PackIcon Kind="AccountCircle" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#666"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Tiers}"
                                             FontSize="14"
                                             VerticalAlignment="Center"
                                             Foreground="#424242"/>
                                </DockPanel>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>

                    <!-- Colonne droite -->
                    <StackPanel Grid.Column="2">

                        <!-- Section Montant -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="MONTANT"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,15"/>

                                <!-- Montant en chiffres -->
                                <Border Background="#E3F2FD"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,0,0,15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Montant en chiffres"
                                                 FontSize="12"
                                                 Foreground="#1976D2"
                                                 HorizontalAlignment="Center"
                                                 Opacity="0.8"/>
                                        <TextBlock Text="{Binding MontantChiffres}"
                                                 FontSize="28"
                                                 FontWeight="Bold"
                                                 Foreground="#1976D2"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Montant en lettres -->
                                <TextBlock Text="Montant en lettres :"
                                         FontSize="12"
                                         Foreground="#666"
                                         Margin="0,0,0,8"/>
                                <Border Background="#F5F5F5"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15">
                                    <TextBlock Text="{Binding MontantLettres}"
                                             TextWrapping="Wrap"
                                             FontSize="13"
                                             FontStyle="Italic"
                                             Foreground="#424242"
                                             LineHeight="20"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Section Motifs -->
                        <materialDesign:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="MOTIFS / OBSERVATIONS"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Margin="0,0,0,10"/>

                                <Border Background="#FFFDE7"
                                        BorderBrush="#FFF59D"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15"
                                        MinHeight="100">
                                    <TextBlock Text="{Binding Motifs}"
                                             TextWrapping="Wrap"
                                             FontSize="13"
                                             Foreground="#424242"
                                             LineHeight="20"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>