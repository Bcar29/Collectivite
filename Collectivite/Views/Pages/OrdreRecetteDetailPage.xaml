<Page x:Class="Collectivite.Views.Pages.OrdreRecetteDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails Ordre de Recette">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverters x:Key="StringToVis"/>
        <converters:InverseStringToVisibilityConverter x:Key="InverseStringToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              Command="{Binding NavigateBackCommand}"
                              ToolTip="Retour"
                              Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                   Width="24" 
                                                   Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Détails de l'Ordre de Recette" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding PrintCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ExportPdfCommand}"
                            Height="36"
                            Background="DarkRed"
                            BorderBrush="DarkRed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Contenu -->
                <materialDesign:Card Padding="30">
                    <StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- EN-TÊTE OFFICIEL GUINÉEN -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colonne gauche : Ministère -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ministère de l'Administration du Territoire"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"/>
                                <TextBlock Text="et de la Décentralisation"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"/>
                                <TextBlock Text="Direction Générale des Collectivités Locales"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="#475569"
                                         Margin="0,5,0,0"/>

                                <!-- Infos géographiques -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="REGION ADMINISTRATIVE DE "/>
                                        <Run Text="{Binding Commune.RegionCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="PREFECTURE DE "/>
                                        <Run Text="{Binding Commune.PrefectureCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="COMMUNE "/>
                                        <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <Run Text=" DE "/>
                                        <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Colonne centrale : Drapeau -->
                            <StackPanel Grid.Column="1" 
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="30,0">
                                <Border CornerRadius="3" 
            BorderBrush="#424242" 
            BorderThickness="1"
            HorizontalAlignment="Center"
            Effect="{StaticResource MaterialDesignShadowDepth1}">
                                    <Grid Width="54" Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#CE1126"/>
                                        <Rectangle Grid.Column="1" Fill="#FCD116"/>
                                        <Rectangle Grid.Column="2" Fill="#009460"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- Colonne droite : République -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="REPUBLIQUE DE GUINEE"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"
                                         HorizontalAlignment="Right"/>
                                <TextBlock Text="Travail - Justice - Solidarité"
                                         FontSize="12"
                                         FontStyle="Italic"
                                         Foreground="#475569"
                                         HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Titre du document avec bandeau -->
                        <StackPanel Margin="0,0,0,25">
                            <!-- Titre principal -->
                            <TextBlock Text="ORDRE DE RECETTE"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,8"/>

                            <!-- Bandeau avec commune -->
                            <Border Background="#D1FAE5"
                                    BorderBrush="#059669"
                                    BorderThickness="0,2"
                                    Padding="15,8"
                                    HorizontalAlignment="Center"
                                    MinWidth="400">
                                <TextBlock HorizontalAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Foreground="#065F46">
                                    <Run Text="DE LA COMMUNE "/>
                                    <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}"/>
                                    <Run Text=" DE "/>
                                    <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Exercice -->
                            <TextBlock FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Center"
                                     Margin="0,10,0,0">
                                <Run Text="{Binding OrdreRecette.Exercice.Libelle, FallbackValue='2025'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Separator Margin="0,0,0,20"/>

                        <!-- Informations générales -->
                        <TextBlock Text="📋 Informations générales"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° Ordre :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrdreRecette.NumeroOrdre}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date d'ordre :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrdreRecette.DateOrdre, StringFormat='dd/MM/yyyy'}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Exercice :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrdreRecette.Exercice.Libelle}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Commune :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OrdreRecette.Commune.Nom}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ligne budgétaire :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OrdreRecette.BudgetLine.Nommenclature.Intitule}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Imputation :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding OrdreRecette.BudgetLine.Nommenclature.CodeNomenclature}"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Tiers :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding OrdreRecette.Tiers.NomComplet, FallbackValue='Non spécifié'}"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Comptable :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding OrdreRecette.Comptable, FallbackValue='Non défini'}"/>
                        </Grid>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Montant -->
                        <TextBlock Text="💰 Montant"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <!-- Montant en chiffres -->
                        <Border Background="#E3F2FD" 
                                BorderBrush="#1976D2"
                                BorderThickness="2"
                                CornerRadius="8" 
                                Padding="15" 
                                Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="MONTANT DE L'ORDRE :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OrdreRecette.MontantOrdre, StringFormat={}{0:N0} GNF}" 
                                         FontSize="24" 
                                         FontWeight="Bold" 
                                         Foreground="#1976D2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Montant en lettres -->
                        <Border Background="#F9FBE7" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Montant en lettres :" 
                                         FontWeight="SemiBold" 
                                         FontSize="12"
                                         Foreground="#666"
                                         Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding OrdreRecette.MontantOrdreLettre}" 
                                         FontSize="14"
                                         FontStyle="Italic"
                                         TextWrapping="Wrap"
                                         Foreground="#33691E"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Motifs -->
                        <TextBlock Text="📝 Motifs / Observations"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Border Background="#FFFDE7"
                                BorderBrush="#FFF59D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                MinHeight="80"
                                Margin="0,0,0,20">
                            <TextBlock Text="{Binding OrdreRecette.Motifs, FallbackValue='Aucun motif'}" 
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     Foreground="#424242"/>
                        </Border>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Historique des encaissements (TOUS les mouvements) -->
                        <StackPanel Visibility="{Binding HasMouvement, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="💳 Historique des encaissements"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="#1976D2"
                                     Margin="0,0,0,15"/>

                            <!-- Liste de tous les mouvements -->
                            <ItemsControl ItemsSource="{Binding TousLesMouvements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F5F5" 
                                                CornerRadius="8" 
                                                Padding="15"
                                                Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Colonne gauche -->
                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Date -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Date :" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Date, StringFormat='dd/MM/yyyy'}" FontSize="12"/>

                                                        <!-- Montant -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Montant :" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Montant, StringFormat={}{0:N0} GNF}" FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Colonne droite -->
                                                <StackPanel Grid.Column="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Mode de paiement -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode :" FontSize="12" FontWeight="SemiBold"/>
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="18" Height="18" Foreground="#1976D2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Kind" Value="Cash"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RefVirement, Converter={StaticResource StringToVis}}" Value="Visible">
                                                                                <Setter Property="Kind" Value="BankTransfer"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RefChèque, Converter={StaticResource StringToVis}}" Value="Visible">
                                                                                <Setter Property="Kind" Value="CheckDecagram"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1976D2">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Espèces"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RefVirement, Converter={StaticResource StringToVis}}" Value="Visible">
                                                                                <Setter Property="Text" Value="Virement bancaire"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RefChèque, Converter={StaticResource StringToVis}}" Value="Visible">
                                                                                <Setter Property="Text" Value="Chèque"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- SI VIREMENT -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Réf. virement :" FontSize="12" FontWeight="SemiBold"
                                                                 Visibility="{Binding RefVirement, Converter={StaticResource StringToVis}}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RefVirement}" FontSize="12"
                                                                 Visibility="{Binding RefVirement, Converter={StaticResource StringToVis}}"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Num Compte :" FontSize="12" FontWeight="SemiBold"
                                                                 Visibility="{Binding RefVirement, Converter={StaticResource StringToVis}}"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NumBanqueBenef, FallbackValue='N/A'}" FontSize="12"
                                                                 Visibility="{Binding RefVirement, Converter={StaticResource StringToVis}}"/>

                                                        <!-- SI CHÈQUE -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Réf. chèque :" FontSize="12" FontWeight="SemiBold"
                                                                 Visibility="{Binding RefChèque, Converter={StaticResource StringToVis}}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RefChèque}" FontSize="12"
                                                                 Visibility="{Binding RefChèque, Converter={StaticResource StringToVis}}"/>

                                                        <!-- SI ESPÈCES -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding RefVirement, Converter={StaticResource StringToVis}}" Value="Collapsed"/>
                                                                                <Condition Binding="{Binding RefChèque, Converter={StaticResource StringToVis}}" Value="Collapsed"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="Référence : " FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Espèces" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <!-- Section Signatures (uniquement si ordre validé) -->
                        <StackPanel Visibility="{Binding IsOrdreValide, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,30,0,20"/>

                            <Grid Margin="0,0,0,0">
                                <!-- Le Maire -->
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock FontSize="12" 
                                             Foreground="#666"
                                             Margin="0,0,0,8">
                                        <Run Text="{Binding OrdreRecette.Commune.Nom}"/>
                                        <Run Text=" Le "/>
                                        <Run Text=".............."/>
                                        <Run Text=" / "/>
                                        <Run Text=".............."/>
                                        <Run Text=" / "/>
                                        <Run Text=".............."/>
                                    </TextBlock>

                                    <TextBlock 
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Margin="0,30,0,0">
                                        <Run Text="L'Ordonateur :  "/>
                                    </TextBlock>
                                    <TextBlock 
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Margin="0,40,0,0">
                                        <Run Text="M./Mme :  "/>
                                        <Run Text="......................................................"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>