<Page x:Class="Collectivite.Views.Pages.OrdreRecetteDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails Ordre de Recette">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1000">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                              Command="{Binding NavigateBackCommand}"
                              ToolTip="Retour"
                              Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                   Width="24" 
                                                   Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Détails de l'Ordre de Recette" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding PrintCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ExportPdfCommand}"
                            Height="36"
                            Background="DarkRed"
                            BorderBrush="DarkRed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Contenu -->
                <materialDesign:Card Padding="30">
                    <StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- EN-TÊTE OFFICIEL GUINÉEN -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colonne gauche : Ministère -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ministère de l'Administration du Territoire"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"/>
                                <TextBlock Text="et de la Décentralisation"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"/>
                                <TextBlock Text="Direction Générale des Collectivités Locales"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="#475569"
                                         Margin="0,5,0,0"/>

                                <!-- Infos géographiques -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="REGION ADMINISTRATIVE DE "/>
                                        <Run Text="{Binding Commune.RegionCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="PREFECTURE DE "/>
                                        <Run Text="{Binding Commune.PrefectureCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="COMMUNE "/>
                                        <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <Run Text=" DE "/>
                                        <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Colonne centrale : Symbole -->
                            <StackPanel Grid.Column="1" 
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Center"
                                       Margin="20,0">
                                <TextBlock Text="⚜" 
                                         FontSize="36" 
                                         Foreground="#059669"
                                         HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Colonne droite : République -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="REPUBLIQUE DE GUINEE"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Foreground="#1E293B"
                                         HorizontalAlignment="Right"/>
                                <TextBlock Text="Travail - Justice - Solidarité"
                                         FontSize="12"
                                         FontStyle="Italic"
                                         Foreground="#475569"
                                         HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Titre du document avec bandeau -->
                        <StackPanel Margin="0,0,0,25">
                            <!-- Titre principal -->
                            <TextBlock Text="ORDRE DE RECETTE"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,8"/>

                            <!-- Bandeau avec commune -->
                            <Border Background="#D1FAE5"
                                    BorderBrush="#059669"
                                    BorderThickness="0,2"
                                    Padding="15,8"
                                    HorizontalAlignment="Center"
                                    MinWidth="400">
                                <TextBlock HorizontalAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         Foreground="#065F46">
                                    <Run Text="DE LA COMMUNE "/>
                                    <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}"/>
                                    <Run Text=" DE "/>
                                    <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Exercice -->
                            <TextBlock FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Center"
                                     Margin="0,10,0,0">
                                
                                <Run Text="{Binding OrdreRecette.Exercice.Libelle, FallbackValue='2025'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Separator Margin="0,0,0,20"/>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- Informations générales -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <TextBlock Text="📋 Informations générales"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° Ordre :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrdreRecette.NumeroOrdre}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date d'ordre :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrdreRecette.DateOrdre, StringFormat='dd/MM/yyyy'}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Exercice :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OrdreRecette.Exercice.Libelle}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Commune :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OrdreRecette.Commune.Nom}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ligne budgétaire :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OrdreRecette.BudgetLine.Nommenclature.Intitule}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Imputation :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding OrdreRecette.BudgetLine.Nommenclature.CodeNomenclature}"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Tiers :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding OrdreRecette.Tiers.Nom, FallbackValue='Non spécifié'}"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Comptable :" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding OrdreRecette.Comptable, FallbackValue='Non défini'}"/>
                        </Grid>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Montant -->
                        <TextBlock Text="💰 Montant"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <!-- Montant en chiffres -->
                        <Border Background="#E3F2FD" 
                                BorderBrush="#1976D2"
                                BorderThickness="2"
                                CornerRadius="8" 
                                Padding="15" 
                                Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="MONTANT DE L'ORDRE :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OrdreRecette.MontantOrdre, StringFormat={}{0:N0} GNF}" 
                                         FontSize="24" 
                                         FontWeight="Bold" 
                                         Foreground="#1976D2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Montant en lettres -->
                        <Border Background="#F9FBE7" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Montant en lettres :" 
                                         FontWeight="SemiBold" 
                                         FontSize="12"
                                         Foreground="#666"
                                         Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding OrdreRecette.MontantOrdreLettre}" 
                                         FontSize="14"
                                         FontStyle="Italic"
                                         TextWrapping="Wrap"
                                         Foreground="#33691E"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Motifs -->
                        <TextBlock Text="📝 Motifs / Observations"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <Border Background="#FFFDE7"
                                BorderBrush="#FFF59D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                MinHeight="80"
                                Margin="0,0,0,20">
                            <TextBlock Text="{Binding OrdreRecette.Motifs, FallbackValue='Aucun motif'}" 
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     Foreground="#424242"/>
                        </Border>

                        <Separator Margin="0,10,0,20"/>

                        <!-- Informations d'encaissement (visible seulement si Mouvement existe) -->
                        <StackPanel Visibility="{Binding HasMouvement, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="💳 Informations d'encaissement"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="#1976D2"
                                     Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Date d'encaissement -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date d'encaissement :" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Mouvement.Date, StringFormat='dd/MM/yyyy'}"/>

                                <!-- Montant encaissé -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Montant encaissé :" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Mouvement.Montant, StringFormat={}{0:N0} GNF}" FontWeight="SemiBold" Foreground="#4CAF50"/>

                                <!-- Mode d'encaissement -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mode d'encaissement :" FontWeight="SemiBold"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding ModePaiementIcon}" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#1976D2"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ModePaiement}" FontWeight="SemiBold" Foreground="#1976D2"/>
                                </StackPanel>

                                <!-- Référence Virement (si virement) -->
                                <TextBlock Grid.Row="6" Grid.Column="0" 
                                         Text="Référence virement :" 
                                         FontWeight="SemiBold"
                                         Visibility="{Binding EstVirement, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" 
                                         Text="{Binding Mouvement.RefVirement}"
                                         Visibility="{Binding EstVirement, Converter={StaticResource BoolToVis}}"/>

                                <!-- Référence Chèque (si chèque) -->
                                <TextBlock Grid.Row="8" Grid.Column="0" 
                                         Text="Référence chèque :" 
                                         FontWeight="SemiBold"
                                         Visibility="{Binding EstCheque, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" 
                                         Text="{Binding Mouvement.RefChèque}"
                                         Visibility="{Binding EstCheque, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Section Signatures (uniquement si ordre validé) -->
                        <StackPanel Visibility="{Binding IsOrdreValide, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,30,0,20"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>



                                <!-- Le Maire -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                                    <TextBlock FontSize="12" 
                                        Foreground="#666"
                                        Margin="0,0,0,8">
                                        <Run Text="{Binding OrdreRecette.Commune.Nom}"/>
                                        <Run Text=" Le "/>
                                        <Run Text=".............."/>
                                        <Run Text=" / "/>
                                        <Run Text=".............."/>
                                        <Run Text=" / "/>
                                        <Run Text=".............."/>
                                    </TextBlock>

                                    <TextBlock 
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Margin="0,30,0,0">
                                        <Run Text="L'Ordonateur :  "/>
                                        <Run Text=""/>
                                    </TextBlock>
                                    <TextBlock 
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Margin="0,40,0,0">
                                        <Run Text="M./Mme :  "/>
                                        <Run Text="........................................................................................................"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
