<Page x:Class="Collectivite.Views.Pages.DetailCommunePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:Collectivite.Views.Controls"
      Language="fr-FR"
      Background="{StaticResource AppPageBackgroundBrush}"
      Title="Détails des Communes">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <utils:EnumToVisibilityConverter x:Key="StepEqualsConverter"/>
        <utils:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <!-- OVERLAY DE CHARGEMENT -->
        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..."
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- CONTENU PRINCIPAL -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- HEADER -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource PageHeaderIconStyle}"/>
                        <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="Détails des Communes" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                            <TextBlock Text="Données démographiques, administratives et sociales par commune et par exercice"
                                     Style="{StaticResource SectionSubtitleTextStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Command="{Binding OpenAddDetailCommuneCommand}"
                            Visibility="{Binding CanCreateDetailCommune, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Ajouter des Détails"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DATAGRID -->
                <materialDesign:Card Padding="0" UniformCornerRadius="8">
                <DataGrid ItemsSource="{Binding DetailCommunes}"
                          SelectedItem="{Binding SelectedDetailCommune}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="52"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                          AlternationCount="2"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12 14">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Resources>
                        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,16,0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- Commune -->
                        <DataGridTemplateColumn Header="Commune" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MapMarker"
                                                               Width="18" Height="18"
                                                               Foreground="{StaticResource AppPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Commune.Nom}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Exercice -->
                        <DataGridTemplateColumn Header="Exercice" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppPrimaryLightBrush}"
                                          CornerRadius="12"
                                          Padding="10,4"
                                          HorizontalAlignment="Left"
                                          Visibility="{Binding Exercice, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Exercice.Libelle}"
                                                 FontSize="12"
                                                 FontWeight="Medium"
                                                 Foreground="{StaticResource AppPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Population -->
                        <DataGridTextColumn Header="Population"
                                          Binding="{Binding PopulationTotale, StringFormat=N0, ConverterCulture='fr-FR'}"
                                          Width="110"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Superficie -->
                        <DataGridTextColumn Header="Superficie (km²)"
                                          Binding="{Binding Superficie, StringFormat=N2, ConverterCulture='fr-FR'}"
                                          Width="120"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Densité -->
                        <DataGridTextColumn Header="Densité (hab/km²)"
                                          Binding="{Binding Densite, StringFormat=N2, ConverterCulture='fr-FR'}"
                                          Width="130"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Conseillers -->
                        <DataGridTextColumn Header="Conseillers"
                                          Binding="{Binding NombreConseillers}"
                                          Width="100"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Écoles -->
                        <DataGridTextColumn Header="Écoles"
                                          Binding="{Binding NombreEcoles}"
                                          Width="80"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Centres de santé -->
                        <DataGridTextColumn Header="Centres Santé"
                                          Binding="{Binding NombreCentresSante}"
                                          Width="110"
                                          ElementStyle="{StaticResource RightAlignedCellStyle}"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                        <StackPanel>
                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.OpenEditDetailCommuneCommand,
                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanEditDetailCommune, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Modifier"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                    Command="{Binding DataContext.DeleteDetailCommuneCommand,
                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanDeleteDetailCommune, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="{StaticResource AppDangerBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Supprimer"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- DIALOG MODAL : ASSISTANT PAR ÉTAPES -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                 CloseOnClickAway="False"
                                 Panel.ZIndex="900">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="850" MaxHeight="680">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Border Grid.Row="0"
                              Background="{DynamicResource PrimaryHueMidBrush}"
                              Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                       Width="28"
                                                       Height="28"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding DialogTitle}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- BARRE D'ÉTAPES -->
                        <StackPanel Grid.Row="1" Margin="30,20,30,10">
                            <controls:WizardStepIndicator Steps="{Binding StepTitles}"
                                                           CurrentStepIndex="{Binding CurrentStepIndex}"/>
                            <TextBlock Text="{Binding CurrentStepNumberLabel}"
                                       Style="{StaticResource SectionSubtitleTextStyle}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Medium"
                                       Margin="0,15,0,0"/>
                        </StackPanel>

                        <!-- CONTENU SCROLLABLE -->
                        <ScrollViewer Grid.Row="2"
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="20,0,20,20">
                            <StackPanel>

                                <!-- Commune / Exercice (TOUJOURS VISIBLE, hors étapes) -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,15"
                                                   Background="{StaticResource AppPrimaryLightBrush}">
                                    <StackPanel>
                                        <ComboBox materialDesign:HintAssist.Hint="Commune *"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  ItemsSource="{Binding Communes}"
                                                  SelectedValue="{Binding DialogDetailCommune.IdCommune}"
                                                  SelectedValuePath="Id"
                                                  IsReadOnly="True"
                                                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}"
                                                  DisplayMemberPath="Nom"/>

                                        <ComboBox Margin="0,10,0,0"
                                                  materialDesign:HintAssist.Hint="Exercice"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  ItemsSource="{Binding Exercices}"
                                                  SelectedItem="{Binding SelectedExercice}"
                                                  DisplayMemberPath="Libelle"
                                                  utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 1 : DÉMOGRAPHIE ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=0}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Démographie" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Population hommes"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding PopulationHommes, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Population femmes"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding PopulationFemmes, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                   materialDesign:HintAssist.Hint="Population totale (calculée automatiquement)"
                                                   Style="{StaticResource ComputedFieldTextBoxStyle}"
                                                   Text="{Binding PopulationTotale, Mode=OneWay}"/>

                                            <TextBox Grid.Row="4" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Superficie (km²) *"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding Superficie, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="4" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Densité (hab/km², calculée automatiquement)"
                                                   Style="{StaticResource ComputedFieldTextBoxStyle}"
                                                   Text="{Binding Densite, Mode=OneWay, StringFormat=N2}"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 2 : ADMINISTRATION & PERSONNEL ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=1}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="OfficeBuilding" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Administration &amp; Personnel" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Nombre de conseillers"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreConseillers}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Délégations spéciales"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreDelegationSpeciale}"/>
                                        </Grid>

                                        <TextBlock Text="Divisions territoriales"
                                                 FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AppMutedTextBrush}"
                                                 Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Quartiers"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreQuartiers}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Districts"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreDistricts}"/>

                                            <TextBox Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Secteurs"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreSecteurs}"/>
                                        </Grid>

                                        <TextBlock Text="Effectif du personnel"
                                                 FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AppMutedTextBrush}"
                                                 Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Total"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.EffectifTotalPersonnel}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Permanent"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.EffectifPermanent}"/>

                                            <TextBox Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Temporaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.EffectifTemporaire}"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 3 : ÉDUCATION ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=2}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="School" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Éducation" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <TextBox materialDesign:HintAssist.Hint="Total écoles (calculé automatiquement)"
                                               Style="{StaticResource ComputedFieldTextBoxStyle}"
                                               Text="{Binding NombreEcoles, Mode=OneWay}"
                                               Margin="0,0,0,15"/>

                                        <TextBlock Text="Écoles par niveau"
                                                 FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AppMutedTextBrush}"
                                                 Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Préscolaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding NombreEcolesPrescolaire, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Primaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding NombreEcolesPrimaire, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Collège"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding NombreEcolesCollege, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBox Grid.Row="2" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Lycée"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding NombreEcolesLycee, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <TextBlock Text="Classes par niveau"
                                                 FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AppMutedTextBrush}"
                                                 Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Classes préscolaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreClassesPrescolaire}"/>

                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Classes primaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreClassesPrimaire}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Classes collège"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreClassesCollege}"/>

                                            <TextBox Grid.Row="2" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Classes lycée"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreClassesLycee}"/>
                                        </Grid>

                                        <TextBlock Text="Élèves par niveau"
                                                 FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource AppMutedTextBrush}"
                                                 Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Élèves préscolaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreElevesPrescolaire}"/>

                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Élèves primaire"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreElevesPrimaire}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Élèves collège"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreElevesCollege}"/>

                                            <TextBox Grid.Row="2" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Élèves lycée"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreElevesLycee}"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 4 : SANTÉ & INFRASTRUCTURES ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=3}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="Hospital" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Santé &amp; Infrastructures" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Centres de santé"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreCentresSante}"/>

                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Postes de santé"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombrePostesSante}"/>

                                            <TextBox Grid.Row="0" Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Santé améliorée"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreSanteAmelioree}"/>

                                            <TextBox Grid.Row="2" Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Forages"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreForages}"/>

                                            <TextBox Grid.Row="2" Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Points d'eau"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombrePointsEau}"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 5 : ONG & ORGANISATIONS ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=4}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="HandshakeOutline" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="ONG &amp; Organisations" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Total ONG"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreOng}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Nationales"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreOngNationales}"/>

                                            <TextBox Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Étrangères"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreOngEtrangeres}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Associations"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreAssociation}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Groupements"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreGroupements}"/>

                                            <TextBox Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Coopératives"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreCooperatives}"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ═══ ÉTAPE 6 : ÉCONOMIE & SÉCURITÉ ═══ -->
                                <materialDesign:Card Padding="15" Margin="0,0,0,10"
                                        Visibility="{Binding CurrentStepIndex, Converter={StaticResource StepEqualsConverter}, ConverterParameter=5}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <materialDesign:PackIcon Kind="ShoppingOutline" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Économie &amp; Sécurité" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                   materialDesign:HintAssist.Hint="Total marchés"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreMarches}"/>

                                            <TextBox Grid.Column="2"
                                                   materialDesign:HintAssist.Hint="Journaliers"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreMarchesJournaliers}"/>

                                            <TextBox Grid.Column="4"
                                                   materialDesign:HintAssist.Hint="Hebdomadaires"
                                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                   Text="{Binding DialogDetailCommune.NombreMarchesHebdomadaires}"/>
                                        </Grid>

                                        <TextBox materialDesign:HintAssist.Hint="Détenteurs d'armes à feu"
                                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                               Text="{Binding DialogDetailCommune.NombreDetenteursArmesFeu}"/>
                                    </StackPanel>
                                </materialDesign:Card>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- FOOTER (NAVIGATION) -->
                        <Border Grid.Row="3"
                              Background="{StaticResource AppPageBackgroundBrush}"
                              BorderBrush="{StaticResource AppBorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="20">
                            <Grid>
                                <TextBlock Text="* Champs obligatoires"
                                         FontSize="11"
                                         Foreground="{StaticResource AppMutedTextBrush}"
                                         FontStyle="Italic"
                                         VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                          Content="Annuler"
                                          Command="{Binding CancelDetailCommuneCommand}"
                                          Margin="0,0,10,0"
                                          Width="100"
                                          Height="40"/>

                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                          Command="{Binding GoToPreviousStepCommand}"
                                          Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVis}}"
                                          Margin="0,0,10,0"
                                          Width="120"
                                          Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChevronLeft" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Précédent" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                          Command="{Binding GoToNextStepCommand}"
                                          Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVis}}"
                                          Width="120"
                                          Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Suivant" VerticalAlignment="Center"/>
                                            <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                          Command="{Binding SaveDetailCommuneCommand}"
                                          Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"
                                          Width="140"
                                          Height="40">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>
