<UserControl x:Class="Collectivite.Views.Pages.DebiteurCrediteurPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Collectivite.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <!-- Style pour les badges de statut -->
        <Style x:Key="StatutBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- EN-TÊTE -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="20,15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TitrePage}" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="#1976D2"/>
                    <TextBlock Text="Suivi des créances et dettes par tiers" 
                               FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Boutons d'action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterExcelCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterPdfCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ImprimerCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BARRE DE FILTRES -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="16,12" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Recherche" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                             materialDesign:HintAssist.Hint="Rechercher par nom, NIF ou téléphone..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             MaxWidth="400"/>
                </StackPanel>

                <!-- Filtre Statut -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Statut" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding StatutsDisponibles}"
                              SelectedItem="{Binding StatutFiltre}"
                              converters:ComboBoxAutoCompleteBehavior.IsEnabled="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Checkbox Inclure soldés -->
                <CheckBox Grid.Column="2" 
                          Content="Inclure les soldés" 
                          IsChecked="{Binding InclureSoldes}"
                          VerticalAlignment="Bottom" Margin="0,0,16,8"/>

                <!-- Bouton réinitialiser -->
                <Button Grid.Column="3" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ReinitialiserFiltresCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Réinitialiser"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CONTENU PRINCIPAL - ONGLETS -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2" 
                    SelectedIndex="{Binding OngletSelectionne}"
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    Margin="16">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET DÉBITEURS -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCash" Width="20" Height="20" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Débiteurs" VerticalAlignment="Center"/>
                        <Border Background="#F44336" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding NombreDebiteurs}" 
                                       FontSize="11" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Statistiques Débiteurs -->
                    <Border Grid.Row="0" Background="#FFEBEE" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Total à payer" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalAPayerFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Total payé" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalPayeFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Reste à payer" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding ResteAPayerFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Débiteurs -->
                    <materialDesign:Card Grid.Row="1" Padding="0">
                        <DataGrid ItemsSource="{Binding Debiteurs}"
                                  SelectedItem="{Binding DebiteurSelectionne}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  AlternatingRowBackground="#FAFAFA"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  materialDesign:DataGridAssist.CellPadding="12 8 12 8"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8 12 8">

                            <DataGrid.Columns>
                                <!-- Nom Complet -->
                                <DataGridTemplateColumn Header="Nom / Raison Sociale" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NomComplet}" 
                                                           FontWeight="SemiBold" Foreground="#212121"/>
                                                <TextBlock Text="{Binding CategorieTiers}" 
                                                           FontSize="11" Foreground="#757575"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Type -->
                                <DataGridTemplateColumn Header="Type" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="10" 
                                                    Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TypeTiers}" 
                                                           FontSize="11" Foreground="#1976D2"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Téléphone -->
                                <DataGridTextColumn Header="Téléphone" 
                                                    Binding="{Binding Telephone}" 
                                                    Width="120"/>

                                <!-- Nombre Mandats -->
                                <DataGridTemplateColumn Header="Mandats" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="10" 
                                                    Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding NombreMandats}" 
                                                           FontWeight="Bold" Foreground="#1976D2"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total à payer -->
                                <DataGridTemplateColumn Header="Total à payer" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalMontantAPayerFormate}" 
                                                       FontWeight="SemiBold" Foreground="#F44336"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total payé -->
                                <DataGridTemplateColumn Header="Total payé" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalMontantPayeFormate}" 
                                                       FontWeight="SemiBold" Foreground="#4CAF50"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Reste à payer -->
                                <DataGridTemplateColumn Header="Reste à payer" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" CornerRadius="4" 
                                                    Padding="6,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ResteAPayerFormate}" 
                                                           FontWeight="Bold" Foreground="#FF9800"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Taux -->
                                <DataGridTemplateColumn Header="Taux" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TauxPaiementFormate}" 
                                                           FontSize="11" HorizontalAlignment="Center"/>
                                                <ProgressBar Value="{Binding TauxPaiement, Mode=OneWay}" 
                                                             Maximum="100" Height="4" 
                                                             Foreground="#4CAF50" Background="#E0E0E0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Statut -->
                                <DataGridTemplateColumn Header="Statut" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,3" 
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatutCouleur, Converter={StaticResource StringToBrushConverter}}">
                                                <TextBlock Text="{Binding Statut}" 
                                                           FontSize="11" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dernier paiement -->
                                <DataGridTextColumn Header="Dernier paiement" 
                                                    Binding="{Binding DateDernierPaiementFormate}" 
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET CRÉANCIERS -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCashOutline" Width="20" Height="20" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Créanciers" VerticalAlignment="Center"/>
                        <Border Background="#4CAF50" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding NombreCreanciers}" 
                                       FontSize="11" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Statistiques Créanciers -->
                    <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Total à encaisser" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalAEncaisserFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Total encaissé" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalEncaisseFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Reste à encaisser" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding ResteAEncaisserFormate}" 
                                           FontSize="22" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="GNF" FontSize="11" Foreground="#999999"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Créanciers -->
                    <materialDesign:Card Grid.Row="1" Padding="0">
                        <DataGrid ItemsSource="{Binding Creanciers}"
                                  SelectedItem="{Binding CreancierSelectionne}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  AlternatingRowBackground="#FAFAFA"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  materialDesign:DataGridAssist.CellPadding="12 8 12 8"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8 12 8">

                            <DataGrid.Columns>
                                <!-- Nom Complet -->
                                <DataGridTemplateColumn Header="Nom / Raison Sociale" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NomComplet}" 
                                                           FontWeight="SemiBold" Foreground="#212121"/>
                                                <TextBlock Text="{Binding CategorieTiers}" 
                                                           FontSize="11" Foreground="#757575"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Type -->
                                <DataGridTemplateColumn Header="Type" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="10" 
                                                    Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TypeTiers}" 
                                                           FontSize="11" Foreground="#388E3C"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Téléphone -->
                                <DataGridTextColumn Header="Téléphone" 
                                                    Binding="{Binding Telephone}" 
                                                    Width="120"/>

                                <!-- Nombre Ordres Recette -->
                                <DataGridTemplateColumn Header="Ordres" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="10" 
                                                    Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding NombreOrdresRecette}" 
                                                           FontWeight="Bold" Foreground="#4CAF50"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total à encaisser -->
                                <DataGridTemplateColumn Header="Total à encaisser" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalMontantAEncaisserFormate}" 
                                                       FontWeight="SemiBold" Foreground="#1976D2"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total encaissé -->
                                <DataGridTemplateColumn Header="Total encaissé" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalMontantEncaisseFormate}" 
                                                       FontWeight="SemiBold" Foreground="#4CAF50"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Reste à encaisser -->
                                <DataGridTemplateColumn Header="Reste à encaisser" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" CornerRadius="4" 
                                                    Padding="6,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ResteAEncaisserFormate}" 
                                                           FontWeight="Bold" Foreground="#FF9800"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Taux -->
                                <DataGridTemplateColumn Header="Taux" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TauxEncaissementFormate}" 
                                                           FontSize="11" HorizontalAlignment="Center"/>
                                                <ProgressBar Value="{Binding TauxEncaissement, Mode=OneWay}" 
                                                             Maximum="100" Height="4" 
                                                             Foreground="#4CAF50" Background="#E0E0E0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Statut -->
                                <DataGridTemplateColumn Header="Statut" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,3" 
                                                    HorizontalAlignment="Center"
                                                    Background="{Binding StatutCouleur, Converter={StaticResource StringToBrushConverter}}">
                                                <TextBlock Text="{Binding Statut}" 
                                                           FontSize="11" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dernier encaissement -->
                                <DataGridTextColumn Header="Dernier encaissement" 
                                                    Binding="{Binding DateDernierEncaissementFormate}" 
                                                    Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BARRE DE STATUT -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding MessageErreur}" 
                           Foreground="#D32F2F"
                           Visibility="{Binding MessageErreur, Converter={StaticResource BoolToVisConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                        <Run Text="Débiteurs : "/>
                        <Run Text="{Binding NombreDebiteurs, Mode=OneWay}" FontWeight="Bold" Foreground="#F44336"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Créanciers : "/>
                        <Run Text="{Binding NombreCreanciers, Mode=OneWay}" FontWeight="Bold" Foreground="#4CAF50"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY DE CHARGEMENT -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="4" 
              Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="50" Height="50"/>
                <TextBlock Text="Chargement des données..." 
                           Margin="0,16,0,0" Foreground="#666666"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
