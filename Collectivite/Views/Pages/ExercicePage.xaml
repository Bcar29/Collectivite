<Page x:Class="Collectivite.Views.Pages.ExercicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Exercices">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
       
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Header avec bouton d'ajout -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarRange" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Exercices" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Command="{Binding OpenAddDialogCommand}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Nouvel Exercice" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DataGrid -->
                <materialDesign:Card Padding="0" 
                                   UniformCornerRadius="8">
                    <DataGrid ItemsSource="{Binding Exercices}"
                              SelectedItem="{Binding SelectedExercice}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>

                            <!-- Libelle -->
                            <DataGridTextColumn Header="Libellé" 
                                              Binding="{Binding Libelle}"
                                              Width="250"
                                              FontWeight="Medium"/>

                            <!-- Date de début -->
                            <DataGridTemplateColumn Header="Début de l'exercice" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarStart" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#388E3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateDebut, StringFormat='dd/MM/yyyy'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date de fin -->
                            <DataGridTemplateColumn Header="Fin de l'exercice" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarEnd" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#F57C00"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateFin, StringFormat='dd/MM/yyyy'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Statut -->
                            <DataGridTemplateColumn Header="Statut" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12"
                                              Padding="10,4"
                                              HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstCloture}" Value="True">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="16" Height="16" 
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                            <Setter Property="Foreground" Value="#388E3C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstCloture}" Value="True">
                                                                    <Setter Property="Kind" Value="Lock"/>
                                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>

                                                <TextBlock FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="En cours"/>
                                                            <Setter Property="Foreground" Value="#388E3C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstCloture}" Value="True">
                                                                    <Setter Property="Text" Value="Clôturé"/>
                                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                  HorizontalAlignment="Center">

                                            <!-- Bouton Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Modifier"
                                                  Command="{Binding DataContext.OpenEditDialogCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                                                       Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Bouton Clôturer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Clôturer l'exercice"
                                                  Command="{Binding DataContext.CloturerCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0">
                                                <materialDesign:PackIcon Kind="Lock" 
                                                                       Foreground="#FF9800"/>
                                            </Button>

                                            <!-- Bouton Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Supprimer"
                                                  Command="{Binding DataContext.DeleteCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                                                       Foreground="#F44336"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                 CloseOnClickAway="False"
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="500" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="CalendarRange" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Libelle -->
                    <TextBox materialDesign:HintAssist.Hint="Libellé *"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding DialogExercice.Libelle, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,15"
                           MaxLength="100"/>

                    <!-- Date de début -->
                    <DatePicker materialDesign:HintAssist.Hint="Date de début *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              SelectedDate="{Binding DialogExerciceDateDebut}"
                              Language="fr-FR"
                              Margin="0,0,0,15"/>

                    <!-- Date de fin -->
                    <DatePicker materialDesign:HintAssist.Hint="Date de fin *"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                              SelectedDate="{Binding DialogExerciceDateFin}"
                              Language="fr-FR"
                              Margin="0,0,0,15"/>

                    <!-- Information sur les dates -->
                    <Border Background="#E3F2FD"
                          CornerRadius="8"
                          Padding="12"
                          Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#1976D2"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                            <TextBlock Text="La date de début doit être antérieure à la date de fin"
                                     FontSize="12"
                                     Foreground="#1976D2"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Note explicative -->
                    <TextBlock Text="* Champs obligatoires"
                             FontSize="11"
                             Foreground="#666"
                             FontStyle="Italic"
                             Margin="5,0,0,15"/>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" 
                              HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                              Content="Annuler"
                              Command="{Binding CancelCommand}"
                              Margin="0,0,10,0"
                              Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Enregistrer"
                              Command="{Binding SaveCommand}"
                              Width="120"/>
                    </StackPanel>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>