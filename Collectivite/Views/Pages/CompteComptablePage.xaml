<Page x:Class="Collectivite.Views.Pages.CompteComptablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      xmlns:controls="clr-namespace:Collectivite.Views.Controls"
      Background="#F5F5F5"
      Title="Gestion des Comptes comptable">

    <Page.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <utils:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <utils:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <utils:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="77*"/>
            <ColumnDefinition Width="613*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
      OVERLAY DE CHARGEMENT
      ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
            Panel.ZIndex="999" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="0"
                    IsIndeterminate="True"
                    Width="60"
                    Height="60"/>
                <TextBlock Text="Chargement..." 
                  Foreground="White"
                  FontSize="16"
                  Margin="0,20,0,0"
                  HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
     CONTENU PRINCIPAL
     ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Grid.ColumnSpan="2">
            <StackPanel>

                <!-- ───────────────────────────────────────────────────
             HEADER AVEC BOUTON D'AJOUT
             ─────────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,20">
                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Calculator" 
                                       Width="32" 
                                       Height="32"
                                       Foreground="#1976D2"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Comptes Comptables" 
                         FontSize="24"
                         FontWeight="SemiBold"
                         Margin="15,0,0,0"
                         VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Bouton Ajouter -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="40"
                    Command="{Binding OppenAddCompteCommand}"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding CanCreateCompteComptable}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            <TextBlock Text="Nouveau Compte" 
                             VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ───────────────────────────────────────────────────
             FILTRES (Optionnel - pour naviguer dans la hiérarchie)
             ─────────────────────────────────────────────────── -->
                <materialDesign:Card Padding="15"
                           UniformCornerRadius="8"
                           Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding LoadCompteCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Tous les comptes"
                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding LoadComptesRacinesCommand}"
                                Height="36"
                                Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileTree"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Comptes racines"
                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBox materialDesign:HintAssist.Hint="Rechercher (numéro ou intitulé)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Width="280"
                                 Height="36"
                                 Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding SearchCommand}"
                                Height="36">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ───────────────────────────────────────────────────
             DATAGRID DES COMPTES COMPTABLES
             ─────────────────────────────────────────────────── -->
                <materialDesign:Card Padding="0"
                           UniformCornerRadius="8"
                           Visibility="{Binding CanViewCompteComptable, Converter={StaticResource BoolToVis}}">
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                      ItemsSource="{Binding CompteComptables}"
                      SelectedItem="{Binding SelectedCompte}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>

                            <!-- Numero compte -->
                            <DataGridTextColumn Header="Numéro Compte" 
                                Binding="{Binding NumeroCompte}"
                                Width="200"
                                FontWeight="Medium"/>

                            <!-- Intitule Compte -->
                            <DataGridTextColumn Header="Intitulé Compte" 
                                  Binding="{Binding IntituleCompte}"
                                  Width="*"
                                  FontWeight="Medium"/>

                            <!-- Compte Parent (ContrePartie) -->
                            <DataGridTemplateColumn Header="ContrePartie" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SubdirectoryArrowRight" 
                                                           Width="16" 
                                                           Height="16"
                                                           Foreground="#666"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Visibility="{Binding ContrePartie, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ContrePartie.NumeroCompte}" 
                                             FontSize="12"
                                             Foreground="#666"
                                             VerticalAlignment="Center"/>
                                            <TextBlock Text=" - " 
                                             FontSize="12"
                                             Foreground="#666"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding ContrePartie, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding ContrePartie.IntituleCompte}" 
                                             FontSize="12"
                                             Foreground="#666"
                                             VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nombre de sous-comptes -->
                            <DataGridTemplateColumn Header="Comptes liés" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="28"
                                                Padding="8,4"
                                                Command="{Binding DataContext.LoadSousComptesCommand, 
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding SousComptes.Count}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderOpen" 
                                                               Width="16" 
                                                               Height="16"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding SousComptes.Count}" 
                                                 VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                            <StackPanel>
                                                <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                        Command="{Binding DataContext.OppenEditCompteCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanEditCompteComptable, RelativeSource={RelativeSource AncestorType=Page}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Modifier"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                        Command="{Binding DataContext.DeleteCompteCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanDeleteCompteComptable, RelativeSource={RelativeSource AncestorType=Page}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Foreground="#F44336" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Supprimer"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:PopupBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationBar Grid.Row="1"
                                            PageNumber="{Binding PageNumber}"
                                            TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}"
                                            PreviousCommand="{Binding PreviousPageCommand}"
                                            NextCommand="{Binding NextPageCommand}"/>
                  </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
      DIALOG MODAL AJOUT/MODIFICATION - VERSION AMÉLIORÉE
      ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                          CloseOnClickAway="False"
                          Panel.ZIndex="1000" Grid.ColumnSpan="2">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="650" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Calculator" 
                                        Width="24" 
                                        Height="24"
                                        Foreground="#1976D2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                          FontSize="20"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════
                         SECTION MODE DE SAISIE (visible uniquement en ajout)
                         ═══════════════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVis}}">
                        <TextBlock Text="Mode de saisie" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton Content="Depuis nomenclature"
                                 IsChecked="{Binding IsNommenclatureMode, Mode=TwoWay}"
                                 Margin="0,0,30,0"
                                 FontSize="13"/>

                             <RadioButton Content="Saisie libre"
                                 IsChecked="{Binding IsNommenclatureMode, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                 FontSize="13"/>
                            

                        </StackPanel>

                        <Separator Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════
                         FILTRES NOMENCLATURE (visible uniquement en mode nomenclature)
                         ═══════════════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding IsNommenclatureMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Filtrer les nomenclatures" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nature -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nature" 
                                           FontSize="12"
                                           Foreground="#666"
                                           Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Recette"
                                                 GroupName="Nature"
                                                 IsChecked="{Binding NatureSelectionnee, 
                                                             Converter={StaticResource EnumToBoolConverter}, 
                                                             ConverterParameter={x:Static models:NatureType.Recette}}"
                                                 Margin="0,0,15,0"/>
                                    <RadioButton Content="Dépense"
                                                 GroupName="Nature"
                                                 IsChecked="{Binding NatureSelectionnee, 
                                                             Converter={StaticResource EnumToBoolConverter}, 
                                                             ConverterParameter={x:Static models:NatureType.Depense}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Section -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Section" 
                                           FontSize="12"
                                           Foreground="#666"
                                           Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Fonctionnement"
                                                 GroupName="Section"
                                                 IsChecked="{Binding SectionSelectionnee, 
                                                             Converter={StaticResource EnumToBoolConverter}, 
                                                             ConverterParameter={x:Static models:SectionType.Fonctionnement}}"
                                                 Margin="0,0,15,0"/>
                                    <RadioButton Content="Investissement"
                                                 GroupName="Section"
                                                 IsChecked="{Binding SectionSelectionnee, 
                                                             Converter={StaticResource EnumToBoolConverter}, 
                                                             ConverterParameter={x:Static models:SectionType.Investissement}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════
                         CHAMP NUMÉRO - COMBOBOX ÉDITABLE (Mode Nomenclature)
                         ═══════════════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding IsNommenclatureMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Sélectionner une nomenclature *" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <ComboBox 
                                    materialDesign:HintAssist.Hint="Rechercher ou saisir un code"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"

                                    ItemsSource="{Binding NomenclaturesDisponibles}"
                                    SelectedItem="{Binding NommenclatureSelectionnee}"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    TextSearch.TextPath="CodeNomenclature"
                                    Margin="0,0,0,5"
                                    FontSize="13">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#E3F2FD"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,10,0"
                                            Grid.Column="0">
                                            <TextBlock Text="{Binding CodeNomenclature}" 
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#1976D2"/>
                                        </Border>

                                        <TextBlock Text="{Binding Intitule}" 
                                           VerticalAlignment="Center"
                                           Grid.Column="1"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>


                        <!-- Info sur la nomenclature sélectionnée -->
                        <Border Background="#E8F5E9" 
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,5,0,15"
                                Visibility="{Binding NommenclatureSelectionnee, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <materialDesign:PackIcon Kind="CheckCircle" 
                                                             Width="16" 
                                                             Height="16"
                                                             Foreground="#4CAF50"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Nomenclature sélectionnée" 
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#2E7D32"/>
                                </StackPanel>
                                <TextBlock FontSize="10" Foreground="#2E7D32">
                                    <Run Text="Code:"/>
                                    <Run Text="{Binding NommenclatureSelectionnee.code, Mode=OneWay}" 
                                         FontWeight="Bold"/>
                                    <Run Text=" | Nature:"/>
                                    <Run Text="{Binding NommenclatureSelectionnee.Nature, Mode=OneWay}"/>
                                    <Run Text=" | Section:"/>
                                    <Run Text="{Binding NommenclatureSelectionnee.Section, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════
                         CHAMP NUMÉRO - TEXTBOX (Mode Saisie Libre ou Édition)
                         ═══════════════════════════════════════════════════ -->
                    <TextBox materialDesign:HintAssist.Hint="Numéro du compte *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogCompte.NumeroCompte, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"
                             MaxLength="20"
                             Visibility="{Binding IsSaisieLibreMode}">
                        <TextBox.Background>
                            <SolidColorBrush Color="{Binding IsNommenclatureMode, 
                             Converter={StaticResource BoolToColorConverter}, 
                             ConverterParameter=#F5F5F5|White}"/>
                        </TextBox.Background>
                    </TextBox>
                        <!-- Intitulé Compte (lecture seule en mode nomenclature) -->
                    <TextBox materialDesign:HintAssist.Hint="Intitulé du compte *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogCompte.IntituleCompte, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"
                             MaxLength="255"
                             IsReadOnly="{Binding IsNommenclatureMode}">
                        <TextBox.Background>
                            <SolidColorBrush Color="{Binding IsNommenclatureMode, 
                                             Converter={StaticResource BoolToColorConverter}, 
                                             ConverterParameter=#F5F5F5|White}"/>
                        </TextBox.Background>
                    </TextBox>

                    <!-- Contre Partie (ComboBox) -->
                    <ComboBox materialDesign:HintAssist.Hint="ContrePartie (optionnelle)"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding ComptesParentDisponibles}"
                              SelectedValue="{Binding DialogCompte.ContrePartieId}"
                              SelectedValuePath="Id"
                              Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NumeroCompte}" 
                                               FontWeight="Medium"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="-" 
                                               Margin="0,0,8,0"
                                               Foreground="#666"/>
                                    <TextBlock Text="{Binding IntituleCompte}"
                                               Foreground="#666"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Info sur la hiérarchie -->
                    <Border Background="#FFF3E0" 
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                         Width="18" 
                                                         Height="18"
                                                         Foreground="#F57C00"
                                                         VerticalAlignment="Top"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="À propos des modes de saisie" 
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#E65100"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="#E65100"
                                       LineHeight="14">
                                <Run Text="• Mode nomenclature:"/>
                                <Run Text="Le compte sera lié à une nomenclature budgétaire. L'intitulé se remplit automatiquement."/>
                                <LineBreak/>
                                <Run Text="• Mode saisie libre:"/>
                                <Run Text="Créez un compte indépendant sans lien avec la nomenclature."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Note explicative -->
                    <TextBlock Text="* Champs obligatoires"
                               FontSize="11"
                               Foreground="#666"
                               FontStyle="Italic"
                               Margin="0,0,0,15"/>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCompteCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCompteCommand}"
                                Width="120"/>
                    </StackPanel>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>
