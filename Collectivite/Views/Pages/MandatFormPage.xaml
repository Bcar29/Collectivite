<Page x:Class="Collectivite.Views.Pages.MandatFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Formulaire Mandat">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding CancelCommand}"
                            DockPanel.Dock="Left"
                            ToolTip="Retour">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageTitle}" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Formulaire -->
                <materialDesign:Card Grid.Row="1" Padding="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section 1 : Informations générales -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="📋 Informations générales"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <!-- Numéro de mandat -->
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Numéro de mandat *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.NumeroMandat, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Bordereau -->
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Bordereau"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Bordereau, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Mois -->
                        <ComboBox Grid.Row="2" Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Mois *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding MoisList}"
                                  SelectedItem="{Binding Mandat.Mois}"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Date d'émission -->
                        <DatePicker Grid.Row="2" Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Date d'émission *"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    SelectedDate="{Binding Mandat.DateEmission}"
                                    Margin="0,0,0,15"/>

                        <!-- Engagement -->
                        <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Engagement *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Engagements}"
                                  SelectedValue="{Binding Mandat.EngagementId}"
                                  SelectedValuePath="Id"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="N° "/>
                                            <Run Text="{Binding NumeroEngagement, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Tiers.Nom, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Objet}" 
                                                 FontSize="11" 
                                                 Foreground="#757575"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Objet -->
                        <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Objet du mandat *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Objet, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Section 2 : Montants -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="💰 Montants"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,15,0,15"/>

                        <!-- Montant brut -->
                        <TextBox Grid.Row="6" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Montant brut (GNF) *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.MontantBrut, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculerMontantNetCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- RTS -->
                        <TextBox Grid.Row="6" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="RTS (Retenue à la Source)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Rts, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculerMontantNetCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Autres précomptes -->
                        <TextBox Grid.Row="7" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Autres précomptes"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.AutresPrecomptes, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculerMontantNetCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Bouton Calculer -->
                        <Button Grid.Row="7" Grid.Column="2"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CalculerMontantNetCommand}"
                                Height="56"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Margin="0,0,5,0"/>
                                <TextBlock Text="Calculer le montant net"/>
                            </StackPanel>
                        </Button>

                        <!-- Montant net (lecture seule, calculé) -->
                        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#E8F5E9"
                                BorderBrush="#4CAF50"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,15">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="CashMultiple" 
                                                       Width="24" 
                                                       Height="24"
                                                       Foreground="#388E3C"
                                                       DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Montant Net à Payer"
                                             FontSize="12"
                                             Foreground="#388E3C"
                                             FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Mandat.MontantNet, StringFormat={}{0:N0} GNF}"
                                             FontSize="24"
                                             FontWeight="Bold"
                                             Foreground="#2E7D32"
                                             Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Montant en lettres -->
                        <TextBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Montant en lettres *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.MontantLettre, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/>

                        <!-- Motif -->
                        <TextBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Motif / Description détaillée"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Motif, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/> 

                        <!-- Date de paiement (si mode édition) -->
                        <DatePicker Grid.Row="11" Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Date de paiement (optionnel)"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    SelectedDate="{Binding Mandat.DatePaiement}"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,15"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Boutons d'action -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,20,0,0">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Annuler"
                            Command="{Binding CancelCommand}"
                            Width="120"
                            Height="40"
                            Margin="0,0,15,0"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"
                            Width="150"
                            Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0"/>
                            <TextBlock Text="Enregistrer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>