<Page x:Class="Collectivite.Views.Pages.MandatFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Formulaire Mandat">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding CancelCommand}"
                            DockPanel.Dock="Left"
                            ToolTip="Retour">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageTitle}" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Formulaire -->
                <materialDesign:Card Grid.Row="1" Padding="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section 1 : Informations générales -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="📋 Informations générales"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,0,0,15"/>

                        <!-- Numéro de Mandat (readonly/automatique) -->
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="N° Mandat (automatique)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.NumeroMandat}"
                                 IsReadOnly="True"
                                 Background="#F0F0F0"
                                 Margin="0,0,0,15"/>

                        <!-- Bordereau -->
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Bordereau"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Bordereau, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Mois -->
                        <ComboBox Grid.Row="2" Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Mois *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding MoisList}"
                                  SelectedItem="{Binding Mandat.Mois}"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Date d'émission -->
                        <DatePicker Grid.Row="2" Grid.Column="2"
                                    materialDesign:HintAssist.Hint="Date d'émission *"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    SelectedDate="{Binding Mandat.DateEmission}"
                                    Margin="0,0,0,15"/>

                        <!-- Engagement - Utilise SelectedEngagement -->
                        <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                  materialDesign:HintAssist.Hint="Engagement * (sélectionner pour charger le montant)"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding Engagements}"
                                  SelectedItem="{Binding SelectedEngagement, Mode=TwoWay}"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Imputation "/>
                                            <Run Text="{Binding BudgetLine.Nommenclature.CodeNomenclature, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Tiers.NomComplet, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Objet}" 
                                                 FontSize="11" 
                                                 Foreground="#757575"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Info engagement sélectionné -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#E3F2FD" 
                                CornerRadius="8" 
                                Padding="15"
                                Margin="0,0,0,15"
                                Visibility="{Binding SelectedEngagement, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" 
                                                         Kind="CheckCircle" 
                                                         Width="24" 
                                                         Height="24"
                                                         Foreground="#1976D2"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#1976D2">
                                    <Run Text="Engagement sélectionné - Imputation : "/>
                                    <Run Text="{Binding NomenclatureCode, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Montant : " VerticalAlignment="Center" Foreground="#1976D2"/>
                                    <TextBlock Text="{Binding MontantBrutFormate, Mode=OneWay}" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Objet -->
                        <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                 materialDesign:HintAssist.Hint="Objet du mandat *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding MandatObjet, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <!-- Section 2 : Montants -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="💰 Montants"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#1976D2"
                                 Margin="0,15,0,15"/>

                        <!-- Montant brut (LECTURE SEULE - provient de l'engagement) -->
                        <Border Grid.Row="7" Grid.Column="0"
                                Background="#F5F5F5"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Montant Brut (depuis l'engagement)"
                                           FontSize="11"
                                           Foreground="#757575"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Mandat.MontantBrut, StringFormat={}{0:N0} GNF}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#424242"/>
                                <TextBlock Text="⚠️ Ce montant provient de l'engagement sélectionné"
                                           FontSize="10"
                                           Foreground="#9E9E9E"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Pourcentage précomptes -->
                        <Border Grid.Row="7" Grid.Column="2"
                                Background="#FFF8E1"
                                BorderBrush="#FFB300"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Total Précomptes"
                                           FontSize="11"
                                           Foreground="#757575"
                                           Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalPrecomptes, StringFormat={}{0:N0} GNF, Mode=OneWay}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#F57C00"/>
                                    <TextBlock Text="{Binding PourcentagePrecomptes, StringFormat=' ({0}%)', Mode=OneWay}"
                                               FontSize="14"
                                               Foreground="#F57C00"
                                               VerticalAlignment="Bottom"
                                               Margin="5,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- RTS -->
                        <TextBox Grid.Row="8" Grid.Column="0"
                                 materialDesign:HintAssist.Hint="RTS (Retenue à la Source)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.Rts, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculerMontantNetCommand}"/>
                                <KeyBinding Key="Tab" Command="{Binding CalculerMontantNetCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Autres précomptes -->
                        <TextBox Grid.Row="8" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Autres précomptes"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.AutresPrecomptes, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,0,15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CalculerMontantNetCommand}"/>
                                <KeyBinding Key="Tab" Command="{Binding CalculerMontantNetCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Message d'erreur précomptes -->
                        <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="#FFEBEE"
                                BorderBrush="#F44336"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,15"
                                Visibility="{Binding HasErreurPrecomptes, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" 
                                                         Width="24" 
                                                         Height="24"
                                                         Foreground="#F44336"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ErreurPrecomptes, Mode=OneWay}"
                                           Foreground="#C62828"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Bouton Calculer -->
                        <Button Grid.Row="10" Grid.Column="0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CalculerMontantNetCommand}"
                                Height="50"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Calculator" Margin="0,0,8,0"/>
                                <TextBlock Text="Calculer le montant net"/>
                            </StackPanel>
                        </Button>

                        <!-- Montant net (lecture seule, calculé) -->
                        <Border Grid.Row="10" Grid.Column="2"
                                Background="#E8F5E9"
                                BorderBrush="#4CAF50"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="15"
                                Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0"
                                                         Kind="CashMultiple" 
                                                         Width="28" 
                                                         Height="28"
                                                         Foreground="#388E3C"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Montant Net à Payer"
                                               FontSize="11"
                                               Foreground="#388E3C"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Mandat.MontantNet, StringFormat={}{0:N0} GNF}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bouton convertir en lettres -->
                        <Button Grid.Row="11" Grid.Column="0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ConvertMontantToLettresCommand}"
                                Height="50"
                                Margin="0,0,0,15"
                                Background="#7B1FA2"
                                BorderBrush="#7B1FA2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextToSpeech" Margin="0,0,8,0"/>
                                <TextBlock Text="Convertir en lettres"/>
                            </StackPanel>
                        </Button>

                        <!-- Montant en lettres -->
                        <TextBox Grid.Row="11" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Montant en lettres *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Mandat.MontantLettre, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/>

                        <!-- Date de paiement (si mode édition) -->
                        <DatePicker Grid.Row="12" Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Date de paiement (optionnel)"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    SelectedDate="{Binding Mandat.DatePaiement}"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,15"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Boutons d'action -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,20,0,0">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Annuler"
                            Command="{Binding CancelCommand}"
                            Width="120"
                            Height="45"
                            Margin="0,0,15,0"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"
                            Width="180"
                            Height="45"
                            Background="#4CAF50"
                            BorderBrush="#4CAF50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0"/>
                            <TextBlock Text="Enregistrer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
