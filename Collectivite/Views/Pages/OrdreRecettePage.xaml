<Page x:Class="Collectivite.Views.Pages.OrdreRecettePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      xmlns:controls="clr-namespace:Collectivite.Views.Controls"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Ordres de Recette">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:StatutOrdreToTextConverter x:Key="StatutOrdreToText"/>
        <utils:StatutOrdreToColorConverter x:Key="StatutOrdreToColor"/>
        <utils:StatutOrdreToBackgroundConverter x:Key="StatutOrdreToBackground"/>
        <utils:StatutOrdreCanEditConverter x:Key="StatutOrdreCanEdit"/>
        <utils:OrdreEditButtonVisibilityConverter x:Key="OrdreEditButtonVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Ordres de Recette" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding NavigateToAddCommand}"
                            Visibility="{Binding CanCreateOrdreRecette, Converter={StaticResource BoolToVis}}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouvel Ordre"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Statistiques -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total montant -->
                <Border Grid.Column="0"
                        Background="#E3F2FD" 
                        CornerRadius="8"
                        Padding="15">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="CashCycle" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"
                                               Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Montant Total"
                                       FontSize="12"
                                       Foreground="#666"/>
                            <TextBlock Text="{Binding TotalOrdres, StringFormat={}{0:N0} GNF}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Nombre d'ordres -->
                <Border Grid.Column="2"
                        Background="#E8F5E9" 
                        CornerRadius="8"
                        Padding="15">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="FileDocumentMultiple" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#388E3C"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"
                                               Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Nombre d'Ordres"
                                       FontSize="12"
                                       Foreground="#666"/>
                            <TextBlock Text="{Binding CountOrdres}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#388E3C"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Barre de recherche et filtres -->
            <materialDesign:Card Grid.Row="2" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <!-- Barre de recherche -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recherche par numéro -->
                        <TextBox Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Rechercher par numéro d'ordre..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding SearchNumeroOrdre, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Bouton rechercher -->
                        <Button Grid.Column="2"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SearchCommand}"
                                Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Margin="0,0,5,0"/>
                                <TextBlock Text="Rechercher"/>
                            </StackPanel>
                        </Button>

                        <!-- Bouton filtres -->
                        <Button Grid.Column="4"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ToggleFilterPanelCommand}"
                                Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOutline" Margin="0,0,5,0"/>
                                <TextBlock Text="Filtres avancés"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Panel des filtres (collapsible) -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,15,0,0"
                            Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Exercice -->
                            <ComboBox Grid.Row="0" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="Exercice"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding Exercices}"
                                      SelectedValue="{Binding FilterExerciceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Libelle"
                                      utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                            <!-- Commune -->
                            <ComboBox Grid.Row="0" Grid.Column="2"
                                      materialDesign:HintAssist.Hint="Commune"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding Communes}"
                                      SelectedValue="{Binding FilterCommuneId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Nom"
                                      utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                            <!-- Tiers -->
                            <ComboBox Grid.Row="0" Grid.Column="4"
                                      materialDesign:HintAssist.Hint="Tiers"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      ItemsSource="{Binding TiersList}"
                                      SelectedValue="{Binding FilterTiersId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="NomComplet"
                                      utils:ComboBoxAutoCompleteBehavior.IsEnabled="True"/>

                            <!-- Date début -->
                            <DatePicker Grid.Row="2" Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Date début"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding FilterDateDebut}"/>

                            <!-- Date fin -->
                            <DatePicker Grid.Row="2" Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Date fin"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding FilterDateFin}"/>

                            <!-- Montant min -->
                            <TextBox Grid.Row="4" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Montant minimum"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding FilterMontantMin, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Montant max -->
                            <TextBox Grid.Row="4" Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Montant maximum"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding FilterMontantMax, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Bouton réinitialiser -->
                            <Button Grid.Row="4" Grid.Column="4"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterRemove" Margin="0,0,5,0"/>
                                    <TextBlock Text="Réinitialiser"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- DataGrid -->
            <!-- DataGrid avec scroll horizontal -->
            <materialDesign:Card Grid.Row="3" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
                    <DataGrid ItemsSource="{Binding OrdresRecette}"
                  SelectedItem="{Binding SelectedOrdreRecette}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  RowHeight="52"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                  AlternationCount="2"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  MinWidth="1400">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Numéro -->
                            <DataGridTextColumn Header="N° Ordre" 
                                  Binding="{Binding NumeroOrdre}" 
                                  Width="150"
                                  FontWeight="SemiBold"/>

                            <!-- Date -->
                            <DataGridTextColumn Header="Date" 
                                  Binding="{Binding DateOrdre, StringFormat='dd/MM/yyyy'}" 
                                  Width="100"/>

                            <!-- Exercice -->
                            <DataGridTextColumn Header="Exercice" 
                                  Binding="{Binding Exercice.Libelle}" 
                                  Width="110"/>

                            <!-- Commune -->
                            <DataGridTextColumn Header="Commune" 
                                  Binding="{Binding Commune.Nom}" 
                                  Width="140"/>

                            <!-- Ligne budgétaire -->
                            <DataGridTextColumn Header="Ligne budgétaire" 
                                  Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                  Width="300"/>

                            <!-- Tiers -->
                            <DataGridTextColumn Header="Tiers" 
                                  Binding="{Binding Tiers.NomComplet}" 
                                  Width="150"/>

                            <!-- Comptable -->
                            <DataGridTextColumn Header="Comptable" 
                                  Binding="{Binding Comptable}" 
                                  Width="130"/>

                            <!-- Montant -->
                            <DataGridTemplateColumn Header="Montant" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E3F2FD" 
                                    CornerRadius="4" 
                                    Padding="8,4">
                                            <TextBlock Text="{Binding MontantOrdre, StringFormat={}{0:N0} GNF}"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Right"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Montant Encaissé -->
                            <DataGridTemplateColumn Header="Montant Encaissé" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Statut, Converter={StaticResource StatutOrdreToBackground}}" 
                                                CornerRadius="4" 
                                                Padding="8,4">
                                            <TextBlock Text="{Binding MontantEncaisse, StringFormat={}{0:N0} GNF}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Statut, Converter={StaticResource StatutOrdreToColor}}"
                                                   HorizontalAlignment="Right"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Statut -->
                            <DataGridTemplateColumn Header="Statut" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" 
                                                Padding="8,4"
                                                 HorizontalAlignment="Center"
                                                Background="{Binding Statut, Converter={StaticResource StatutOrdreToBackground}}">
                                            <TextBlock Text="{Binding Statut, Converter={StaticResource StatutOrdreToText}}"
                                                   Foreground="{Binding Statut, Converter={StaticResource StatutOrdreToColor}}"
                                                    FontSize="11" 
                                                    FontWeight="SemiBold" 
                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PopupBox Style="{StaticResource RowActionsPopupBoxStyle}">
                                            <StackPanel>
                                                <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                        Visibility="{Binding DataContext.CanViewOrdreRecette, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.NavigateToDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Eye" Foreground="#4CAF50" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Voir détails"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- Modifier : visible seulement si la permission ET le statut le permettent -->
                                                <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                        Command="{Binding DataContext.NavigateToEditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource OrdreEditButtonVisibilityConverter}">
                                                            <Binding Path="DataContext.CanEditOrdreRecette" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            <Binding Path="Statut"/>
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Modifier"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PopupMenuItemButtonStyle}"
                                                        Visibility="{Binding DataContext.CanDeleteOrdreRecette, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Foreground="#F44336" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Supprimer"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:PopupBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Message si vide -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrdresRecette.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashPlus" Width="64" Height="64" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucun ordre de recette" FontSize="16" Foreground="#757575" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <controls:PaginationBar Grid.Row="1"
                                        PageNumber="{Binding PageNumber}"
                                        TotalPages="{Binding TotalPages}"
                                        TotalCount="{Binding TotalCount}"
                                        PreviousCommand="{Binding PreviousPageCommand}"
                                        NextCommand="{Binding NextPageCommand}"/>
              </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>