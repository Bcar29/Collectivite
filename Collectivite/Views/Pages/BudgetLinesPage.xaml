<Page x:Class="Collectivite.Views.Pages.BudgetLinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:Utils="clr-namespace:Collectivite.Utils"
      Unloaded="Page_Unloaded"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>
        <Utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        
        <!-- En-tête avec boutons -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Message d'information si budget validé -->
            <Border Grid.Row="0"
                    Background="#FFF3E0"
                    Padding="15"
                    Margin="0,0,0,10"
                    CornerRadius="8"
                    Visibility="{Binding IsBudgetValidated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Lock" 
                                           Width="24" 
                                           Height="24"
                                           Foreground="#FF9800"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                    <TextBlock Text="Ce budget est validé et ne peut plus être modifié."
                             FontSize="14"
                             Foreground="#F57C00"
                             FontWeight="Medium"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Boutons (visibles seulement si budget non validé) -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Visibility="{Binding CanModifyBudget, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding AddCommand}"
                        Height="36"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding RefreshCommand}"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                        <TextBlock Text="Rafraîchir"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Onglets -->
        <TabControl Grid.Row="1" 
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="20,0,20,20">

            <!-- Recette - Fonctionnement -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashPlus" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Fonctionnement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>

                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="100"/>
                            <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu, StringFormat=N0}" Width="150"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">

                                            <!-- Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Modifier"
                                                    Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                                                       Width="20" 
                                                                       Height="20"
                                                                       Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Supprimer"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                                                       Width="20" 
                                                                       Height="20"
                                                                       Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            
            </TabItem>

            <!-- Recette - Investissement -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrendingUp" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Investissement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Même structure de DataGrid -->
                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="100"/>
                            <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu, StringFormat=N0}" Width="150"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">

                                            <!-- Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Modifier"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                               Width="20" 
                                               Height="20"
                                               Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                               Width="20" 
                                               Height="20"
                                               Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- Dépense - Fonctionnement -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMinus" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Dépense - Fonctionnement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
               AutoGenerateColumns="False"
               IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="100"/>
                            <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu, StringFormat=N0}" Width="150"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                             HorizontalAlignment="Center"
                             Visibility="{Binding Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">

                                            <!-- Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                 ToolTip="Modifier"
                                 Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"
                                 Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                Width="20" 
                                Height="20"
                                Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                 ToolTip="Supprimer"
                                 Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"
                                 Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                Width="20" 
                                Height="20"
                                Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

            <!-- Dépense - Investissement -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrendingDown" 
                                               Width="20" 
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Dépense - Investissement" 
                                 VerticalAlignment="Center" 
                                 FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <materialDesign:Card Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
               AutoGenerateColumns="False"
               IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="100"/>
                            <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu, StringFormat=N0}" Width="150"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                             HorizontalAlignment="Center"
                             Visibility="{Binding Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">

                                            <!-- Modifier -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                 ToolTip="Modifier"
                                 Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"
                                 Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                Width="20" 
                                Height="20"
                                Foreground="#1976D2"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                 ToolTip="Supprimer"
                                 Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"
                                 Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                Width="20" 
                                Height="20"
                                Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - MODAL AJOUT/MODIFICATION
             ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                   CloseOnClickAway="False"
                                   Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="600">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#1976D2" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                       Width="28" 
                                                       Height="28"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding DialogTitle}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Nomenclature (visible seulement en mode ajout) -->
                            <ComboBox ItemsSource="{Binding AvailableNomenclatures}"
                                      SelectedItem="{Binding SelectedNomenclature}"
                                      DisplayMemberPath="Intitule"
                                      materialDesign:HintAssist.Hint="Sélectionner une nomenclature *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Visibility="{Binding IsAddMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,0,20"/>

                            <!-- Nomenclature (lecture seule en mode édition) -->
                            <TextBox Text="{Binding NomenclatureLibelle, Mode=OneWay}"
                                     materialDesign:HintAssist.Hint="Nomenclature"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True"
                                     Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,0,20"/>

                            <!-- Montant -->
                            <TextBox Text="{Binding MontantPrevu, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Montant prévu (GNF) *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,20">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveDialogCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Info -->
                            <Border Background="#E3F2FD"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#1976D2"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                                        <Run Text="Les champs marqués d'un astérisque (*) sont obligatoires."/>
                                        <LineBreak/>
                                        <Run Text="Les montants des parents seront recalculés automatiquement."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                                Background="#FAFAFA" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="0,1,0,0"
                                Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding CancelDialogCommand}"
                                        Width="100"
                                        Height="40"
                                        Margin="0,0,10,0"/>

                                <Button Command="{Binding SaveDialogCommand}"
                                        Width="140"
                                        Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>

</Page>