<Page x:Class="Collectivite.Views.Pages.BudgetLinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:Utils="clr-namespace:Collectivite.Utils"
      Unloaded="Page_Unloaded"
      Language="fr-FR"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>
        <Utils:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Utils:BackgroundColorConverter x:Key="BackgroundColorConverter"/>
        <Utils:BooleanAndToVisibilityConverter x:Key="BooleanAndToVisibilityConverter"/>

        <!-- 🆕 Nouveau converter pour les boutons d'actions -->
        <Utils:ShowActionsConverter x:Key="ShowActionsConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="999"
              Grid.RowSpan="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>


        <!-- En-tête avec boutons -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Message d'information si budget validé -->
            <Border Grid.Row="0"
                    Background="#FFF3E0"
                    Padding="15"
                    Margin="0,0,0,10"
                    CornerRadius="8"
                    Visibility="{Binding IsBudgetValidated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Lock" 
                                           Width="24" 
                                           Height="24"
                                           Foreground="#FF9800"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                    <TextBlock Text="Ce budget est validé et ne peut plus être modifié."
                             FontSize="14"
                             Foreground="#F57C00"
                             FontWeight="Medium"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Boutons (visibles seulement si budget non validé) -->
            <StackPanel Grid.Row="1"
                Orientation="Horizontal" 
                HorizontalAlignment="Right">

                <!-- 🆕 Bouton Export PDF -->
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding ExportPdfCommand}"
                    Height="36"
                    Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                        <TextBlock Text="Exporter PDF"/>
                    </StackPanel>
                </Button>

                <!-- 🆕 Bouton Imprimer -->
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding PrintCommand}"
                    Height="36"
                    Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                        <TextBlock Text="Imprimer"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Ajouter (visible seulement si budget non validé) -->
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddCommand}"
                    Height="36"
                    Margin="0,0,10,0"
                    Visibility="{Binding CanModifyBudget, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Rafraîchir -->
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
            Command="{Binding RefreshCommand}"
            Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                        <TextBlock Text="Rafraîchir"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Onglets -->
        <TabControl Grid.Row="1" 
            SelectedIndex="{Binding SelectedTabIndex}"
            Margin="20,0,20,20">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 1 : Recette - Fonctionnement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashPlus" 
                                   Width="20" 
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Fonctionnement" 
                     VerticalAlignment="Center" 
                     FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <materialDesign:Card Grid.Row="0" Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding DisplayedLines}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserSortColumns="False"
                             CanUserReorderColumns="False"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             Style="{StaticResource MaterialDesignDataGrid}">

                            <!-- 🆕 Style avec support ligne de totaux -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- Style pour ligne de totaux -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                            <Setter Property="Background" Value="{Binding TotalRowBackground, Converter={StaticResource BackgroundColorConverter}}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                            <Setter Property="BorderBrush" Value="DarkBlue"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                            <!-- 🆕 Colonne Chapitre avec gestion expander -->
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                               Background="Transparent" BorderThickness="0"
                                               Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignFlatButton}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                        <Binding Path="HasChildren"/>
                                                        <Binding Path="IsTotalRow" Converter="{StaticResource InverseBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                         VerticalAlignment="Center"
                                         FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N2} GNF}" Width="150"/>

                            <!-- 🆕 Colonne Actions - masquée pour ligne de totaux -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 🆕 Utilisation du ShowActionsConverter -->
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource ShowActionsConverter}">
                                                    <Binding Path="BudgetLine.Nommenclature.Enfants"/>
                                                    <Binding Path="IsTotalRow"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier"
                                               Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding BudgetLine}"
                                               Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="#1976D2"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Supprimer"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding BudgetLine}"
                                               Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                    <!-- Totaux Recette Fonctionnement -->
                    <materialDesign:Card Grid.Row="1" Margin="0,10,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Recettes de Fonctionnement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding TotalRecetteFonctionnement, StringFormat='{}{0:N2} GNF'}" 
                                   FontWeight="Bold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 2 : Recette - Investissement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrendingUp" 
                                   Width="20" 
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Recette - Investissement" 
                     VerticalAlignment="Center" 
                     FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserSortColumns="False"
                         CanUserReorderColumns="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         Style="{StaticResource MaterialDesignDataGrid}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                        <Setter Property="Background" Value="{Binding TotalRowBackground, Converter={StaticResource BackgroundColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                        <Setter Property="BorderBrush" Value="DarkBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                               Background="Transparent" BorderThickness="0"
                                               Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignFlatButton}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                        <Binding Path="HasChildren"/>
                                                        <Binding Path="IsTotalRow" Converter="{StaticResource InverseBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                         VerticalAlignment="Center"
                                         FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N2} GNF}" Width="150"/>

                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 🆕 Utilisation du ShowActionsConverter -->
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource ShowActionsConverter}">
                                                    <Binding Path="BudgetLine.Nommenclature.Enfants"/>
                                                    <Binding Path="IsTotalRow"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier"
                                               Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding BudgetLine}"
                                               Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="#1976D2"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Supprimer"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding BudgetLine}"
                                               Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
                    <!-- Totaux Recette Investissement -->
                    <materialDesign:Card Grid.Row="1" Margin="0,10,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 : Total Recette Investissement -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Recettes d'Investissement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                              Text="{Binding TotalRecetteInvestissement, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="16"
                              Foreground="{DynamicResource PrimaryHueMidBrush}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>

                            <!-- Ligne 2 : Total Recette Réels Investissement -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Recettes Réels d'Investissement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                              Text="{Binding TotalRecetteReelsInvestissement, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="16"
                              Foreground="#43A047"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>

                            <!-- Ligne 3 : Total Général Recettes Réels -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SigmaLower" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Général des Recettes Réels:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                              Text="{Binding TotalGeneralRecettesReels, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="18"
                              Foreground="#1976D2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 3 : Dépense - Fonctionnement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMinus" 
                                   Width="20" 
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Dépense - Fonctionnement" 
                     VerticalAlignment="Center" 
                     FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <materialDesign:Card Grid.Row="0" Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="False"
                     CanUserReorderColumns="False"
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     Style="{StaticResource MaterialDesignDataGrid}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                        <Setter Property="Background" Value="{Binding TotalRowBackground, Converter={StaticResource BackgroundColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                        <Setter Property="BorderBrush" Value="DarkBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                       Background="Transparent" BorderThickness="0"
                                       Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"
                                       Style="{StaticResource MaterialDesignFlatButton}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                        <Binding Path="HasChildren"/>
                                                        <Binding Path="IsTotalRow" Converter="{StaticResource InverseBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                         VerticalAlignment="Center"
                                         FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N2} GNF}" Width="150"/>

                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 🆕 Utilisation du ShowActionsConverter -->
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource ShowActionsConverter}">
                                                    <Binding Path="BudgetLine.Nommenclature.Enfants"/>
                                                    <Binding Path="IsTotalRow"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier"
                       Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding BudgetLine}"
                       Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="#1976D2"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Supprimer"
                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding BudgetLine}"
                       Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
                    <!-- Totaux Dépense Fonctionnement -->
                    <materialDesign:Card Grid.Row="1" Margin="0,10,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 : Total Dépense Fonctionnement -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Dépenses de Fonctionnement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                              Text="{Binding TotalDepenseFonctionnement, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="16"
                              Foreground="#D32F2F"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>

                            <!-- Ligne 2 : Total Dépense Réels Fonctionnement -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Dépenses Réels de Fonctionnement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                              Text="{Binding TotalDepenseReelsFonctionnement, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="16"
                              Foreground="#E64A19"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
                </TabItem>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ONGLET 4 : Dépense - Investissement -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrendingDown" 
                                   Width="20" 
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Dépense - Investissement" 
                     VerticalAlignment="Center" 
                     FontWeight="Medium"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <materialDesign:Card Grid.Row="0" Padding="0" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding DisplayedLines}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserSortColumns="False"
                         CanUserReorderColumns="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         Style="{StaticResource MaterialDesignDataGrid}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                        <Setter Property="Background" Value="{Binding TotalRowBackground, Converter={StaticResource BackgroundColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                        <Setter Property="BorderBrush" Value="DarkBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chapitre" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                            <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                       Background="Transparent" BorderThickness="0"
                                       Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"
                                       Style="{StaticResource MaterialDesignFlatButton}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                        <Binding Path="HasChildren"/>
                                                        <Binding Path="IsTotalRow" Converter="{StaticResource InverseBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                         VerticalAlignment="Center"
                                         FontWeight="{Binding TextFontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="100"/>
                            <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                            <DataGridTextColumn Header="Sous-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="150"/>
                            <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*"/>
                            <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N2} GNF}" Width="150"/>

                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- 🆕 Utilisation du ShowActionsConverter -->
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource ShowActionsConverter}">
                                                    <Binding Path="BudgetLine.Nommenclature.Enfants"/>
                                                    <Binding Path="IsTotalRow"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier"
                       Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding BudgetLine}"
                       Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="4,0">
                                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="#1976D2"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Supprimer"
                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding BudgetLine}"
                       Visibility="{Binding DataContext.CanModifyBudget, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#F44336"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
                    <!-- Totaux Dépense Investissement -->
                    <materialDesign:Card Grid.Row="1" Margin="0,10,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 : Total Dépense Investissement -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Information" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Dépenses d'Investissement:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                              Text="{Binding TotalDepenseInvestissement, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="16"
                              Foreground="#D32F2F"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>

                            <!-- Ligne 2 : Total Général Dépenses Réels -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SigmaLower" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Total Général des Dépenses Réels:" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                              Text="{Binding TotalGeneralDepensesReels, StringFormat='{}{0:N2} GNF'}" 
                              FontWeight="Bold" 
                              FontSize="18"
                              Foreground="#C62828"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════
             DIALOGHOST - MODAL AJOUT/MODIFICATION
             ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                   CloseOnClickAway="False"
                                   Panel.ZIndex="1000"
                                   Grid.RowSpan="2">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="600">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#673AB7" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashCycle" 
                                                       Width="28" 
                                                       Height="28"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding DialogTitle}"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         Foreground="White"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Contenu -->
                        <StackPanel Grid.Row="1" Margin="20">

                            <!-- Nomenclature (visible seulement en mode ajout) -->
                            <ComboBox ItemsSource="{Binding AvailableNomenclatures}"
                                      SelectedItem="{Binding SelectedNomenclature}"
                                      DisplayMemberPath="DisplayLabel"
                                      materialDesign:HintAssist.Hint="Sélectionner une nomenclature *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Visibility="{Binding IsAddMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,0,20"/>

                            <!-- Nomenclature (lecture seule en mode édition) -->
                            <TextBox Text="{Binding NomenclatureLibelle, Mode=OneWay}"
                                     materialDesign:HintAssist.Hint="Nomenclature"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True"
                                     Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,0,20"/>

                            <!-- Montant -->
                            <TextBox Text="{Binding MontantPrevu, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Montant prévu (GNF) *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,20">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveDialogCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Info -->
                            <Border Background="#E3F2FD"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" 
                                                           Width="20" 
                                                           Height="20"
                                                           Foreground="#1976D2"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                                        <Run Text="Les champs marqués d'un astérisque (*) sont obligatoires."/>
                                        <LineBreak/>
                                        <Run Text="Les montants des parents seront recalculés automatiquement."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" 
                                Background="#FAFAFA" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="0,1,0,0"
                                Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding CancelDialogCommand}"
                                        Width="100"
                                        Height="40"
                                        Margin="0,0,10,0"/>

                                <Button Command="{Binding SaveDialogCommand}"
                                        Width="140"
                                        Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>

</Page>