<Page x:Class="Collectivite.Views.Pages.BudgetLinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Collectivite.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BudgetLinesPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="Ajouter" Padding="8,4" Margin="0,0,8,0" Command="{Binding AddCommand}" />
            <Button Content="Rafraîchir" Padding="8,4" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Recette - Fonctionnement">
                <DataGrid ItemsSource="{Binding DisplayedLines}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="100"/>
                        <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="100"/>
                        <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="100"/>
                        <DataGridTextColumn Header="sous Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="150"/>
                        <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                        <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Recette - Investissement">
                <DataGrid ItemsSource="{Binding DisplayedLines}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="*"/>
                        <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="*"/>
                        <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="*"/>
                        <DataGridTextColumn Header="sous Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="*"/>
                        <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                        <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu}" Width="150"/>
                       
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Dépense - Fonctionnement">
                <DataGrid ItemsSource="{Binding DisplayedLines}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="*"/>
                        <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="*"/>
                        <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="*"/>
                        <DataGridTextColumn Header="sous Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="*"/>
                        <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                        <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Dépense - Investissement">
                <DataGrid ItemsSource="{Binding DisplayedLines}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Chapitre" Binding="{Binding Nommenclature.Chapitre}" Width="*"/>
                        <DataGridTextColumn Header="Article" Binding="{Binding Nommenclature.Article}" Width="*"/>
                        <DataGridTextColumn Header="Paragraphe" Binding="{Binding Nommenclature.Paragraphe}" Width="*"/>
                        <DataGridTextColumn Header="sous Paragraphe" Binding="{Binding Nommenclature.SousParagraphe}" Width="*"/>
                        <DataGridTextColumn Header="Intitulé" Binding="{Binding Nommenclature.Intitule}" Width="*"/>
                        <DataGridTextColumn Header="Montant prévu" Binding="{Binding MontantPrevu}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
