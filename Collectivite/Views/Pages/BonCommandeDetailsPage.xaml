<Page x:Class="Collectivite.Views.Pages.BonCommandeDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails du Bon de Commande">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Retour"
                            DockPanel.Dock="Left"
                            Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                 Width="32" 
                                                 Height="32"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Détails du Bon de Commande" 
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Informations générales -->
                <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titre section -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="Informations Générales"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- Numéro -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="N° Bon de Commande"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BonCommande.Numero}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Date de Création"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BonCommande.DateCreation, StringFormat='dd/MM/yyyy'}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Expression de Besoin -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Expression de Besoin"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BonCommande.ExpressionBesoin.Numero}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"/>
                        </StackPanel>

                        <!-- Exercice -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Exercice"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BonCommande.ExpressionBesoin.Exercice.Libelle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Détails du bon de commande -->
                <materialDesign:Card Grid.Row="2" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Détails du Bon de Commande"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- DataGrid des détails -->
                        <DataGrid ItemsSource="{Binding Details}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  LoadingRow="DataGrid_LoadingRow"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTextColumn Header="#" 
                                                  Width="50"
                                                  Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>

                                <!-- Désignation -->
                                <DataGridTextColumn Header="Désignation" 
                                                  Binding="{Binding Designation}" 
                                                  Width="*" 
                                                  MinWidth="250"/>

                                <!-- Quantité -->
                                <DataGridTextColumn Header="Quantité" 
                                                  Binding="{Binding Quantite}" 
                                                  Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Prix unitaire -->
                                <DataGridTemplateColumn Header="Prix Unitaire" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrixUnitaire, StringFormat={}{0:N0} GNF}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#666"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total -->
                                <DataGridTemplateColumn Header="Total" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="4" 
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Montant total -->
                <materialDesign:Card Grid.Row="3" Padding="25">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="CashCheck" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#4CAF50"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"
                                               Margin="0,0,15,0"/>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="MONTANT TOTAL"
                                       FontSize="14"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding MontantTotal, StringFormat={}{0:N0} GNF}"
                                       FontWeight="Bold"
                                       FontSize="28"
                                       Foreground="#4CAF50"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <TextBlock Text="Récapitulatif"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>