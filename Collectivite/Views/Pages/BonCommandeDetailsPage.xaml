<Page x:Class="Collectivite.Views.Pages.BonCommandeDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Détails du Bon de Commande">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="1200">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- HEADER DE NAVIGATION -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding GoBackCommand}"
                                ToolTip="Retour"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                     Width="24" 
                                                     Height="24"/>
                        </Button>

                        <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                 Width="32" 
                                                 Height="32"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Détails du Bon de Commande" 
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons d'action -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PrintCommand}"
                                Height="36"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0"/>
                                <TextBlock Text="Imprimer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ExportPdfCommand}"
                                Height="36"
                                Background="DarkRed"
                                BorderBrush="DarkRed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,5,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- CARTE PRINCIPALE -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <materialDesign:Card Padding="30" Margin="0,0,0,20">
                    <StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- EN-TÊTE OFFICIEL GUINÉEN -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colonne gauche : Ministère -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ministère de l'Administration du Territoire"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text="et de la Décentralisation"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>
                                <TextBlock Text="Direction Générale des Collectivités Locales"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,5,0,0"/>

                                <!-- Infos géographiques -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="REGION ADMINISTRATIVE DE "/>
                                        <Run Text="{Binding Commune.RegionCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="PREFECTURE DE "/>
                                        <Run Text="{Binding Commune.PrefectureCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="COMMUNE "/>
                                        <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <Run Text=" DE "/>
                                        <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}" 
                                             FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Colonne centrale : Drapeau -->
                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Margin="30,0">
                                <Border CornerRadius="3" 
                                        BorderBrush="#424242" 
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        Effect="{StaticResource MaterialDesignShadowDepth1}">
                                    <Grid Width="54" Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#CE1126"/>
                                        <Rectangle Grid.Column="1" Fill="#FCD116"/>
                                        <Rectangle Grid.Column="2" Fill="#009460"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Colonne droite : République -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="REPUBLIQUE DE GUINEE"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="Travail - Justice - Solidarité"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="#475569"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- TITRE DU DOCUMENT -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="BON DE COMMANDE"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <!-- Bandeau avec commune -->
                            <Border Background="#D1FAE5"
                                    BorderBrush="#059669"
                                    BorderThickness="0,2"
                                    Padding="15,8"
                                    HorizontalAlignment="Center"
                                    MinWidth="400">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#065F46">
                                    <Run Text="DE LA COMMUNE "/>
                                    <Run Text="{Binding Commune.TypCommune, FallbackValue='..........', Mode=OneWay}"/>
                                    <Run Text=" DE "/>
                                    <Run Text="{Binding Commune.NomCommune, FallbackValue='............................', Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Exercice -->
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0">
                                <Run Text="{Binding BonCommande.ExpressionBesoin.Exercice.Libelle, FallbackValue='2025'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Separator Margin="0,0,0,20"/>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- INFORMATIONS GÉNÉRALES -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <TextBlock Text="📋 Informations générales"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° Bon de Commande :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BonCommande.Numero}" FontSize="14" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Date de Création :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding BonCommande.DateCreation, StringFormat='dd/MM/yyyy'}" FontSize="14" VerticalAlignment="Center"/>

                            <!-- Ligne 2 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expression de Besoin :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BonCommande.ExpressionBesoin.Numero}" FontSize="14" Foreground="#1976D2" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Exercice :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding BonCommande.ExpressionBesoin.Exercice.Libelle}" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- DÉTAILS DU BON DE COMMANDE -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <materialDesign:Card Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📦 Détails du Bon de Commande"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>

                        <DataGrid ItemsSource="{Binding Details}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  LoadingRow="DataGrid_LoadingRow"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTextColumn Header="#" 
                                                    Width="50"
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>

                                <!-- Désignation -->
                                <DataGridTextColumn Header="Désignation" 
                                                    Binding="{Binding Designation}" 
                                                    Width="*" 
                                                    MinWidth="250"/>

                                <!-- Quantité -->
                                <DataGridTextColumn Header="Quantité" 
                                                    Binding="{Binding Quantite}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Prix unitaire -->
                                <DataGridTemplateColumn Header="Prix Unitaire" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PrixUnitaire, StringFormat={}{0:N0} GNF}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#666"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total -->
                                <DataGridTemplateColumn Header="Total" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="4" 
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- RÉCAPITULATIF - MONTANT TOTAL -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <materialDesign:Card Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CashCheck" 
                                                     Width="32" 
                                                     Height="32"
                                                     Foreground="#4CAF50"
                                                     Margin="0,0,15,0"/>
                            <TextBlock Text="Récapitulatif"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="MONTANT TOTAL"
                                       FontSize="14"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding MontantTotal, StringFormat={}{0:N0} GNF}"
                                       FontWeight="Bold"
                                       FontSize="28"
                                       Foreground="#4CAF50"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
