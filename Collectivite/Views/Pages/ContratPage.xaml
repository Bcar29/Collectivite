<Page x:Class="Collectivite.Views.Pages.ContratPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F5F5F5"
      Title="Gestion des Contrat">

    <Page.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>


    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
      OVERLAY DE CHARGEMENT
      ═══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" 
       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
       Panel.ZIndex="999">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="351,0,0,0">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="0"
                    IsIndeterminate="True"
                    Width="60"
                    Height="60"/>
                <TextBlock Text="Chargement..." 
                  Foreground="White"
                  FontSize="16"
                  Margin="0,20,0,0"
                  HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
     CONTENU PRINCIPAL
     ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- ───────────────────────────────────────────────────
             HEADER AVEC BOUTON D'AJOUT
             ─────────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,20">
                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="City" 
                                       Width="32" 
                                       Height="32"
                                       Foreground="#1976D2"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Contrats" 
                         FontSize="24"
                         FontWeight="SemiBold"
                         Margin="15,0,0,0"
                         VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Bouton Ajouter -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="40"
                    Command="{Binding OppenAddContratCommand}"
                    HorizontalAlignment="Right"
                    Visibility="{Binding DataContext.CanCreateContrat, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            <TextBlock Text="Nouveau Contrat" 
                             VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ───────────────────────────────────────────────────
             DATAGRID DES CONTRATS
             ─────────────────────────────────────────────────── -->
                <materialDesign:Card Padding="0" 
                           UniformCornerRadius="8">
                    <DataGrid
                        
                      ItemsSource="{Binding Contrats}"
                      SelectedItem="{Binding SelectedContrat}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>

                            <!-- Numero contrat -->
                            <DataGridTextColumn Header="Numéro Contrat" 
                                Binding="{Binding NumeroContrat}"
                                Width="230"
                                FontWeight="Medium"/>

                            <!-- Date signature -->
                            <DataGridTemplateColumn Header="Date Signature" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarCheck" 
                                        Width="16" 
                                        Height="16"
                                        Foreground="#F57C00"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateSignature, StringFormat='dd/MM/yyyy'}"
                                                 VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date Echeance -->
                            <DataGridTemplateColumn Header="Date Echéance" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarCheck" 
                                        Width="16" 
                                        Height="16"
                                        Foreground="#F57C00"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DateEcheance, StringFormat='dd/MM/yyyy'}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Le Tiers -->
                            <DataGridTextColumn Header="Tiers" 
                                  Binding="{Binding Tiers.Nom}"
                                  Width="230"
                                  FontWeight="Medium"/>
                            
                            <!-- L'Objet -->
                            <DataGridTextColumn Header="Objet" 
                                  Binding="{Binding Objet}"
                                  Width="230"
                                  FontWeight="Medium"/>
                            
                            <!-- Montant Contrat -->
                            <DataGridTemplateColumn Header="Montant" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                       Width="18" 
                                       Height="18"
                                       Foreground="#388E3C"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                 FontWeight="SemiBold"
                                                 Foreground="#388E3C">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} GNF">
                                                        <Binding Path="MontantContrat"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                          HorizontalAlignment="Center">

                                            <!-- Bouton Modifier -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="Modifier"
                                              Command="{Binding DataContext.OppenEditContratCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"
                                              Margin="4,0"
                                              Visibility="{Binding DataContext.CanEditContrat, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="Pencil" 
                                                           Foreground="#1976D2"/>
                                                </Button>

                                            <!-- Bouton Supprimer -->
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Supprimer"
                                                    Command="{Binding DataContext.DeleteContratCommand, 
                                                    RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,0"
                                                    Visibility="{Binding DataContext.CanDeleteContrat, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                                   <materialDesign:PackIcon Kind="Delete" 
                                                               Foreground="#F44336"/>
                                                </Button>

                                            <!-- ✅ Bouton Détail (NOUVEAU) 
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                   ToolTip="Voir les détails"
                                                   Command="{Binding DataContext.OpenDetailCommuneCommand, 
                                                     RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="4,0">
                                                    <materialDesign:PackIcon Kind="InformationOutline" 
                                                     Foreground="#009688"/>
                                            </Button>
                                                        -->
                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
      DIALOG MODAL AJOUT/MODIFICATION
      ═══════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                          CloseOnClickAway="False"
                          Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="550" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="City" 
                                        Width="24" 
                                        Height="24"
                                        Foreground="#1976D2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                          FontSize="20"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sélection de l'exercice -->
                    <ComboBox materialDesign:HintAssist.Hint="Exercice *"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        ItemsSource="{Binding Exercices}"
                        SelectedValue="{Binding DialogContrat.ExerciceId, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Id"
                        DisplayMemberPath="Libelle"
                        Margin="0,0,0,15"/>
                    
                    <!-- Numéro du contrat  -->
                    <TextBox materialDesign:HintAssist.Hint="Numéro du contrat *"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding DialogContrat.NumeroContrat, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,15"
                        MaxLength="200"/>

                    <!-- Date signature -->
                    <DatePicker materialDesign:HintAssist.Hint="Date signature *"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          SelectedDate="{Binding DialogContratDateSignature, Mode=TwoWay}"
                          Margin="0,0,0,15"/>

                    <!-- Date echeance -->
                    <DatePicker materialDesign:HintAssist.Hint="Date d'écheance *"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          SelectedDate="{Binding DialogContratDateEcheance, Mode=TwoWay}"
                          Margin="0,0,0,15"/>

                    <!-- Sélection du tiers -->
                    <!-- Tiers -->
                    <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                          materialDesign:HintAssist.Hint="Tiers *"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding TiersList}"
                          SelectedValue="{Binding DialogContrat.TiersId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nom"
                          Margin="0,0,0,15"/>

                    <!-- Objet du contrat  -->
                    <TextBox materialDesign:HintAssist.Hint="Objet du contrat *"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding DialogContrat.Objet, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,15"
                        MaxLength="200"/>

                    <!-- Montant du contrat  -->
                    
                    <TextBox materialDesign:HintAssist.Hint="Montant du contrat (GNF) *"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       Text="{Binding DialogContrat.MontantContrat, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                       Margin="0,0,0,15">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveContratCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Note explicative -->
                    <TextBlock Text="* Champs obligatoires"
                      FontSize="11"
                      Foreground="#666"
                      FontStyle="Italic"
                      Margin="0,0,0,15"/>

                    <!-- Boutons Annuler et Enregistrer -->
                    <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                       Content="Annuler"
                       Command="{Binding CancelContratCommand}"
                       Margin="0,0,10,0"
                       Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                       Content="Enregistrer"
                       Command="{Binding SaveContratCommand}"
                       Width="120">
                            <Button.CommandParameter>
                                <Binding RelativeSource="{RelativeSource Self}"/>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>
