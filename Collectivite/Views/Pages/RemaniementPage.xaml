<Page x:Class="Collectivite.Views.Pages.RemaniementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Remaniements">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:VariationToBrushConverter x:Key="VariationToBrushConverter"/>
        <utils:VariationToLabelConverter x:Key="VariationToLabelConverter"/>
        <utils:CollectionHasItemsToVisibilityConverter x:Key="CollectionHasItemsToVisibilityConverter"/>

        <!-- 🆕 Convertisseur pour les couleurs de fond -->
        <utils:BackgroundColorConverter x:Key="BackgroundColorConverter"/>

        <!-- Enum TypeRemaniement -->
        <ObjectDataProvider x:Key="TypeRemaniementValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:TypeRemaniement}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TypeRemaniement"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour les montants -->
        <Style x:Key="MontantTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="SwapHorizontal" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Remaniements" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" />
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- TabControl avec 4 onglets -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- ONGLET 1 : RECETTE - FONCTIONNEMENT -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#388E3C"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Recette - Fonctionnement" 
                                     VerticalAlignment="Center"
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding BudgetLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <!-- 🆕 Style des lignes avec couleur de fond -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- 🆕 Colonne avec expander et chapitre -->
                                <DataGridTemplateColumn Header="Chapitre" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                                      Background="Transparent" BorderThickness="0"
                                                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                      Style="{StaticResource MaterialDesignFlatButton}">
                                                    <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                                </Button>
                                                <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="{Binding TextFontWeight}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="80"/>
                                <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                                <DataGridTextColumn Header="S-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="120"/>
                                <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}" Width="140"/>

                                <DataGridTemplateColumn Header="Remaniements" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToLabelConverter}}"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Montant définitif" Binding="{Binding BudgetLine.MontantActu, StringFormat={}{0:N0} GNF}" Width="150"/>

                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding BudgetLine.Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Ajouter un remaniement"
                                                        Command="{Binding DataContext.OpenAddDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="PlusCircle" Foreground="#4CAF50"/>
                                                </Button>

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Voir détail"
                                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#1976D2"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- ONGLET 2 : RECETTE - INVESTISSEMENT -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#388E3C"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Recette - Investissement" 
                                     VerticalAlignment="Center"
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
