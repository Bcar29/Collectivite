<Page x:Class="Collectivite.Views.Pages.RemaniementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Remaniements">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Enum TypeRemaniement -->
        <ObjectDataProvider x:Key="TypeRemaniementValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:TypeRemaniement}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TypeRemaniement"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Style pour les montants -->
        <Style x:Key="MontantTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="SwapHorizontal" 
                                             Width="32" 
                                             Height="32"
                                             Foreground="#1976D2"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des Remaniements" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0" />
                            <TextBlock Text="Nouveau Remaniement" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadDataCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0" />
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- TabControl avec 4 onglets -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- ========================================
                     ONGLET 1 : RECETTE - FONCTIONNEMENT
                     ======================================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#388E3C"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Recette - Fonctionnement" 
                                     VerticalAlignment="Center"
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding Remaniements}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chapitre" 
                                                  Binding="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                  Width="100"/>
                                <DataGridTextColumn Header="Article" 
                                                  Binding="{Binding BudgetLine.Nommenclature.Article}" 
                                                  Width="80"/>
                                <DataGridTextColumn Header="Paragraphe" 
                                                  Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" 
                                                  Width="100"/>
                                <DataGridTextColumn Header="S-Paragraphe" 
                                                  Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" 
                                                  Width="150"/>
                                <DataGridTextColumn Header="Intitulé" 
                                                  Binding="{Binding BudgetLine.Nommenclature.Intitule}" 
                                                  Width="*" 
                                                  MinWidth="120"/>
                                <DataGridTextColumn Header="Date" 
                                                  Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" 
                                                  Width="100"/>
                                <DataGridTextColumn Header="Motif" 
                                                  Binding="{Binding Motif}" 
                                                  Width="150"/>

                                <!-- Type de remaniement -->
                                <DataGridTemplateColumn Header="Type" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeRemaniement}" Value="en_moins">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Medium" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="+ PLUS"/>
                                                            <Setter Property="Foreground" Value="#388E3C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeRemaniement}" Value="en_moins">
                                                                    <Setter Property="Text" Value="- MOINS"/>
                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Montant Prévu 
                                <DataGridTemplateColumn Header="Montant Prévu" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}"
                                                       Style="{StaticResource MontantTextBlockStyle}"
                                                       Foreground="#757575"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>-->

                                <!-- Remaniement -->
                                <DataGridTemplateColumn Header="Remaniement" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock >
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MontantTextBlockStyle}">
                                                        <Setter Property="Text" Value="{Binding Montant, StringFormat='+{0:N0} GNF'}"/>
                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeRemaniement}" Value="en_moins">
                                                                <Setter Property="Text" Value="{Binding Montant, StringFormat='-{0:N0} GNF'}"/>
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Montant Définitif -->
                                <DataGridTemplateColumn Header="Montant Définitif" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="4" 
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding BudgetLine.MontantDefinitif, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

