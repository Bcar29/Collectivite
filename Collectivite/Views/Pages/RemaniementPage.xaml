<Page x:Class="Collectivite.Views.Pages.RemaniementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:Collectivite.Models"
      Language="fr-FR"
      Background="#F5F5F5"
      Title="Gestion des Remaniements">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Enum TypeRemaniement -->
        <ObjectDataProvider x:Key="TypeRemaniementValues" 
                          MethodName="GetValues" 
                          ObjectType="{x:Type models:TypeRemaniement}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TypeRemaniement"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>

    <Grid>
        <!-- Overlay de chargement -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Value="0"
                           IsIndeterminate="True"
                           Width="60"
                           Height="60"/>
                <TextBlock Text="Chargement..." 
                         Foreground="White"
                         FontSize="16"
                         Margin="0,20,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Header avec bouton d'ajout -->
                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SwapHorizontal" 
                                               Width="32" 
                                               Height="32"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="Gestion des Remaniements" 
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 Margin="15,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Command="{Binding OpenAddDialogCommand}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Nouveau Remaniement" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DataGrid -->
                <materialDesign:Card Padding="0" 
                                   UniformCornerRadius="8">
                    <DataGrid ItemsSource="{Binding Remaniements}"
                              SelectedItem="{Binding SelectedRemaniement}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                        <DataGrid.Columns>

                            <!-- Date -->
                            <DataGridTemplateColumn Header="Date" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarClock" 
                                                                   Width="16" 
                                                                   Height="16"
                                                                   Foreground="#757575"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ligne budgétaire -->
                            <DataGridTextColumn Header="Ligne Budgétaire" 
                                              Binding="{Binding BudgetLine.Nomenclature.Intitule}"
                                              Width="*"
                                              MinWidth="250"/>

                            <!-- Exercice -->
                            <DataGridTextColumn Header="Exercice" 
                                              Binding="{Binding BudgetLine.BudgetPrimitif.Exercice.Libelle}"
                                              Width="150"/>

                            <!-- Montant -->
                            <DataGridTemplateColumn Header="Montant" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" 
                                                                   Width="18" 
                                                                   Height="18"
                                                                   Foreground="#1976D2"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#1976D2">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} GNF">
                                                        <Binding Path="Montant"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Motif -->
                            <DataGridTextColumn Header="Motif" 
                                              Binding="{Binding Motif}"
                                              Width="300"/>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                  HorizontalAlignment="Center">

                                            <!-- Bouton Supprimer -->
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                  ToolTip="Supprimer"
                                                  Command="{Binding DataContext.DeleteCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  Margin="4,0">
                                                <materialDesign:PackIcon Kind="Delete" 
                                                                       Foreground="#F44336"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                 CloseOnClickAway="False"
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="600" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="SwapHorizontal" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Type de remaniement -->
                    <ComboBox materialDesign:HintAssist.Hint="Type de remaniement *"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ItemsSource="{Binding Source={StaticResource TypeRemaniementValues}}"
                            SelectedItem="{Binding TypeRemaniement}"
                            Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="ArrowUp"/>
                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="en_mois">
                                                        <Setter Property="Kind" Value="ArrowDown"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="En plus (+)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="en_mois">
                                                        <Setter Property="Text" Value="En moins (-)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Ligne budgétaire -->
                    <ComboBox materialDesign:HintAssist.Hint="Ligne budgétaire *"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ItemsSource="{Binding BudgetLinesSansEnfants}"
                            SelectedItem="{Binding SelectedBudgetLine}"
                            DisplayMemberPath="Nomenclature.Intitule"
                            Margin="0,0,0,15">
                        <!--  <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nomenclature.Intitule}"
                                             FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Exercice : " 
                                                 FontSize="11" 
                                                 Foreground="#666"/>
                                        <TextBlock Text="{Binding BudgetPrimitif.Exercice.Libelle}" 
                                                 FontSize="11" 
                                                 Foreground="#666"
                                                 Margin="4,0,16,0"/>
                                        <TextBlock Text="Montant actuel : " 
                                                 FontSize="11" 
                                                 Foreground="#666"/>
                                        <TextBlock FontSize="11" 
                                                 Foreground="#1976D2"
                                                 FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0} GNF">
                                                    <Binding Path="MontantActuel"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    -->
                    
                    </ComboBox>

                    <!-- Montant -->
                    <TextBox materialDesign:HintAssist.Hint="Montant (GNF) *"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding DialogRemaniement.Montant, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                           Margin="0,0,0,15"/>

                    <!-- Motif -->
                    <TextBox materialDesign:HintAssist.Hint="Motif *"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Text="{Binding DialogRemaniement.Motif, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="500"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinLines="3"
                           MaxLines="5"
                           VerticalScrollBarVisibility="Auto"
                           Margin="0,0,0,15"/>

                    <!-- Information importante -->
                    <Border Background="#FFF3E0"
                          CornerRadius="8"
                          Padding="15"
                          Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                       Width="20" 
                                                       Height="20"
                                                       Foreground="#F57C00"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Information importante" 
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         Foreground="#F57C00"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="#424242">
                                <Run Text="Le remaniement modifiera :"/>
                                <LineBreak/>
                                <Run Text="• Le montant actuel de la ligne budgétaire sélectionnée"/>
                                <LineBreak/>
                                <Run Text="• Les montants de toutes les lignes parentes (propagation automatique)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Note explicative -->
                    <TextBlock Text="* Champs obligatoires"
                             FontSize="11"
                             Foreground="#666"
                             FontStyle="Italic"
                             Margin="5,0,0,15"/>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" 
                              HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                              Content="Annuler"
                              Command="{Binding CancelCommand}"
                              Margin="0,0,10,0"
                              Width="100"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Effectuer le remaniement"
                              Command="{Binding SaveCommand}"
                              Width="200"/>
                    </StackPanel>

                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>