                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Chapitre" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                                      Background="Transparent" BorderThickness="0"
                                                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                      Style="{StaticResource MaterialDesignFlatButton}">
                                                    <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                                </Button>
                                                <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="{Binding TextFontWeight}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="80"/>
                                <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                                <DataGridTextColumn Header="S-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="120"/>
                                <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}" Width="140"/>

                                <DataGridTemplateColumn Header="Remaniements" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToLabelConverter}}"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Montant définitif" Binding="{Binding BudgetLine.MontantActu, StringFormat={}{0:N0} GNF}" Width="150"/>

                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding BudgetLine.Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Ajouter un remaniement"
                                                        Command="{Binding DataContext.OpenAddDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="PlusCircle" Foreground="#4CAF50"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Voir détail"
                                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#1976D2"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- ONGLET 3 : DÉPENSE - FONCTIONNEMENT -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingDown" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#F44336"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Dépense - Fonctionnement" 
                                     VerticalAlignment="Center"
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding BudgetLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Chapitre" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                                      Background="Transparent" BorderThickness="0"
                                                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                      Style="{StaticResource MaterialDesignFlatButton}">
                                                    <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                                </Button>
                                                <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="{Binding TextFontWeight}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="80"/>
                                <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                                <DataGridTextColumn Header="S-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="120"/>
                                <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}" Width="140"/>

                                <DataGridTemplateColumn Header="Remaniements" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToLabelConverter}}"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Montant définitif" Binding="{Binding BudgetLine.MontantActu, StringFormat={}{0:N0} GNF}" Width="150"/>

                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding BudgetLine.Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Ajouter un remaniement"
                                                        Command="{Binding DataContext.OpenAddDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="PlusCircle" Foreground="#4CAF50"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Voir détail"
                                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#1976D2"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- ONGLET 4 : DÉPENSE - INVESTISSEMENT -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLineVariant" 
                                                   Width="20" 
                                                   Height="20"
                                                   Foreground="#F44336"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Dépense - Investissement" 
                                     VerticalAlignment="Center"
                                     FontWeight="Medium"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Padding="0" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding BudgetLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource BackgroundColorConverter}}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Chapitre" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}">
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0"
                                                      Background="Transparent" BorderThickness="0"
                                                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                      Style="{StaticResource MaterialDesignFlatButton}">
                                                    <materialDesign:PackIcon Kind="{Binding ExpanderIcon}" Width="16" Height="16"/>
                                                </Button>
                                                <TextBlock Text="{Binding BudgetLine.Nommenclature.Chapitre}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="{Binding TextFontWeight}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Article" Binding="{Binding BudgetLine.Nommenclature.Article}" Width="80"/>
                                <DataGridTextColumn Header="Paragraphe" Binding="{Binding BudgetLine.Nommenclature.Paragraphe}" Width="100"/>
                                <DataGridTextColumn Header="S-Paragraphe" Binding="{Binding BudgetLine.Nommenclature.SousParagraphe}" Width="120"/>
                                <DataGridTextColumn Header="Intitulé" Binding="{Binding BudgetLine.Nommenclature.Intitule}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Montant prévu" Binding="{Binding BudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}" Width="140"/>

                                <DataGridTemplateColumn Header="Remaniements" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, StringFormat={}{0:N0} GNF}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToLabelConverter}}"
                                                           Foreground="{Binding BudgetLine.VariationTotale, Converter={StaticResource VariationToBrushConverter}}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Montant définitif" Binding="{Binding BudgetLine.MontantActu, StringFormat={}{0:N0} GNF}" Width="150"/>

                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding BudgetLine.Nommenclature.Enfants, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Ajouter un remaniement"
                                                        Command="{Binding DataContext.OpenAddDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="PlusCircle" Foreground="#4CAF50"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Voir détail"
                                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding BudgetLine}"
                                                        Margin="4,0">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#1976D2"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Dialog Modal - Ajout remaniement -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                 CloseOnClickAway="False" 
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="640" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="SwapHorizontal" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Informations sur la ligne sélectionnée -->
                    <Border Background="#E8F5E9"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBudgetLine.Nommenclature.Intitule, TargetNullValue='Sélectionnez une ligne dans la liste principale'}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1B5E20"
                                       TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="Montant prévu :"
                                           FontWeight="SemiBold"
                                           Foreground="#455A64"/>
                                <TextBlock Text="{Binding SelectedBudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}"
                                           Margin="6,0,20,0"
                                           Foreground="#455A64"/>

                                <TextBlock Text="Montant définitif :"
                                           FontWeight="SemiBold"
                                           Foreground="#455A64"/>
                                <TextBlock Text="{Binding SelectedBudgetLine.MontantActu, StringFormat={}{0:N0} GNF}"
                                           Margin="6,0,0,0"
                                           Foreground="#455A64"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Type de remaniement -->
                    <ComboBox materialDesign:HintAssist.Hint="Type de remaniement *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Source={StaticResource TypeRemaniementValues}}"
                              SelectedItem="{Binding DialogRemaniement.TypeRemaniement}"
                              Margin="0,0,0,15"/>

                    <!-- Montant -->
                    <TextBox materialDesign:HintAssist.Hint="Montant (GNF) *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRemaniement.Montant, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                             Margin="0,0,0,15"/>

                    <!-- Motif -->
                    <TextBox materialDesign:HintAssist.Hint="Motif *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRemaniement.Motif, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinLines="3"
                             MaxLines="5"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,15"/>

                    <!-- Info -->
                    <Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="20" 
                                                       Height="20"
                                                       Foreground="#1976D2"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Information" 
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         Foreground="#1976D2"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                                Le remaniement modifiera le montant définitif de la ligne budgétaire sélectionnée.
                                <LineBreak/>
                                • Type "en_plus" : augmente le montant définitif
                                <LineBreak/>
                                • Type "en_moins" : diminue le montant définitif
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Dialog - Détails des remaniements -->
        <materialDesign:DialogHost IsOpen="{Binding IsDetailDialogOpen}"
                                   CloseOnClickAway="False"
                                   Panel.ZIndex="1100">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="720" Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="FileTableBoxMultiple"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#1976D2"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="Détail des remaniements"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailBudgetLine.Nommenclature.Intitule, TargetNullValue='Aucune ligne sélectionnée'}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="Montant prévu :" FontWeight="SemiBold" Foreground="#455A64"/>
                                <TextBlock Text="{Binding DetailBudgetLine.MontantPrevu, StringFormat={}{0:N0} GNF}"
                                           Margin="6,0,20,0"
                                           Foreground="#455A64"/>
                                <TextBlock Text="Montant définitif :" FontWeight="SemiBold" Foreground="#455A64"/>
                                <TextBlock Text="{Binding DetailBudgetLine.MontantActu, StringFormat={}{0:N0} GNF}"
                                           Margin="6,0,0,0"
                                           Foreground="#455A64"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Aucun remaniement enregistré pour cette ligne."
                               Foreground="#546E7A"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailRemaniements, Converter={StaticResource CollectionHasItemsToVisibilityConverter}}"
                                                 Value="Collapsed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <materialDesign:Card Padding="0">
                        <DataGrid ItemsSource="{Binding DetailRemaniements}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  materialDesign:DataGridAssist.CellPadding="13 8 8 8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding Date, StringFormat='dd/MM/yyyy'}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding TypeRemaniement}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Motif"
                                                    Binding="{Binding Motif}"
                                                    Width="*"
                                                    MinWidth="200"/>
                                <DataGridTextColumn Header="Montant"
                                                    Binding="{Binding Montant, StringFormat={}{0:N0} GNF}"
                                                    Width="150"/>
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Supprimer">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding CloseDetailsCommand}"
                                Content="Fermer"
                                Width="120"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>