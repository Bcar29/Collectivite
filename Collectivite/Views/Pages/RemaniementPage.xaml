                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Supprimer">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Dialog Modal -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" 
                                 CloseOnClickAway="False" 
                                 Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="640" Margin="20">

                    <!-- Titre du dialog -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="SwapHorizontal" 
                                               Width="24" 
                                               Height="24"
                                               Foreground="#1976D2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding DialogTitle}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Type de remaniement -->
                    <ComboBox materialDesign:HintAssist.Hint="Type de remaniement *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Source={StaticResource TypeRemaniementValues}}"
                              SelectedItem="{Binding DialogRemaniement.TypeRemaniement}"
                              Margin="0,0,0,15"/>

                    <!-- Ligne budgétaire -->
                    <ComboBox materialDesign:HintAssist.Hint="Ligne budgétaire *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding BudgetLinesSansEnfants}"
                              SelectedItem="{Binding SelectedBudgetLine}"
                              DisplayMemberPath="Nommenclature.Intitule"
                              Margin="0,0,0,15"/>

                    <!-- Montant -->
                    <TextBox materialDesign:HintAssist.Hint="Montant (GNF) *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRemaniement.Montant, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                             Margin="0,0,0,15"/>

                    <!-- Motif -->
                    <TextBox materialDesign:HintAssist.Hint="Motif *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogRemaniement.Motif, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinLines="3"
                             MaxLines="5"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,15"/>

                    <!-- Info -->
                    <Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                       Width="20" 
                                                       Height="20"
                                                       Foreground="#1976D2"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Information" 
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         Foreground="#1976D2"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#424242">
                                Le remaniement modifiera le montant définitif de la ligne budgétaire sélectionnée.
                                <LineBreak/>
                                • Type "en_plus" : augmente le montant définitif
                                <LineBreak/>
                                • Type "en_moins" : diminue le montant définitif
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Width="100"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</Page>