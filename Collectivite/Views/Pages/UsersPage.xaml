<Page x:Class="Collectivite.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewModels="clr-namespace:Collectivite.ViewModels"
      xmlns:utils="clr-namespace:Collectivite.Utils"
      Language="fr-FR"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <viewModels:UsersViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="60"
                             Height="60"/>
                <TextBlock Text="Chargement..."
                           Foreground="White"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="32"
                                             Height="32"
                                             Foreground="#512DA8"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Gestion des utilisateurs"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            Height="36"
                            Margin="0,0,10,0">                           
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                            <TextBlock Text="Nouvel utilisateur"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding LoadCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                            <TextBlock Text="Rafraîchir" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <materialDesign:Card Grid.Row="1" Padding="0">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="200"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="250"/>
                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Tel}" Width="150"/>
                        <DataGridTextColumn Header="Commune" Binding="{Binding Commune.Nom}" Width="200"/>
                        <DataGridTemplateColumn Header="Rôle" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=Page}}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding RoleId, Mode=TwoWay}"
                                              SelectionChanged="ComboBox_SelectionChanged"
                                              Width="180"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Modifier">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#1976D2"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Supprimer">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                   CloseOnClickAway="False"
                                   Panel.ZIndex="1000">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="500" Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Account"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#512DA8"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Modifier l''utilisateur;Nouvel utilisateur'}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBox materialDesign:HintAssist.Hint="Nom d'utilisateur *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogUser.Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Email *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogUser.Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Téléphone *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogUser.Tel, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Mot de passe *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DialogUser.Password, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <ComboBox materialDesign:HintAssist.Hint="Commune *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Communes}"
                              SelectedValue="{Binding DialogUser.CommuneId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="NomComplet"
                              Margin="0,0,0,15"/>

                    <ComboBox materialDesign:HintAssist.Hint="Rôle *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding Roles}"
                              SelectedValue="{Binding DialogUser.RoleId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="Annuler"
                                Command="{Binding CloseDialogCommand}"
                                Margin="0,0,10,0"
                                Width="110"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Width="140"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</Page>

