<UserControl x:Class="Collectivite.Views.GrandLivrePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Collectivite.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Style pour les cartes de compte -->
        <Style x:Key="CompteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les en-têtes de colonne -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Style pour les montants -->
        <Style x:Key="MontantTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Convertisseur pour visibilité -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- EN-TÊTE AVEC TITRE ET BOUTONS -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="20,15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TitrePeriode}" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="#1976D2"/>
                    <TextBlock Text="Consultation des mouvements par compte" 
                               FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Boutons d'action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 🆕 BOUTON BASCULER MODE D'AFFICHAGE -->
                    <Button Command="{Binding BasculerModeAffichageCommand}"
                            Margin="0,0,16,0" Padding="12,6"
                            ToolTip="Basculer entre vue Cartes et vue Tableau">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstModeDataGrid}" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,6,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="TableLarge"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstModeCartes}" Value="False">
                                                <Setter Property="Kind" Value="Cards"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding LibelleBoutonMode}"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" 
                               Margin="0,4,16,4"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterExcelCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterPdfCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ImprimerCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BARRE DE FILTRES -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="16,12" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtre Année -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Année" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="110"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding AnneeSelectionnee}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Filtre Mois -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Mois" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="140" 
                              ItemsSource="{Binding Mois}"
                              SelectedValue="{Binding MoisSelectionne}"
                              SelectedValuePath="Numero"
                              DisplayMemberPath="Nom"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Filtre Compte -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Compte" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="280" 
                              ItemsSource="{Binding ComptesDisponibles}"
                              SelectedItem="{Binding CompteFiltreSelectionne}"
                              DisplayMemberPath="Libelle"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Recherche -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Recherche" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             materialDesign:HintAssist.Hint="Rechercher un compte..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <!-- Bouton réinitialiser -->
                <Button Grid.Column="4" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ReinitialiserFiltresCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Réinitialiser"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATISTIQUES + INDICATEUR MODE -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#E3F2FD" Padding="16,10"
                Visibility="{Binding Statistiques, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Comptes actifs" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.NombreComptes}" 
                               FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Écritures" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.NombreEcritures}" 
                               FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Total Débits" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.TotalDebitsFormate}" 
                               FontSize="18" FontWeight="Bold" Foreground="#388E3C"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Total Crédits" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.TotalCreditsFormate}" 
                               FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                </StackPanel>

                <!-- 🆕 Indicateur du mode d'affichage actuel -->
                <Border Grid.Column="4" 
                        Background="White"
                        CornerRadius="12" Padding="10,4" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16"
                                                 Foreground="#1976D2"
                                                 VerticalAlignment="Center" Margin="0,0,5,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="Cards"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstModeDataGrid}" Value="True">
                                            <Setter Property="Kind" Value="TableLarge"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock FontSize="11" Foreground="#1976D2" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Mode Cartes"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstModeDataGrid}" Value="True">
                                            <Setter Property="Text" Value="Mode Tableau"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- CONTENU PRINCIPAL - DEUX MODES D'AFFICHAGE -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 🃏 MODE CARTES (WrapPanel) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding EstModeCartes, Converter={StaticResource BoolToVisConverter}}">
                <ItemsControl ItemsSource="{Binding Comptes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CompteCardStyle}" 
                                    Width="280" MinHeight="200" MaxHeight="350">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- En-tête du compte -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding NumeroCompte}" 
                                                   FontSize="18" FontWeight="Bold" 
                                                   Foreground="#1976D2"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding IntituleCompte}" 
                                                   FontSize="11" Foreground="#666666"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxHeight="36"/>
                                    </StackPanel>

                                    <Separator Grid.Row="1" Margin="0,4"/>

                                    <!-- Liste des mouvements avec ScrollViewer -->
                                    <ScrollViewer Grid.Row="2" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="150">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Colonne Débit -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Débit" Style="{StaticResource HeaderTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <ItemsControl ItemsSource="{Binding Mouvements}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DebitFormate}" 
                                                                       Style="{StaticResource MontantTextStyle}"
                                                                       Foreground="#388E3C"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Colonne Crédit -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Crédit" Style="{StaticResource HeaderTextStyle}"
                                                           HorizontalAlignment="Center"/>
                                                <ItemsControl ItemsSource="{Binding Mouvements}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding CreditFormate}" 
                                                                       Style="{StaticResource MontantTextStyle}"
                                                                       Foreground="#D32F2F"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Totaux -->
                                    <Border Grid.Row="3" Background="#F5F5F5" 
                                            CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                       Text="{Binding TotalDebitFormate}" 
                                                       FontWeight="Bold" Foreground="#388E3C"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                                       Text="{Binding TotalCreditFormate}" 
                                                       FontWeight="Bold" Foreground="#D32F2F"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                                                       Text="{Binding SoldeFormate}" 
                                                       FontSize="11" Foreground="#666666"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 📊 MODE DATAGRID (Tableau) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <materialDesign:Card Padding="0" Margin="10"
                                 Visibility="{Binding EstModeDataGrid, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid ItemsSource="{Binding LignesDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          AlternatingRowBackground="#FAFAFA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          materialDesign:DataGridAssist.CellPadding="12 8 12 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12 8 12 8">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <!-- Style spécial pour les lignes de total : BLEU CIEL -->
                                <DataTrigger Binding="{Binding EstLigneTotal}" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- N° Compte -->
                        <DataGridTemplateColumn Header="N° Compte" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NumeroCompte}" 
                                               FontWeight="SemiBold"
                                               Foreground="#1976D2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Intitulé -->
                        <DataGridTextColumn Header="Intitulé" 
                                            Binding="{Binding IntituleCompte}" 
                                            Width="*" MinWidth="250"/>

                        <!-- Date -->
                        <DataGridTemplateColumn Header="Date" Width="110" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateFormatee}" 
                                               Foreground="#666666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Débit -->
                        <DataGridTemplateColumn Header="Débit" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DebitFormate}" 
                                               FontWeight="SemiBold"
                                               Foreground="#388E3C"
                                               HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Crédit -->
                        <DataGridTemplateColumn Header="Crédit" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreditFormate}" 
                                               FontWeight="SemiBold"
                                               Foreground="#D32F2F"
                                               HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Solde -->
                        <DataGridTemplateColumn Header="Solde" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SoldeFormate}" 
                                               FontWeight="Bold"
                                               Foreground="#1976D2"
                                               HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Message si pas de données -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Comptes.Count, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                <materialDesign:PackIcon Kind="DatabaseOff" Width="64" Height="64" 
                                         Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucune donnée à afficher" 
                           FontSize="16" Foreground="#9E9E9E" Margin="0,12,0,0"/>
                <TextBlock Text="Modifiez les filtres pour voir les comptes" 
                           FontSize="12" Foreground="#BDBDBD"/>
            </StackPanel>

            <!-- Barre de chargement -->
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                         VerticalAlignment="Top"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BARRE DE STATUT -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding MessageErreur}" 
                           Foreground="#D32F2F"
                           Visibility="{Binding MessageErreur, Converter={StaticResource BoolToVisConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Afficher les comptes vides" 
                              IsChecked="{Binding AfficherComptesVides}"
                              Margin="0,0,16,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Total : "/>
                        <Run Text="{Binding Comptes.Count, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" comptes"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
