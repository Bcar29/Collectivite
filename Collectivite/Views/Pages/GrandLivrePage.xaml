<UserControl x:Class="Collectivite.Views.GrandLivrePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Collectivite.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Style pour les cartes de compte -->
        <Style x:Key="CompteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les en-têtes de colonne -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Style pour les montants -->
        <Style x:Key="MontantTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Convertisseur pour visibilité -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec titre -->
        <Border Grid.Row="0" Background="White" Padding="20,15" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TitrePeriode}" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="#1976D2"/>
                    <TextBlock Text="Consultation des mouvements par compte" 
                               FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Boutons d'action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterExcelCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExporterPdfCommand}"
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ImprimerCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre de filtres -->
        <Border Grid.Row="1" Background="White" Padding="16,12" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtre Année -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Année" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="100" 
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding AnneeSelectionnee}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Filtre Mois -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Mois" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="140" 
                              ItemsSource="{Binding Mois}"
                              SelectedValue="{Binding MoisSelectionne}"
                              SelectedValuePath="Numero"
                              DisplayMemberPath="Nom"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Filtre Compte -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Compte" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <ComboBox Width="280" 
                              ItemsSource="{Binding ComptesDisponibles}"
                              SelectedItem="{Binding CompteFiltreSelectionne}"
                              DisplayMemberPath="Libelle"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>

                <!-- Recherche -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Recherche" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             materialDesign:HintAssist.Hint="Rechercher un compte..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>

                <!-- Bouton réinitialiser -->
                <Button Grid.Column="4" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ReinitialiserFiltresCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Réinitialiser"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Statistiques -->
        <Border Grid.Row="2" Background="#E3F2FD" Padding="16,10"
                Visibility="{Binding Statistiques, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Comptes actifs" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.NombreComptes}" 
                               FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Écritures" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.NombreEcritures}" 
                               FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Total Débits" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.TotalDebitsFormate}" 
                               FontSize="18" FontWeight="Bold" Foreground="#388E3C"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Total Crédits" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="{Binding Statistiques.TotalCreditsFormate}" 
                               FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal - Liste des comptes en grille -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Comptes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CompteCardStyle}" 
                                Width="280" MinHeight="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- En-tête du compte -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding NumeroCompte}" 
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="#1976D2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding IntituleCompte}" 
                                               FontSize="11" Foreground="#666666"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxHeight="36"/>
                                </StackPanel>

                                <Separator Grid.Row="1" Margin="0,4"/>

                                <!-- Liste des mouvements -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Colonne Débit -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Débit" Style="{StaticResource HeaderTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding Mouvements}" MaxHeight="100">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DebitFormate}" 
                                                               Style="{StaticResource MontantTextStyle}"
                                                               Foreground="#388E3C"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Colonne Crédit -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Crédit" Style="{StaticResource HeaderTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding Mouvements}" MaxHeight="100">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CreditFormate}" 
                                                               Style="{StaticResource MontantTextStyle}"
                                                               Foreground="#D32F2F"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- Totaux -->
                                <Border Grid.Row="3" Background="#F5F5F5" 
                                        CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="{Binding TotalDebitFormate}" 
                                                   FontWeight="Bold" Foreground="#388E3C"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                   Text="{Binding TotalCreditFormate}" 
                                                   FontWeight="Bold" Foreground="#D32F2F"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                                                   Text="{Binding SoldeFormate}" 
                                                   FontSize="11" Foreground="#666666"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Message si pas de données -->
        <StackPanel Grid.Row="3" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Comptes.Count, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
            <materialDesign:PackIcon Kind="DatabaseOff" Width="64" Height="64" 
                                     Foreground="#BDBDBD" HorizontalAlignment="Center"/>
            <TextBlock Text="Aucune donnée à afficher" 
                       FontSize="16" Foreground="#9E9E9E" Margin="0,12,0,0"/>
            <TextBlock Text="Modifiez les filtres pour voir les comptes" 
                       FontSize="12" Foreground="#BDBDBD"/>
        </StackPanel>

        <!-- Barre de chargement -->
        <ProgressBar Grid.Row="3" 
                     IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                     VerticalAlignment="Top"/>

        <!-- Barre de statut -->
        <Border Grid.Row="4" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding MessageErreur}" 
                           Foreground="#D32F2F"
                           Visibility="{Binding MessageErreur, Converter={StaticResource BoolToVisConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Afficher les comptes vides" 
                              IsChecked="{Binding AfficherComptesVides}"
                              Margin="0,0,16,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Total : "/>
                        <Run Text="{Binding Comptes.Count, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" comptes"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
