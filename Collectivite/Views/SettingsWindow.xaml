<Window x:Class="Collectivite.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Height="280"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Paramètres"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <Separator Margin="0,0,0,15"/>
            <TextBlock Text="Les paramètres détaillés seront disponibles prochainement."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>
            <Button Width="90"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click">Fermer</Button>
        </StackPanel>
    </Border>
</Window>

