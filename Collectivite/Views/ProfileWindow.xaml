<Window x:Class="Collectivite.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil utilisateur"
        Height="360"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Profil"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <Separator Margin="0,0,0,10"/>
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nom d'utilisateur :" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Username}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="1" Text="Email :" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="2" Text="Téléphone :" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tel}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="3" Text="Commune :" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Commune.Nom}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="4" Text="Identifiant :" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Id}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="5" Text="Identifiant :" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Commune.Id}" Margin="10,0,0,0"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Width="80" Height="30" Margin="5,0,0,0" Click="CloseButton_Click">Fermer</Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

