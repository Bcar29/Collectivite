<Window x:Class="Collectivite.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Profil utilisateur"
        Icon="pack://application:,,,/app_icon_256.png"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Border Padding="20" Background="White" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="{DynamicResource PrimaryHueLightBrush}">
                    <TextBlock Text="{Binding Username}"
                               FontWeight="Bold"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Profil utilisateur"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Commune.Nom}"
                               FontSize="13"
                               Foreground="#757575"/>
                </StackPanel>
            </StackPanel>

            <!-- Contenu principal -->
            <Border Grid.Row="1"
                    Margin="0,10,0,10"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Nom d'utilisateur"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Username}"
                               Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="1"
                               Text="Email"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Email}"
                               Margin="10,8,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="Téléphone"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding Tel}"
                               Margin="10,8,0,0"/>

                    <TextBlock Grid.Row="3"
                               Text="Commune"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding Commune.Nom}"
                               Margin="10,8,0,0"/>
                </Grid>
            </Border>

            <!-- Boutons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Width="100"
                        Height="32"
                        Margin="5,0,0,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="CloseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Fermer"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

