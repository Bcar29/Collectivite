<Window x:Class="Collectivite.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Collectivite.Views.Controls"
        Title="Profil utilisateur"
        Icon="pack://application:,,,/app_icon_256.png"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Border Padding="20" Background="White" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="{DynamicResource PrimaryHueLightBrush}">
                    <TextBlock Text="{Binding Username}"
                               FontWeight="Bold"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Profil utilisateur"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Commune.Nom}"
                               FontSize="13"
                               Foreground="#757575"/>
                </StackPanel>
            </StackPanel>

            <!-- Contenu principal -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                <StackPanel>
                    <Border CornerRadius="8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Nom d'utilisateur"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Username}"
                                       Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="Commune"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding CommuneNom}"
                                       Margin="10,8,0,0"/>
                        </Grid>
                    </Border>

                    <TextBox materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Téléphone"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Tel, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Changer mon mot de passe"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <controls:PasswordRevealBox Hint="Nouveau mot de passe"
                            Password="{Binding NewPassword, Mode=TwoWay}"
                            Margin="0,0,0,10"/>

                    <controls:PasswordRevealBox Hint="Confirmer le nouveau mot de passe"
                            Password="{Binding ConfirmPassword, Mode=TwoWay}"
                            Margin="0,0,0,4"/>

                    <TextBlock Text="Laisser vide pour conserver le mot de passe actuel"
                               FontSize="11"
                               Foreground="#757575"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Boutons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding CancelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Fermer"/>
                    </StackPanel>
                </Button>
                <Button Width="130"
                        Height="32"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Enregistrer"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

